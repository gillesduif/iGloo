# .NET build output
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM64/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
TestResults/
[Cc]overage*/
*.coverage
*.coveragexml

# Logs and crash dumps
*.log
*.tlog
*.pdb
*.mdb
*.crashdump

# Windows-specific
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS / Linux clutter (for cross-platform contributors)
.DS_Store
*.swp
*~

# Igloo-specific local development artifacts
local/
.test-vm/
*.iso
*.iso.sha256
*.iso.gpg
# Exception: "Igloo.Iso" is a SOURCE project, not an ISO image. On
# case-insensitive filesystems (Windows/macOS) the "*.iso" rule above also
# matches the "Igloo.Iso" folder, which silently excluded the whole project
# from git (a fresh clone wouldn't build). Keep it tracked.
!src/Igloo.Iso/

# Pre-built plugin DLLs shipped inside distros/ (build output, not source)
distros/**/*.dll
distros/**/*.pdb

# Personal notes / editor metadata
.obsidian/

# Secrets and credentials — should never be committed
*.pfx
*.key
*.pem
secrets/
appsettings.local.json
appsettings.Development.json
/.claude
/docs/dev-vault

# Python bytecode caches (the first-boot agents are plain .py; caches are regenerated)
__pycache__/
*.py[cod]

# OS / editor metadata
.DS_Store
Thumbs.db
*.user
*.suo
