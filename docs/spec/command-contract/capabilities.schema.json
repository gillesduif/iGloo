{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:igloo:command:v1:capability-payloads",
  "$defs": {
    "emptyInput": {"type": "object", "maxProperties": 0},
    "distroSelectionInput": {"type": "object", "required": ["distroId"], "properties": {"distroId": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "capabilitySelectionInput": {"type": "object", "required": ["capabilityId"], "properties": {"capabilityId": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "finding": {"type": "object", "required": ["code", "severity"], "properties": {"code": {"type": "string"}, "severity": {"enum": ["Info", "Warning", "Blocker"]}}, "additionalProperties": false},
    "distroSummary": {"type": "object", "required": ["id", "displayName"], "properties": {"id": {"type": "string"}, "displayName": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": false},
    "distroListResult": {"type": "object", "required": ["distros"], "properties": {"distros": {"type": "array", "items": {"$ref": "#/$defs/distroSummary"}}}, "additionalProperties": false},
    "compatibilityResult": {"type": "object", "required": ["distroId", "findings", "hasBlockers"], "properties": {"distroId": {"type": "string"}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "hasBlockers": {"type": "boolean"}}, "additionalProperties": false},
    "systemInspectionResult": {"type": "object", "required": ["isUefi", "secureBootEnabled", "tpmPresent", "bitLockerState", "totalRamBytes", "diskCount", "findings"], "properties": {"isUefi": {"type": "boolean"}, "secureBootEnabled": {"type": "boolean"}, "tpmPresent": {"type": "boolean"}, "bitLockerState": {"type": "string"}, "totalRamBytes": {"type": "integer"}, "diskCount": {"type": "integer", "minimum": 0}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}}, "additionalProperties": false},
    "inspectionPartition": {"type": "object", "required": ["index", "sizeBytes", "offsetBytes", "isBoot", "isSystem", "shrinkableBytes", "fileSystemCategory"], "properties": {"index": {"type": "integer"}, "sizeBytes": {"type": "integer", "minimum": 0}, "offsetBytes": {"type": "integer"}, "isBoot": {"type": "boolean"}, "isSystem": {"type": "boolean"}, "shrinkableBytes": {"type": "integer", "minimum": 0}, "fileSystemCategory": {"enum": ["NTFS", "FAT32", "exFAT", "ext4", "btrfs", "xfs", "OtherOrUnknown"]}}, "additionalProperties": false},
    "inspectionDisk": {"type": "object", "required": ["ordinal", "totalBytes", "freeBytes", "partitionStyle", "hasBootPartition", "hasSystemPartition", "partitions"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "totalBytes": {"type": "integer", "minimum": 0}, "freeBytes": {"type": "integer", "minimum": 0}, "partitionStyle": {"enum": ["GPT", "MBR", "Unknown"]}, "hasBootPartition": {"type": "boolean"}, "hasSystemPartition": {"type": "boolean"}, "partitions": {"type": "array", "items": {"$ref": "#/$defs/inspectionPartition"}}}, "additionalProperties": false},
    "systemInspectionDetailResult": {"type": "object", "required": ["summary", "disks", "linuxInstallationCount", "installerLeftoverCount"], "properties": {"summary": {"$ref": "#/$defs/systemInspectionResult"}, "disks": {"type": "array", "items": {"$ref": "#/$defs/inspectionDisk"}}, "linuxInstallationCount": {"type": "integer", "minimum": 0}, "installerLeftoverCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "isoAcquiredResult": {"type": "object", "required": ["distroId", "sha256Verified", "gpgVerified", "sizeBytes"], "properties": {"distroId": {"type": "string"}, "sha256Verified": {"type": "boolean"}, "gpgVerified": {"type": "boolean"}, "sizeBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "artifactAcquiredResult": {"type": "object", "required": ["artifactId", "distroId", "sha256", "gpgVerified", "sizeBytes"], "properties": {"artifactId": {"type": "string", "pattern": "^sha256-[0-9A-F]{64}$"}, "distroId": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "gpgVerified": {"type": "boolean"}, "sizeBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "artifactSelectionInput": {"type": "object", "required": ["artifactId"], "properties": {"artifactId": {"type": "string", "pattern": "^sha256-[0-9A-F]{64}$"}}, "additionalProperties": false},
    "artifactStatusResult": {"type": "object", "required": ["artifactId", "distroId", "sha256", "gpgVerified", "sizeBytes", "present", "verifiedNow"], "properties": {"artifactId": {"type": "string", "pattern": "^sha256-[0-9A-F]{64}$"}, "distroId": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "gpgVerified": {"type": "boolean"}, "sizeBytes": {"type": "integer", "minimum": 0}, "present": {"type": "boolean"}, "verifiedNow": {"type": "boolean"}}, "additionalProperties": false},
    "migrationInspectionResult": {"type": "object", "required": ["windowsBootDiskCount", "blockerCodes", "canRequestAdvisoryPlan"], "properties": {"windowsBootDiskCount": {"type": "integer", "minimum": 0}, "observedAvailableBytes": {"type": "integer", "minimum": 0}, "blockerCodes": {"type": "array", "items": {"type": "string"}}, "canRequestAdvisoryPlan": {"type": "boolean"}}, "additionalProperties": false},
    "migrationPlanInput": {"type": "object", "required": ["distroId", "requestedLinuxBytes"], "properties": {"distroId": {"type": "string", "minLength": 1}, "requestedLinuxBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "migrationPlanResult": {"type": "object", "required": ["distroId", "requiredBytes", "blockerCodes", "executable", "disposition"], "properties": {"distroId": {"type": "string"}, "requiredBytes": {"type": "integer", "minimum": 0}, "observedAvailableBytes": {"type": "integer", "minimum": 0}, "blockerCodes": {"type": "array", "items": {"type": "string"}}, "executable": {"const": false}, "disposition": {"const": "AdvisoryOnly"}}, "additionalProperties": false},
    "migrationPlanResultV2": {"type": "object", "required": ["planId", "distroId", "requiredBytes", "capacityState", "blockerCodes", "observedStateFingerprint", "observedMachineFingerprint", "providerRevisionFingerprint", "executable", "disposition"], "properties": {"planId": {"type": "string", "format": "uuid"}, "distroId": {"type": "string"}, "requiredBytes": {"type": "integer", "minimum": 0}, "observedAvailableBytes": {"type": "integer", "minimum": 0}, "capacityState": {"enum": ["KnownAvailable", "Insufficient", "PhysicalDiskTooSmall", "Unknown", "AmbiguousTarget"]}, "blockerCodes": {"type": "array", "items": {"type": "string"}}, "observedStateFingerprint": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "providerRevisionFingerprint": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "observedMachineFingerprint": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "executable": {"const": false}, "disposition": {"const": "AdvisoryOnly"}}, "additionalProperties": false},
    "planSelectionInput": {"type": "object", "required": ["planId"], "properties": {"planId": {"type": "string", "format": "uuid"}}, "additionalProperties": false},
    "migrationTargetBindingResult": {"type": "object", "required": ["planId", "targetId", "boundStateFingerprint", "executable"], "properties": {"planId": {"type": "string", "format": "uuid"}, "targetId": {"type": "string", "format": "uuid"}, "boundStateFingerprint": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "executable": {"const": false}}, "additionalProperties": false},
    "migrationAllocationInput": {"type": "object", "required": ["planId", "targetId", "requestedShrinkBytes"], "properties": {"planId": {"type": "string", "format": "uuid"}, "targetId": {"type": "string", "format": "uuid"}, "requestedShrinkBytes": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "migrationAllocationResult": {"type": "object", "required": ["planId", "targetId", "allocationId", "scope", "requestedShrinkBytes", "plannedShrinkBytes", "currentPartitionBytes", "resultingPartitionBytes", "newFreeOffsetBytes", "observedLayoutRevision", "capacityState", "warningCodes", "executable"], "properties": {"planId": {"type": "string", "format": "uuid"}, "targetId": {"type": "string", "format": "uuid"}, "allocationId": {"type": "string", "format": "uuid"}, "scope": {"const": "WindowsBootNtfsShrinkIntentV1"}, "requestedShrinkBytes": {"type": "integer", "minimum": 1}, "plannedShrinkBytes": {"type": "integer", "minimum": 1}, "currentPartitionBytes": {"type": "integer", "minimum": 1}, "resultingPartitionBytes": {"type": "integer", "minimum": 1}, "newFreeOffsetBytes": {"type": "integer", "minimum": 1}, "observedLayoutRevision": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "capacityState": {"const": "KnownAvailable"}, "warningCodes": {"type": "array", "items": {"type": "string"}}, "executable": {"const": false}}, "additionalProperties": false},
    "recoveryInspectionResult": {"type": "object", "required": ["support", "reasonCode", "hasExactSnapshot"], "properties": {"support": {"const": "ObservationUnavailable"}, "reasonCode": {"const": "ExactSnapshotNotCaptured"}, "hasExactSnapshot": {"const": false}}, "additionalProperties": false},
    "operationSelectionInput": {"type": "object", "required": ["operationId"], "properties": {"operationId": {"type": "string", "format": "uuid"}}, "additionalProperties": false},
    "operationStatusResult": {"type": "object", "required": ["operationId", "capabilityId", "state", "createdAt", "updatedAt", "currentStage", "evidenceCodes"], "properties": {"operationId": {"type": "string", "format": "uuid"}, "capabilityId": {"type": "string"}, "state": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "currentStage": {"type": "string"}, "evidenceCodes": {"type": "array", "items": {"type": "string"}}, "failureCode": {"type": "string"}, "continuationCode": {"type": "string"}}, "additionalProperties": false}
  }
}
