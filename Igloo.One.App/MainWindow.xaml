<Window x:Class="Igloo.One.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mascot="clr-namespace:Igloo.Mascot.Wpf;assembly=Igloo.Mascot.Wpf"
        Title="iGloo One" MinWidth="760" MinHeight="580"
        Width="930" Height="675" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource Brush.Window}"
        TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="iGloo" FontSize="13" FontWeight="SemiBold" />
                <Border Background="{StaticResource Brush.Layer.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ONE" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;"
                        Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize" />
                <Button Click="OnMaxRestoreClick" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                            <Setter Property="Content" Value="&#xE922;" />
                            <Setter Property="AutomationProperties.Name" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;" />
                                    <Setter Property="AutomationProperties.Name" Value="Restore down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;"
                        Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="42,24,42,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="Welcome to iGloo One" FontSize="32" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Meet Tux, your iGloo companion."
                           FontSize="16" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,0,0,28" />
                <Border Background="{StaticResource Brush.Layer.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Card}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12"
                        MaxWidth="350" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="LOCAL STATUS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   Margin="0,0,0,7" />
                        <TextBlock x:Name="CapabilityStatus" Text="Checking local capabilities…"
                                   FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Button Content="Wave to Tux" Click="OnWaveClick"
                        HorizontalAlignment="Left" Margin="0,24,0,0"
                        AutomationProperties.Name="Wave to Tux" />
            </StackPanel>

            <mascot:TuxAvatar x:Name="MainAvatar" Grid.Column="1"
                               Width="320" Height="380"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FollowCursor="True" ShowPivots="False"
                               AutomationProperties.Name="Tux mascot" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Layer.Card}"
                BorderBrush="{StaticResource Brush.Stroke.Card}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,11,28,12">
                <TextBlock Text="iGloo One" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                <Button Content="Mascot demo" Click="OnMascotDemoClick"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
