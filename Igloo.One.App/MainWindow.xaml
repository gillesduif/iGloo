<Window x:Class="Igloo.One.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mascot="clr-namespace:Igloo.Mascot.Wpf;assembly=Igloo.Mascot.Wpf"
        Title="iGloo One" MinWidth="760" MinHeight="580"
        Width="930" Height="675" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource Brush.Window}"
        TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="iGloo" FontSize="13" FontWeight="SemiBold" />
                <Border Background="{StaticResource Brush.Layer.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ONE" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;"
                        Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize" />
                <Button Click="OnMaxRestoreClick" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                            <Setter Property="Content" Value="&#xE922;" />
                            <Setter Property="AutomationProperties.Name" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;" />
                                    <Setter Property="AutomationProperties.Name" Value="Restore down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;"
                        Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,16,26,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Layer.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="0,0,0,1"
                            Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Chat with Tux" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12,20,12">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="13,10" CornerRadius="10"
                                            BorderThickness="1" MaxWidth="355">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Background" Value="#303945" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Card}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTux}" Value="False">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="Background" Value="#203C52" />
                                                        <Setter Property="BorderBrush" Value="#3A7293" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.AccentW11}"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Text.Primary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Stroke.Card}"
                            BorderThickness="0,1,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Ask about the check or request another one" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,6" />
                            <TextBox x:Name="MessageBox" MinHeight="58" MaxHeight="100" MaxLength="1000"
                                     Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" KeyDown="OnMessageKeyDown"
                                     AutomationProperties.Name="Message to Tux" />
                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="VoiceStatus" Text="Voice is off until you choose Dictate or Read reply."
                                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           Margin="0,0,0,8" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="DictateButton" Content="Dictate" Click="OnDictateClick"
                                            Margin="0,0,6,0" AutomationProperties.Name="Start voice dictation" />
                                    <Button x:Name="ReadReplyButton" Content="Read reply" Click="OnReadReplyClick"
                                            Margin="0,0,6,0" AutomationProperties.Name="Read Tux reply aloud" />
                                    <Button Content="Send" Click="OnSendClick" AutomationProperties.Name="Send message" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <mascot:TuxAvatar x:Name="MainAvatar" Width="260" Height="308"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FollowCursor="True" IsScanning="{Binding IsChecking}"
                                   AutomationProperties.Name="Tux mascot" />
                <Border Grid.Row="1" Background="{StaticResource Brush.Layer.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="1"
                        CornerRadius="8" Padding="14,11" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="SYSTEM CHECK" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" />
                        <TextBlock Text="{Binding Status}" FontSize="13" Margin="0,5,0,10"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check again" Click="OnCheckAgainClick"
                                    IsEnabled="{Binding CanCheck}" Margin="0,0,7,0" />
                            <Button Content="Wave" Click="OnWaveClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Layer.Card}"
                BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="0,1,0,0">
            <Grid Margin="24,11,28,12">
                <TextBlock Text="iGloo One · Read-only system check" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                <Button Content="Mascot demo" Click="OnMascotDemoClick"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
