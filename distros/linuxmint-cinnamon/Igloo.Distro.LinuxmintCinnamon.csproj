<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Igloo.Distro.LinuxmintCinnamon</RootNamespace>
    <AssemblyName>Igloo.Distro.LinuxmintCinnamon</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Igloo.Core\Igloo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="preseed\**\*"
             Link="linuxmint-cinnamon\preseed\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_debian-family\agent\**\*"
             Exclude="..\_debian-family\agent\**\__pycache__\**;..\_debian-family\agent\**\*.pyc"
             Link="linuxmint-cinnamon\agent\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_shared\grub-theme\grub-theme-stylish-*.tar.gz"
             Link="linuxmint-cinnamon\agent\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_shared\agent\igloo_boot.py"
             Link="linuxmint-cinnamon\agent\igloo_boot.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="distro.json" Link="linuxmint-cinnamon\distro.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginToDistroRoot" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
