<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Igloo.Distro.Debian</RootNamespace>
    <AssemblyName>Igloo.Distro.Debian</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Igloo.Core\Igloo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the preseed template and agent files into the assembly's output.
         The Debian-family agent is shared (Debian / Ubuntu / Mint detect the
         distro at runtime) and lives under distros/_debian-family/. -->
    <Content Include="preseed\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_debian-family\agent\**\*"
             Link="agent\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_shared\grub-theme\grub-theme-stylish-*.tar.gz"
             Link="agent\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_shared\agent\igloo_boot.py"
             Link="agent\igloo_boot.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="distro.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    After each build, copy the plugin DLL to the distro folder root so that DistroRegistry can
    discover it by scanning distros/<name>/Igloo.Distro.<Name>.dll at runtime.
  -->
  <Target Name="CopyPluginToDistroRoot" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
