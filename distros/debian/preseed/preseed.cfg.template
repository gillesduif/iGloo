# ============================================================================
# Igloo preseed template for Debian (debian-installer + live-installer)
# ----------------------------------------------------------------------------
# OFFLINE install, Mint-style. Igloo boots the hd-media debian-installer (which
# has iso-scan), points it at the Debian *Live* ISO staged on OEMDRV, and d-i's
# live-installer udeb copies the ISO's live/filesystem.squashfs straight onto the
# target. No package downloads, no mirror, no network during the install  the
# same mechanism the Mint (casper) plugin uses, which is what removes the netinst
# network dependency that stranded Wi-Fi-only machines.
#
# Because the desktop comes from the squashfs (not tasksel/apt), this preseed
# runs NEITHER tasksel NOR pkgsel  both would need the network we are avoiding.
# GPU drivers, codecs and any missing tools are handled by the Igloo first-boot
# agent, which brings the migrated Wi-Fi up first and then installs them.
#
# Placeholders are literal TOKENs replaced by the renderer (never braces here,
# or a multi-line value in a comment would break the literal replace):
#   LOCALE  KEYMAP  TIMEZONE  HOSTNAME  LINUX_USERNAME  FULL_NAME  PASSWORD
#
# Rendered on Windows; the app forces LF so a CRLF checkout can't break the
# busybox late_command (the bug that once broke the Fedora kickstart).
#
# The hd-media/live-installer path installed and booted Debian in a disposable
# UEFI VM. A same-size decoy test verified the selected-disk partman choice and
# installer-seed kernel binding. Precreated Linux ESP reuse and physical target
# execution still require separate proof and remain gated.
# ============================================================================

#   Localization
d-i debian-installer/locale string {{LOCALE}}
d-i keyboard-configuration/xkb-keymap select {{KEYMAP}}
d-i console-setup/ask_detect boolean false

#   Network  deliberately skipped at install time
# The point of the live-installer path is that no network is needed to install,
# so d-i's network stage is disabled entirely. This is also the direct fix for
# Wi-Fi-only machines: netcfg used to hang bringing up a link the installer
# couldn't drive. The first-boot agent brings Wi-Fi up from the migrated
# NetworkManager profiles instead.
d-i netcfg/enable boolean false
d-i netcfg/get_hostname string {{HOSTNAME}}
d-i netcfg/hostname string {{HOSTNAME}}

#   Install from the live squashfs, not the network
# live-installer copies live/filesystem.squashfs from the mounted Live ISO onto
# the target. live-installer/net-image is left UNSET on purpose: unset means use
# the local squashfs on the medium; an HTTP net-image would defeat the point.
d-i live-installer/enable boolean true

#   apt  no mirror during install
# use_mirror false: never reach for a mirror while installing (offline). The
# installed system's sources.list is written by late_command below so the
# first-boot agent can still apt-get drivers/codecs once Wi-Fi is up.
d-i apt-setup/use_mirror boolean false
d-i apt-setup/disable-cdrom-entries boolean true

#   Clock / timezone
d-i clock-setup/utc boolean true
d-i time/zone string {{TIMEZONE}}
# No NTP at install time  there is no network yet.
d-i clock-setup/ntp boolean false

#   Accounts
# Lock root; the new user gets sudo via the "sudo" group. The first-boot agent
# re-applies the password with chpasswd because plaintext preseeding is flaky
# across releases (the account is created but the password sometimes won't take).
d-i passwd/root-login boolean false
d-i passwd/user-fullname string {{FULL_NAME}}
d-i passwd/username string {{LINUX_USERNAME}}
d-i passwd/user-password-crypted password {{PASSWORD}}
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

#   Partitioning
# Igloo already prepared free space on the selected GPT disk. partman's stock
# biggest_free scans EVERY disk, including a same-size decoy; partman-auto/disk
# plus method=regular would instead erase an entire disk. Keep method unset and
# expose one free-space choice bound to the selected disk's GUID and byte size.
# The initrd setup helper installs a choice/action pair after validating the
# selected disk. partman invokes the choice after disk discovery; its action
# rechecks disk identity and the exact free extent before partitioning.
d-i partman/early_command string sh /igloo-bound-free-setup.sh
d-i partman-auto/init_automatically_partition select igloo_bound_free
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman/default_filesystem string ext4
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

#   Base system / desktop
# No tasksel, no pkgsel/include: the GNOME desktop and base tooling come from the
# live squashfs (offline). Installing packages here would need the network we are
# deliberately not using; missing extras are handled by the first-boot agent.
tasksel tasksel/first multiselect
d-i pkgsel/upgrade select none
popularity-contest popularity-contest/participate boolean false

#   Bootloader
# os-prober adds Windows to the menu; the first-boot agent re-runs it on the
# booted system, where the Windows partition is most reliably detected.
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string default

#   Finish
d-i finish-install/reboot_in_progress note

#   Bootstrap the Igloo first-boot agent (Mint-style)
# We do NOT touch OEMDRV here. As on the Mint (casper) path, the installer's
# running kernel may not match /target's modules, so mounting the FAT32 OEMDRV at
# install time is unreliable. Instead late_command only WRITES a self-contained
# bootstrap script + oneshot service into /target (plus a canonical sources.list
# so apt works post-boot). On the first boot of the *installed* system  where
# the running kernel matches its own modules and vfat mounts fine  that service
# mounts OEMDRV, copies agent.py + the manifest in, and runs the agent before the
# display manager. The script is written line-by-line with echo because a preseed
# value is one backslash-joined line and cannot contain a heredoc.
#
# The one in-target call is update-grub, needed so the installed GRUB blacklists
# nouveau from the very first boot — nouveau mis-renders recent NVIDIA cards and
# can black-screen that boot before the agent installs the real driver. Detected
# from the installer's own /proc, applied to the installed GRUB.
#
# Do NOT add nvidia-drm.modeset=1 or nvidia-drm.fbdev=1 here: commonly recommended
# online, but on the RTX 5070 reference machine they made the login screen worse
# (black, no cursor). Blacklist-only is the validated set — same as the Fedora
# kickstart, which carries the same warning.
d-i preseed/late_command string \
    set -eu ; umask 077 ; \
    seed_partuuid='' ; seed_diskguid='' ; part_count=0 ; disk_count=0 ; \
    for arg in $(cat /proc/cmdline) ; do \
        case "$arg" in \
            igloo.seedpartuuid=*) seed_partuuid=${arg#*=} ; part_count=$((part_count + 1)) ;; \
            igloo.seeddiskguid=*) seed_diskguid=${arg#*=} ; disk_count=$((disk_count + 1)) ;; \
        esac ; \
    done ; \
    [ "$part_count" -eq 1 ] || exit 1 ; [ "$disk_count" -eq 1 ] || exit 1 ; \
    echo "$seed_partuuid" | grep -Eq '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$' || exit 1 ; \
    echo "$seed_diskguid" | grep -Eq '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$' || exit 1 ; \
    seed_partuuid=$(printf '%s' "$seed_partuuid" | tr '[:upper:]' '[:lower:]') ; \
    seed_diskguid=$(printf '%s' "$seed_diskguid" | tr '[:upper:]' '[:lower:]') ; \
    echo "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware"                       >  /target/etc/apt/sources.list ; \
    echo "deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware"               >> /target/etc/apt/sources.list ; \
    echo "deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware" >> /target/etc/apt/sources.list ; \
    if grep -qi nvidia /proc/bus/pci/devices 2>/dev/null || lspci 2>/dev/null | grep -qi nvidia ; then \
        echo 'GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX rd.driver.blacklist=nouveau modprobe.blacklist=nouveau"' >> /target/etc/default/grub ; \
    fi ; \
    echo "GRUB_DISABLE_OS_PROBER=false" >> /target/etc/default/grub ; \
    in-target update-grub || true ; \
    mkdir -p /target/opt/igloo /target/var/lib/igloo /target/var/log/igloo /target/etc/systemd/system/multi-user.target.wants ; \
    chmod 0755 /target/opt /target/opt/igloo ; \
    echo "$seed_partuuid" > /target/var/lib/igloo/selected-seed-partuuid ; \
    echo "$seed_diskguid" > /target/var/lib/igloo/selected-seed-diskguid ; \
    chmod 0600 /target/var/lib/igloo/selected-seed-partuuid /target/var/lib/igloo/selected-seed-diskguid ; \
    cp /igloo-verify-seed.py /target/opt/igloo/igloo-verify-seed.py ; \
    chmod 0700 /target/opt/igloo/igloo-verify-seed.py ; \
    echo "#!/bin/sh"                                                                       >  /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "set -eu ; umask 077"                                                            >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "mkdir -p /opt/igloo /var/lib/igloo /var/log/igloo /run/igloo-seed"               >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "chmod 0755 /opt /opt/igloo"                                                   >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "exec >> /var/log/igloo/bootstrap.log 2>&1 ; set -x"                              >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "if test -f /var/lib/igloo/.done ; then exec /opt/igloo/first-boot.sh ; fi"       >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "modprobe vfat 2>/dev/null || true"                                               >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "seed_partuuid=\$(cat /var/lib/igloo/selected-seed-partuuid)"                      >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "echo \"\$seed_partuuid\" | grep -Eq '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\$' || exit 1" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "if mountpoint -q /run/igloo-seed ; then"                                           >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "    findmnt -rn -o OPTIONS --mountpoint /run/igloo-seed | grep -Eq '(^|,)ro(,|\$)' || exit 1" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "else mount -t vfat -o ro /dev/disk/by-partuuid/\$seed_partuuid /run/igloo-seed ; fi" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "selected_media=\$(python3 /opt/igloo/igloo-verify-seed.py /var/lib/igloo/selected-seed-partuuid /var/lib/igloo/selected-seed-diskguid /run/igloo-seed)" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "test -s /run/igloo-seed/migration-manifest.json"                                 >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "test -s /run/igloo-seed/igloo-seed-identity.json"                                >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "for file in agent.py first-boot.sh display-apply.py display-apply-gnome.py igloo_boot.py igloo-first-boot.service grub-theme-stylish-1080p.tar.gz grub-theme-stylish-4k.tar.gz ; do test -s \"/run/igloo-seed/igloo-agent/\$file\" ; done" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/agent.py      /opt/igloo/agent.py"                >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/first-boot.sh /opt/igloo/first-boot.sh"           >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/display-apply.py /opt/igloo/display-apply.py"    >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/display-apply-gnome.py /opt/igloo/display-apply-gnome.py" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/igloo_boot.py /opt/igloo/igloo_boot.py"           >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "cp /run/igloo-seed/igloo-agent/grub-theme-stylish-*.tar.gz /opt/igloo/"         >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "for file in \$selected_media ; do cp \"/run/igloo-seed/\$file\" \"/opt/igloo/\$file\" ; done" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "if test -s /var/lib/igloo/manifest.retry.json ; then install -m 0600 /var/lib/igloo/manifest.retry.json /var/lib/igloo/manifest.json ; else install -m 0600 /run/igloo-seed/migration-manifest.json /var/lib/igloo/manifest.json ; fi" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "install -m 0600 /run/igloo-seed/igloo-seed-identity.json /var/lib/igloo/seed-identity.json" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "chmod 0755 /opt/igloo/agent.py /opt/igloo/first-boot.sh /opt/igloo/display-apply.py /opt/igloo/display-apply-gnome.py" >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "chmod 0644 /opt/igloo/igloo_boot.py"                                         >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "# Keep the seed mounted read-only while the agent copies staged user files."      >> /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "exec /opt/igloo/first-boot.sh"                                                   >> /target/opt/igloo/igloo-bootstrap.sh ; \
    chmod 0755 /target/opt/igloo/igloo-bootstrap.sh ; \
    echo "[Unit]"                                          >  /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "Description=Igloo first-boot bootstrap"          >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "After=network-online.target local-fs.target"    >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "Wants=network-online.target"                    >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "Before=display-manager.service"                 >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo ""                                               >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "[Service]"                                      >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "Type=oneshot"                                   >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "ExecStart=/opt/igloo/igloo-bootstrap.sh"        >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "RemainAfterExit=yes"                            >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "TimeoutStartSec=2400"                           >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo ""                                               >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "[Install]"                                      >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    echo "WantedBy=multi-user.target"                     >> /target/etc/systemd/system/igloo-bootstrap.service ; \
    chmod 0644 /target/etc/systemd/system/igloo-bootstrap.service ; \
    ln -sf /etc/systemd/system/igloo-bootstrap.service /target/etc/systemd/system/multi-user.target.wants/igloo-bootstrap.service ; \
    echo "igloo: install-time bootstrap written"
