# ============================================================================
# Igloo kickstart template for Fedora KDE
# ----------------------------------------------------------------------------
# Rendered at runtime by the Igloo Windows-side app. Placeholders:
#   {{LOCALE}}             e.g. en_US.UTF-8
#   {{KEYMAP}}             e.g. be, us, de
#   {{XLAYOUT}}            same as KEYMAP (XKB layout name)
#   {{TIMEZONE}}           IANA tz, e.g. Europe/Brussels
#   {{HOSTNAME}}           <linux-username>-pc
#   {{LINUX_USERNAME}}     the user's chosen Linux login name
#   {{FULL_NAME}}          display name (falls back to username)
#   {{TARGET_DISK_BYTES}}  exact byte size of the user-selected target disk
#   {{TARGET_DISK_MODEL}}  model string of the target disk (informational)
#   {{WINDOWS_USERNAME}}   Windows login name (used by direct-install %post to
#                          locate the user's home directory on the NTFS partition)
#   {{INSTALL_MODE}}       "replace"   → wipe entire disk (clearpart --all)
#                          "dual-boot" → keep existing partitions, use free space
#                                        (clearpart --none; Windows was already
#                                         shrunk by the Igloo app before boot)
#   {{INCLUDED_FOLDERS}}   space-separated list of folder names (informational)
#                          (e.g. "Documents Downloads Pictures")
#   FOLDER_MAP (no braces — multi-line value; literal token only in the %post heredoc below)
#                          newline-separated "DestName|source/relative/path" pairs
#                          for the %post copy loop. The relative path is resolved
#                          on the Windows side (Known Folder API) so OneDrive
#                          redirection is honoured, e.g.:
#                              Documents|OneDrive/Documents
#                              Downloads|Downloads
#   BROWSER_MAP (no braces — multi-line value; literal token only in the %post heredoc below)
#                          newline-separated "source/relative|dest/relative" pairs
#                          for the %post browser-profile copy loop. Phase 1 covers
#                          Gecko browsers only (Firefox / Zen / Waterfox), whose
#                          profile roots are OS-portable and include saved
#                          passwords. Empty when no such browser was selected, e.g.:
#                              AppData/Roaming/Mozilla/Firefox|.mozilla/firefox
#                              AppData/Roaming/zen|.zen
#   {{PASSWORD_OPTION}}    rendered by the plugin as either
#                          "--password=<plaintext> --plaintext"  (normal case)
#                          "--lock"                              (fallback if no password)
#   {{WIFI_SSID}}          SSID of the network Windows was connected to, escaped
#                          for a bash double-quoted string ("" if none / wired-only)
#   {{WIFI_PSK}}           cleartext pre-shared key for {{WIFI_SSID}} ("" if open
#                          network or no key recovered)
#   {{INSTALL_SOURCE_URL}} the Anaconda install-source directive (a full `url …`
#                          line) telling the netinstall where to fetch packages.
#                          Rendered from distro.json's iso.stage2Url — typically a
#                          Fedora metalink ("Closest mirror"). Without it Anaconda
#                          stops with "Error setting up repositories".
#
# Picked up by Anaconda automatically: OEMDRV is a FAT32 volume with that
# label, which Anaconda has scanned for kickstart files for many years.
# ============================================================================

graphical

lang {{LOCALE}}
keyboard --vckeymap={{KEYMAP}} --xlayouts='{{XLAYOUT}}'
timezone {{TIMEZONE}} --utc

network --bootproto=dhcp --device=link --activate --hostname={{HOSTNAME}}

# ── Install source ────────────────────────────────────────────────────────────
# Direct-install boots with a LOCAL stage-2 (inst.stage2=hd:LABEL=OEMDRV) but the
# RPM packages for a netinstall must come from the network. This line points
# Anaconda at the Fedora mirror metalink (the "Closest mirror" option) so the
# repository is configured automatically — no interactive source prompt.
{{INSTALL_SOURCE_URL}}

rootpw --lock
user --name={{LINUX_USERNAME}} --groups=wheel --gecos="{{FULL_NAME}}" {{PASSWORD_OPTION}}

# ── Disk detection ───────────────────────────────────────────────────────────
# The %pre script runs before the installer initialises storage. It finds the
# target disk by matching the exact byte size stored in the manifest at
# image-build time, writes the bootloader / ignoredisk / clearpart / autopart
# commands to /tmp/ks-storage.cfg, and the %include below pulls them in.
#
# If no disk matches the expected size (e.g. the disk was replaced since the
# USB was written) the script falls back to the largest non-removable,
# non-USB disk so the installation still succeeds rather than hanging.
# ─────────────────────────────────────────────────────────────────────────────

%pre --interpreter=/bin/bash
set -euo pipefail

TARGET_BYTES="{{TARGET_DISK_BYTES}}"
TARGET_MODEL="{{TARGET_DISK_MODEL}}"
INSTALL_MODE="{{INSTALL_MODE}}"
TARGET_DISK=""
OEMDRV_DEV=""

log() { echo "[igloo-pre] $*" >&2; }
log "Searching for target disk: model='$TARGET_MODEL' size=${TARGET_BYTES} bytes"

# Enumerate all physical (non-partition) block devices.
# /sys/block/*/size is in 512-byte sectors; multiply to get bytes.
for sys_dev in /sys/block/sd* /sys/block/nvme*n1 /sys/block/vd* /sys/block/xvd*; do
    [ -e "$sys_dev/size" ] || continue
    devname=$(basename "$sys_dev")

    # Skip removable devices (USB sticks, SD cards, etc.)
    removable=$(cat "$sys_dev/removable" 2>/dev/null || echo 0)
    [ "$removable" = "1" ] && { log "  $devname: removable, skipping"; continue; }

    size_sectors=$(cat "$sys_dev/size" 2>/dev/null || echo 0)
    size_bytes=$(( size_sectors * 512 ))
    log "  $devname: ${size_bytes} bytes"

    if [ "$size_bytes" = "$TARGET_BYTES" ] && [ "$TARGET_BYTES" != "0" ]; then
        TARGET_DISK="$devname"
        log "  --> matched by size"
        break
    fi
done

# Fallback: largest non-removable, non-USB disk
if [ -z "$TARGET_DISK" ]; then
    log "No exact size match; falling back to largest non-removable disk"
    TARGET_DISK=$(
        lsblk -d -o NAME,SIZE,TYPE,TRAN -b -n 2>/dev/null \
            | awk '$3=="disk" && $4!="usb"' \
            | sort -k2 -rn \
            | head -1 \
            | awk '{print $1}'
    )
    log "  fallback target: $TARGET_DISK"
fi

if [ -z "$TARGET_DISK" ]; then
    log "ERROR: could not identify a target disk — kickstart will fail"
    # Write a dummy that produces a clear error instead of a silent hang
    echo "# ERROR: target disk not found" > /tmp/ks-storage.cfg
else
    log "Target disk: /dev/$TARGET_DISK  (mode: $INSTALL_MODE)"

    # NVIDIA GPUs: the open-source nouveau driver does not support very recent
    # cards (e.g. RTX 50-series / Blackwell) and mis-renders the framebuffer,
    # leaving a garbled boot screen that looks like a crash. Blacklist nouveau on
    # the installed kernel cmdline so the FIRST boot uses the simple UEFI
    # framebuffer (clean). The Igloo first-boot agent then installs the proprietary
    # NVIDIA driver; nouveau stays blacklisted afterwards, which is exactly what the
    # proprietary driver expects — so nothing has to be undone later. On non-NVIDIA
    # machines lspci finds nothing and the cmdline is left untouched.
    BOOT_APPEND=""
    if lspci -nn 2>/dev/null | grep -iE 'VGA|3D|Display' | grep -iq nvidia; then
        BOOT_APPEND=' --append="rd.driver.blacklist=nouveau modprobe.blacklist=nouveau"'
        log "NVIDIA GPU detected — blacklisting nouveau for a clean first boot"
    fi

    {
        # bootloader: omit --location on UEFI systems (Anaconda writes to ESP
        # automatically). --location=mbr on a GPT/UEFI disk triggers a warning
        # that causes Anaconda to stop at the interactive hub.
        echo "bootloader --boot-drive=${TARGET_DISK}${BOOT_APPEND}"
        echo "ignoredisk --only-use=${TARGET_DISK}"
        if [ "$INSTALL_MODE" = "dual-boot" ]; then
            # Windows partition was already shrunk by Igloo before USB boot.
            # clearpart --linux removes only Linux-type partitions (ext4, xfs,
            # swap, LVM PVs) while preserving the Windows NTFS and EFI
            # partitions.  This is safer than --none when re-installing because
            # --none leaves stale LVM volume-group metadata ("fedora" VG) on
            # disk; Anaconda detects the duplicate VG name and stops for user
            # confirmation instead of proceeding unattended.
            echo "clearpart --linux --drives=${TARGET_DISK}"
        else
            # Replace mode: wipe the entire disk.
            echo "clearpart --drives=${TARGET_DISK} --all --initlabel"
        fi
        echo "autopart --type=lvm --nohome"
    } > /tmp/ks-storage.cfg
    log "Storage config written to /tmp/ks-storage.cfg:"
    cat /tmp/ks-storage.cfg >&2
fi

# ── Wi-Fi connectivity for the netinstall ─────────────────────────────────────
# Anaconda's `network --essid --wpakey` kickstart directive is applied very
# early and is unreliable on real hardware — it frequently fires before the
# wireless driver/firmware is ready, so association silently never happens and
# the netinstall then fails with "error setting up repositories". Instead we
# actively bring the radio up and connect with nmcli HERE in %pre, retrying
# until association succeeds. NetworkManager is already running in Anaconda's
# installer environment, so nmcli is available.
#
# The freshly-installed system's Wi-Fi is configured separately by the Igloo
# first-boot agent (it writes NetworkManager keyfiles from the manifest), so we
# do NOT need a `network` directive at all — /tmp/ks-network.cfg stays empty and
# its %include below is a harmless no-op. Wired links are already handled by the
# `network --device=link --activate` line near the top of this kickstart.
# Auto-connect Wi-Fi for the netinstall. We try EVERY network the user had saved
# on Windows (not just one pre-picked "primary"): bring the radio up, scan, and
# associate with the first known network currently in range. This gets the
# netinstall online without Anaconda falling back to a manual Wi-Fi prompt.
# Each WIFI_LIST line is "SSID<TAB>PSK" (PSK empty for open networks). The
# installed system's Wi-Fi is configured separately by the first-boot agent, so
# /tmp/ks-network.cfg stays empty (its %include below is a harmless no-op).
: > /tmp/ks-network.cfg

WLAN_DEV=""
for wif in /sys/class/net/*/wireless; do
    [ -e "$wif" ] || continue
    WLAN_DEV=$(basename "$(dirname "$wif")")
    break
done

if [ -n "$WLAN_DEV" ]; then
    log "Wireless device: $WLAN_DEV - enabling radio and scanning"
    nmcli radio wifi on 2>/dev/null || true

    # Wait for the device to leave 'unavailable' (driver/firmware warm-up).
    for i in $(seq 1 15); do
        state=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: -v d="$WLAN_DEV" '$1==d{print $2}')
        [ -n "$state" ] && [ "$state" != "unavailable" ] && break
        sleep 2
    done

    TAB="$(printf '\t')"
    connected=0
    for pass in $(seq 1 6); do
        [ "$connected" = "1" ] && break
        nmcli device wifi rescan ifname "$WLAN_DEV" 2>/dev/null || true
        sleep 2
        VISIBLE=$(nmcli -t -f SSID device wifi list ifname "$WLAN_DEV" 2>/dev/null)
        while IFS="$TAB" read -r wssid wpsk; do
            [ -n "$wssid" ] || continue
            printf '%s\n' "$VISIBLE" | grep -Fxq "$wssid" || continue
            log "  Known network '$wssid' is in range - connecting"
            if [ -n "$wpsk" ]; then
                nmcli device wifi connect "$wssid" password "$wpsk" ifname "$WLAN_DEV" && { connected=1; break; }
            else
                nmcli device wifi connect "$wssid" ifname "$WLAN_DEV" && { connected=1; break; }
            fi
        done <<'WIFILIST'
{{WIFI_LIST}}
WIFILIST
        [ "$connected" = "1" ] && break
        log "  No known network connected yet (pass $pass/6) - rescanning"
        sleep 3
    done

    if [ "$connected" = "1" ]; then
        log "Wi-Fi connected on $WLAN_DEV"
    else
        log "WARNING: no saved Wi-Fi network in range - Anaconda may prompt for one"
    fi
else
    log "No wireless interface found - relying on a wired link if present"
fi
%end

# Pull in the storage commands generated by %pre above.
%include /tmp/ks-storage.cfg

# Pull in the Wi-Fi network command generated by %pre above (may be empty).
%include /tmp/ks-network.cfg

# ── Packages ──────────────────────────────────────────────────────────────────

%packages
@^kde-desktop-environment
@standard
@hardware-support
python3
python3-pip
rsync
git
ntfs-3g
%end

reboot

# ── Post-install (outside chroot) ─────────────────────────────────────────────
# Runs with access to both the installer environment (/run/install/repo = OEMDRV)
# and the freshly-installed system (/mnt/sysimage).  This is where we:
#   1. Copy the Igloo agent + manifest into the new system.
#   2. Copy the user's staged files (Documents, Downloads, …) into their home dir.
#   3. Register the igloo-first-boot.service systemd unit.
# ─────────────────────────────────────────────────────────────────────────────

%post --nochroot --interpreter=/bin/bash --log=/mnt/sysimage/var/log/igloo-post.log
set -euo pipefail

SYSIMAGE="/mnt/sysimage"

# Locate the OEMDRV partition by its FAT32 filesystem label.
# With netinstall, /run/install/repo is the network package repo — NOT the OEMDRV
# device.  We must find OEMDRV explicitly by label and mount it ourselves.
OEMDRV_DEV=$(blkid -L OEMDRV 2>/dev/null || true)
OEMDRV=""
if [ -n "$OEMDRV_DEV" ]; then
    OEMDRV="/tmp/igloo_oemdrv"
    mkdir -p "$OEMDRV"
    if ! mount -o ro "$OEMDRV_DEV" "$OEMDRV" 2>/dev/null; then
        OEMDRV=""
    fi
fi
if [ -z "$OEMDRV" ]; then
    echo "[igloo-post] WARNING: Could not mount OEMDRV (tried $OEMDRV_DEV) — agent/manifest copy skipped" >&2
fi
USERNAME="{{LINUX_USERNAME}}"
WINDOWS_USERNAME="{{WINDOWS_USERNAME}}"
INCLUDED_FOLDERS="{{INCLUDED_FOLDERS}}"
USER_HOME="$SYSIMAGE/home/$USERNAME"

log() { echo "[igloo-post] $*"; }

log "Starting Igloo post-install (nochroot)"
log "  OEMDRV   : $OEMDRV"
log "  SYSIMAGE : $SYSIMAGE"
log "  USERNAME : $USERNAME"

# ── 1. Create Igloo directories ──────────────────────────────────────────────
install -d -m 0755 \
    "$SYSIMAGE/opt/igloo" \
    "$SYSIMAGE/var/lib/igloo" \
    "$SYSIMAGE/var/log/igloo"

# ── 2. Copy the first-boot agent ────────────────────────────────────────────
if [ -n "$OEMDRV" ] && [ -d "$OEMDRV/igloo-agent" ]; then
    # Use 'install' rather than 'cp -a' + 'chmod +x' so that:
    #   a) permissions are set atomically (not dependent on FAT32 mount options),
    #   b) CRLF line endings from Windows are stripped inline via process
    #      substitution — a \r in the shebang causes status=203/EXEC on Linux.
    for src in "$OEMDRV/igloo-agent"/*.sh "$OEMDRV/igloo-agent"/*.py; do
        [ -f "$src" ] || continue
        fname=$(basename "$src")
        # tr -d '\r' strips any Windows CRLF before writing to the target FS.
        tr -d '\r' < "$src" | install -m 0755 /dev/stdin "$SYSIMAGE/opt/igloo/$fname"
        log "  Installed $fname (0755, LF-only)"
    done
    log "Agent installed to /opt/igloo"
else
    log "WARNING: igloo-agent directory not found on OEMDRV"
fi

# ── 3. Copy the migration manifest ──────────────────────────────────────────
if [ -n "$OEMDRV" ] && [ -f "$OEMDRV/migration-manifest.json" ]; then
    cp "$OEMDRV/migration-manifest.json" "$SYSIMAGE/var/lib/igloo/manifest.json"
    log "Manifest copied to /var/lib/igloo/manifest.json"
else
    log "WARNING: migration-manifest.json not found on OEMDRV"
fi

# ── 4. Copy user files ───────────────────────────────────────────────────────
# Two strategies depending on how Igloo wrote the installer:
#
#   USB mode:    OEMDRV/files/<FolderName>/  (user files were staged to USB)
#   Direct mode: OEMDRV has no files/ dir → mount Windows NTFS and copy directly

copy_user_files_done=0

if [ -d "$USER_HOME" ]; then
    if [ -n "$OEMDRV" ] && [ -d "$OEMDRV/files" ]; then
        # ── USB mode ─────────────────────────────────────────────────────────
        log "Copying staged user files from OEMDRV/files/ to $USER_HOME"
        for folder_src in "$OEMDRV/files"/*/; do
            [ -d "$folder_src" ] || continue
            folder_name=$(basename "$folder_src")
            folder_dst="$USER_HOME/$folder_name"
            mkdir -p "$folder_dst"
            cp -a "$folder_src/." "$folder_dst/"
            log "  Copied $folder_name"
        done
        copy_user_files_done=1
    else
        # ── Direct install mode ───────────────────────────────────────────────
        log "OEMDRV/files not present — attempting direct copy from Windows NTFS partition"
        NTFS_MNT="/tmp/igloo_ntfs_src"
        mkdir -p "$NTFS_MNT"

        for ntfs_dev in /dev/sd?[0-9]* /dev/nvme?n?p* /dev/vd?[0-9]*; do
            [ -b "$ntfs_dev" ] || continue
            blkid "$ntfs_dev" 2>/dev/null | grep -q 'TYPE="ntfs"' || continue

            mount -t ntfs-3g "$ntfs_dev" "$NTFS_MNT" -o ro 2>/dev/null || continue
            WIN_HOME="$NTFS_MNT/Users/$WINDOWS_USERNAME"

            if [ -d "$WIN_HOME" ]; then
                log "Found Windows home at $ntfs_dev : $WIN_HOME"
                # FOLDER_MAP holds one "DestName|source/relative/path" entry per
                # line (rendered from the manifest). The relative path is resolved
                # on the Windows side via the Known Folder API, so OneDrive-
                # redirected folders carry their real location (e.g.
                # "OneDrive/Documents") instead of a guessed "$WIN_HOME/Documents".
                # IFS='|' splits each line into dest name + relative source path;
                # the heredoc body/delimiter sit at column 0 as bash requires.
                while IFS='|' read -r fname frel; do
                    [ -n "$fname" ] || continue
                    src="$WIN_HOME/$frel"
                    dst="$USER_HOME/$fname"
                    if [ ! -d "$src" ]; then
                        log "  Skipping $fname (source '$frel' not found)"
                        continue
                    fi
                    mkdir -p "$dst"
                    # Tolerate individual unreadable files (e.g. OneDrive online-only
                    # placeholders) without aborting the whole %post under set -e.
                    cp -a "$src/." "$dst/" 2>/dev/null \
                        || log "  WARNING: some files in $fname could not be copied"
                    log "  Copied $fname from $frel"
                done <<'FOLDERMAP'
{{FOLDER_MAP}}
FOLDERMAP

                # ── Browser profiles (Phase 1: Gecko only) ───────────────────
                # BROWSER_MAP holds one "source/relative|dest/relative" entry per
                # migratable browser. Source is relative to the Windows home (e.g.
                # "AppData/Roaming/Mozilla/Firefox"); dest is relative to the Linux
                # $HOME (e.g. ".mozilla/firefox"). Only Gecko browsers (Firefox /
                # Zen / Waterfox) appear here — their profile roots are OS-portable
                # and carry saved passwords (NSS). Chromium passwords are DPAPI-
                # bound to the Windows account, so those browsers are not migrated.
                # The map is empty when no Gecko browser was selected, making the
                # loop a no-op.
                while IFS='|' read -r bsrc bdst; do
                    [ -n "$bsrc" ] || continue
                    src="$WIN_HOME/$bsrc"
                    dst="$USER_HOME/$bdst"
                    if [ ! -d "$src" ]; then
                        log "  Skipping browser '$bsrc' (source not found)"
                        continue
                    fi
                    mkdir -p "$dst"
                    cp -a "$src/." "$dst/" 2>/dev/null \
                        || log "  WARNING: some files in browser profile '$bsrc' could not be copied"
                    log "  Copied browser profile $bsrc -> $bdst"
                done <<'BROWSERMAP'
{{BROWSER_MAP}}
BROWSERMAP

                umount "$NTFS_MNT"
                copy_user_files_done=1
                break
            fi

            umount "$NTFS_MNT"
        done

        [ "$copy_user_files_done" = "1" ] || \
            log "WARNING: Windows home directory not found on any NTFS partition"
    fi
fi

# Fix ownership (only when files were actually copied).
if [ "$copy_user_files_done" = "1" ] && [ -d "$USER_HOME" ]; then
    USER_UID=$(grep "^${USERNAME}:" "$SYSIMAGE/etc/passwd" 2>/dev/null | cut -d: -f3 || true)
    USER_GID=$(grep "^${USERNAME}:" "$SYSIMAGE/etc/passwd" 2>/dev/null | cut -d: -f4 || true)
    if [ -n "${USER_UID:-}" ] && [ -n "${USER_GID:-}" ]; then
        chown -R "${USER_UID}:${USER_GID}" "$USER_HOME"
        log "Ownership set to ${USER_UID}:${USER_GID} on $USER_HOME"
    else
        log "WARNING: could not determine uid:gid for $USERNAME — skipping chown"
    fi
fi

# ── 5. Register the igloo-first-boot systemd service ────────────────────────
cat > "$SYSIMAGE/etc/systemd/system/igloo-first-boot.service" <<'UNIT'
[Unit]
Description=Igloo first-boot migration agent
Documentation=https://github.com/gillesduif/iGloo
After=network-online.target
Wants=network-online.target
# Hold the login screen until first-boot setup finishes. The agent performs
# heavy package operations (RPM Fusion, codecs, NVIDIA driver build, Flatpaks)
# that must NOT race the Plasma session start — doing so leaves the user on a
# half-initialised desktop (black screen). Ordering before the display manager
# means setup completes (and, for NVIDIA, the machine reboots) before any
# graphical session is created.
Before=display-manager.service
ConditionPathExists=/var/lib/igloo/manifest.json
ConditionPathExists=!/var/lib/igloo/.done

[Service]
Type=oneshot
ExecStart=/opt/igloo/first-boot.sh
StandardOutput=append:/var/log/igloo/first-boot.log
StandardError=append:/var/log/igloo/first-boot.log
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
UNIT

# Enable via chroot; fall back to manual symlink if systemctl isn't accessible.
chroot "$SYSIMAGE" systemctl enable igloo-first-boot.service 2>/dev/null || \
    ln -sf /etc/systemd/system/igloo-first-boot.service \
           "$SYSIMAGE/etc/systemd/system/multi-user.target.wants/igloo-first-boot.service"

log "igloo-first-boot.service registered"

# ── 6. Enable os-prober so GRUB detects Windows for dual-boot ───────────────
# Fedora 37+ disables os-prober by default (GRUB 2.06 security change).
# Without this, grub2-mkconfig never scans for Windows Boot Manager and the
# GRUB menu only shows Fedora — end users cannot get back to Windows.
if ! grep -q "GRUB_DISABLE_OS_PROBER=false" "$SYSIMAGE/etc/default/grub" 2>/dev/null; then
    echo "GRUB_DISABLE_OS_PROBER=false" >> "$SYSIMAGE/etc/default/grub"
    log "Enabled os-prober (GRUB_DISABLE_OS_PROBER=false)"
fi
# Regenerate GRUB config now that os-prober is enabled.
# Anaconda already ran grub2-mkconfig during install (without os-prober).
# We run it again here so the Windows entry is present on first boot.
chroot "$SYSIMAGE" grub2-mkconfig -o /boot/grub2/grub.cfg 2>/dev/null \
    && log "GRUB config regenerated — Windows entry added" \
    || log "WARNING: grub2-mkconfig failed; run 'sudo grub2-mkconfig -o /boot/grub2/grub.cfg' after first boot"

# ── 7. Remove EFI bootloader from installer partition (direct install only) ──
# The OEMDRV partition lives on the internal disk. Strip its EFI boot files so
# the firmware cannot accidentally restart the installer on the next boot.
# (BootNext is a one-shot NVRAM variable the firmware clears automatically after
#  use, but removing the EFI binary is belt-and-suspenders.)
if [ -n "$OEMDRV" ] && [ ! -d "$OEMDRV/files" ] && [ -d "$OEMDRV/EFI" ]; then
    rm -rf "$OEMDRV/EFI" 2>/dev/null || true
    log "Removed EFI boot files from installer partition (direct-install cleanup)"
fi

# Unmount OEMDRV if we mounted it.
if [ -n "$OEMDRV" ] && mountpoint -q "$OEMDRV" 2>/dev/null; then
    umount "$OEMDRV" 2>/dev/null || true
fi

log "Post-install complete"
%end
