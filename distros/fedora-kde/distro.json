    "gpgSignatureUrl": "https://download.fedoraproject.org/pub/fedora/linux/releases/44/KDE/x86_64/iso/Fedora-KDE-44-1.7-x86_64-CHECKSUM",
    "gpgKeyUrl": "https://fedoraproject.org/fedora.gpg"
  },

  "tags": [
    "best-for-windows-switchers",
