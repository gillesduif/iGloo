<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Igloo.Mascot.Wpf">
  <Style TargetType="{x:Type local:TaskCardRing}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TaskCardRing}">
          <Grid ClipToBounds="False">
            <Canvas x:Name="PART_Back" IsHitTestVisible="False" />
            <ContentPresenter x:Name="PART_AvatarHost" Content="{TemplateBinding Avatar}"
                              Width="216" Height="256" HorizontalAlignment="Center"
                              VerticalAlignment="Bottom" Margin="0,0,0,82" />
            <Canvas x:Name="PART_Front" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
