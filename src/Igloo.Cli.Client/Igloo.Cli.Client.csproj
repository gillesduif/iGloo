<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Igloo.Cli.Client</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>Gilles D'huyvetter</Authors>
    <Copyright>Copyright 2025-2026 Gilles D'huyvetter</Copyright>
    <Description>Process client for the iGloo CLI: locates the packaged Igloo.Cli.exe, speaks the invoke --machine JSON Lines transport and returns typed results.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gillesduif/iGloo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gillesduif/iGloo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>igloo;linux;migration;cli;client</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages\</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Igloo.Command.Contracts\Igloo.Command.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="LICENSE" Pack="true" PackagePath="\" />
    <None Update="NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
