<Application
    x:Class="Igloo.App.IglooApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Igloo.App.ViewModels"
    xmlns:views="clr-namespace:Igloo.App.Views"
    xmlns:conv="clr-namespace:Igloo.App.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!-- WPF's official Fluent (Win11) dark theme, merged via its ResourceDictionary
                     rather than the experimental ThemeMode property. IglooTheme.xaml is merged
                     after it so the iGloo tokens/templates win. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
                <ResourceDictionary Source="Themes/IglooTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--   Converters                        ─ -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BytesToSizeConverter    x:Key="BytesToSize" />
            <conv:ProportionalWidthConverter x:Key="ProportionalWidth" />

            <!--   View-model → view dispatch                ─ -->
            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
                <views:WelcomePage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PreflightViewModel}">
                <views:PreflightPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DistroSelectionViewModel}">
                <views:DistroSelectionPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:IsoAcquisitionViewModel}">
                <views:IsoAcquisitionPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MigrationSetupViewModel}">
                <views:MigrationSetupPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DiskSelectionViewModel}">
                <views:DiskSelectionPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DirectInstallViewModel}">
                <views:DirectInstallPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FileStagingViewModel}">
                <views:FileStagingPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsbWriterViewModel}">
                <views:UsbWriterPage />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>

</Application>
