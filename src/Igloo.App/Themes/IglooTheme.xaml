<!--
  iGloo theme - the single source of design tokens and control templates.

  The identity was set by the 3D distro picker: deep near-black-to-blue gradient,
  dramatic light on the focal element, calm secondary text, glow accents. Every
  wizard view consumes THIS dictionary; no per-view color/typography duplication.

  Token groups:  Color.* / Brush.*  →  raw palette
                 Text.*             →  typography scale styles
                 Card styles        →  surface containers (neutral / accent / semantic)
                 Control templates  →  implicit dark restyles of the WPF core controls
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:Igloo.App.Behaviors">

    <!-- ════════════════════════════════════════════════════════════════════
         1. PALETTE
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Backdrop -->
    <Color x:Key="Color.Bg.Top">#FF02040A</Color>
    <Color x:Key="Color.Bg.Mid">#FF0A1126</Color>
    <Color x:Key="Color.Bg.Bottom">#FF070B16</Color>

    <!-- Surfaces (cards sit slightly above the backdrop) -->
    <Color x:Key="Color.Surface">#FF101626</Color>
    <Color x:Key="Color.Surface.High">#FF161D31</Color>
    <Color x:Key="Color.Surface.Border">#FF232C45</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#FFF2F5FF</Color>
    <Color x:Key="Color.Text.Secondary">#FFA9B2CE</Color>
    <Color x:Key="Color.Text.Tertiary">#FF6B7694</Color>

    <!-- Accent (glacier blue - the "future" color) -->
    <Color x:Key="Color.Accent">#FF6C9CFF</Color>
    <Color x:Key="Color.Accent.Bright">#FF8FB5FF</Color>
    <Color x:Key="Color.Accent.Deep">#FF3D6CD6</Color>

    <!-- Semantics - kept saturated and high-contrast on dark; danger stays grave -->
    <Color x:Key="Color.Success">#FF5BDB95</Color>
    <Color x:Key="Color.Warning">#FFFFC163</Color>
    <Color x:Key="Color.Danger">#FFFF7B72</Color>
    <Color x:Key="Color.Danger.Deep">#FFD64545</Color>

    <SolidColorBrush x:Key="Brush.Surface"          Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.High"     Color="{StaticResource Color.Surface.High}" />
    <SolidColorBrush x:Key="Brush.Surface.Border"   Color="{StaticResource Color.Surface.Border}" />
    <SolidColorBrush x:Key="Brush.Text.Primary"     Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary"   Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary"    Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Accent"           Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Bright"    Color="{StaticResource Color.Accent.Bright}" />
    <SolidColorBrush x:Key="Brush.Accent.Deep"      Color="{StaticResource Color.Accent.Deep}" />
    <SolidColorBrush x:Key="Brush.Accent.Faint"     Color="#286C9CFF" />
    <SolidColorBrush x:Key="Brush.Success"          Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Success.Faint"    Color="#1F5BDB95" />
    <SolidColorBrush x:Key="Brush.Warning"          Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Warning.Faint"    Color="#22FFC163" />
    <SolidColorBrush x:Key="Brush.Danger"           Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger.Deep"      Color="{StaticResource Color.Danger.Deep}" />
    <SolidColorBrush x:Key="Brush.Danger.Faint"     Color="#2BFF7B72" />

    <!-- Window backdrop: the journey gradient -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Bg.Top}"    Offset="0" />
        <GradientStop Color="{StaticResource Color.Bg.Mid}"    Offset="0.55" />
        <GradientStop Color="{StaticResource Color.Bg.Bottom}" Offset="1" />
    </LinearGradientBrush>

    <!-- Glow effects (focal emphasis; used sparingly) -->
    <DropShadowEffect x:Key="Effect.AccentGlow"  Color="{StaticResource Color.Accent}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="Effect.AccentGlow.Soft" Color="{StaticResource Color.Accent}" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="Effect.DangerGlow"  Color="{StaticResource Color.Danger.Deep}" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />

    <!-- ════════════════════════════════════════════════════════════════════
         2. TYPOGRAPHY SCALE
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="56" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <!-- Section labels are written in caps in the views; WPF has no letter-spacing. -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Opacity"    Value="0.9" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="13" />
        <Setter Property="Foreground"   Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight"   Value="20" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <!-- Consolas first: it is in-box on all supported Windows. Cascadia Mono
             (ships with Terminal/VS, absent on a clean install) is only a nicety;
             leading with a guaranteed font avoids stressing font-fallback -->
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
        <Setter Property="FontSize"   Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         3. SURFACES (cards)
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="10" />
        <Setter Property="Padding"         Value="20,16" />
    </Style>

    <Style x:Key="Card.Accent" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="#553D6CD6" />
        <Setter Property="Background"  Value="#14182E" />
    </Style>

    <Style x:Key="Card.Success" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background"  Value="{StaticResource Brush.Success.Faint}" />
        <Setter Property="BorderBrush" Value="#665BDB95" />
    </Style>

    <Style x:Key="Card.Warning" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background"  Value="{StaticResource Brush.Warning.Faint}" />
        <Setter Property="BorderBrush" Value="#88FFC163" />
    </Style>

    <Style x:Key="Card.Danger" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background"  Value="{StaticResource Brush.Danger.Faint}" />
        <Setter Property="BorderBrush" Value="#99FF7B72" />
    </Style>

    <!-- Severity pill (small label chip) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding"      Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background"   Value="{StaticResource Brush.Accent.Faint}" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         4. BUTTONS - clear primary / secondary / ghost / danger hierarchy
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Secondary (the implicit default): quiet outlined surface -->
    <Style TargetType="Button">
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background"      Value="{StaticResource Brush.Surface.High}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"         Value="16,7" />
        <Setter Property="FontSize"        Value="13" />
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#0C1120" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: the one glowing action per screen -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{StaticResource Brush.Accent.Deep}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground"  Value="#FFFFFF" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Padding"     Value="20,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#4D7CE0" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2F55AC" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger: reserved for irreversible actions (reboot, erase) -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background"  Value="{StaticResource Brush.Danger.Deep}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E25555" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.DangerGlow}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.DangerGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#A93838" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: borderless tertiary (Quit, Cancel) -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground"  Value="{StaticResource Brush.Text.Secondary}" />
    </Style>

    <!-- Caption buttons (custom window chrome). Square hit targets, quiet until
         hovered; the close button hovers danger-red, consistent with the rest of
         the app's "destructive = red" rule. -->
    <Style x:Key="Button.Caption" TargetType="Button">
        <Setter Property="Width"      Value="46" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize"   Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Bright}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Danger.Deep}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Danger.Deep}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#A93838" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         5. CHECKBOX / RADIO
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontSize"   Value="13" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                Background="{StaticResource Brush.Surface.High}"
                                BorderBrush="{StaticResource Brush.Surface.Border}"
                                BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3.2,8.6 L 7,12.2 L 13.6,4.6"
                                  Stroke="#FFFFFF" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"  Value="{StaticResource Brush.Accent.Deep}" />
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Box" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip checkbox: pill toggle used for the folder picks -->
    <Style x:Key="CheckBox.Chip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontSize"   Value="13" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Root" CornerRadius="16" Padding="14,6"
                            Background="{StaticResource Brush.Surface.High}"
                            BorderBrush="{StaticResource Brush.Surface.Border}"
                            BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Tick" Text="✓  " FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Accent.Bright}"
                                       Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"  Value="{StaticResource Brush.Accent.Faint}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility"  Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontSize"   Value="13" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Ring" Width="17" Height="17"
                                 Stroke="{StaticResource Brush.Surface.Border}" StrokeThickness="1.5"
                                 Fill="{StaticResource Brush.Surface.High}"
                                 VerticalAlignment="Top" Margin="0,1,0,0" />
                        <Ellipse x:Name="Dot" Width="7" Height="7"
                                 Fill="{StaticResource Brush.Accent.Bright}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="5,6,0,0" Visibility="Collapsed" />
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Top" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Dot"  Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Ring" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         6. PROGRESSBAR - thin glowing accent line on a recessed track
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height"     Value="6" />
        <Setter Property="Background" Value="#1A2138" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                Effect="{StaticResource Effect.AccentGlow.Soft}" />
                        <!--
                          Indeterminate sweep. The bright band lives in a full-width brush
                          whose RelativeTransform works in normalised 0..1 space, so the
                          sweep spans the whole bar and re-enters from the left at any
                          width - no hard-coded pixel travel that overshoots wide bars.
                        -->
                        <Border x:Name="Sweep" CornerRadius="3" Visibility="Collapsed"
                                Effect="{StaticResource Effect.AccentGlow.Soft}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Pad">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="SweepTransform" X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Offset="0.0"  Color="#008FB5FF" />
                                    <GradientStop Offset="0.30" Color="#008FB5FF" />
                                    <GradientStop Offset="0.42" Color="#FF8FB5FF" />
                                    <GradientStop Offset="0.58" Color="#FF8FB5FF" />
                                    <GradientStop Offset="0.70" Color="#008FB5FF" />
                                    <GradientStop Offset="1.0"  Color="#008FB5FF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SweepStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SweepTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-1" To="1" Duration="0:0:1.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         7. TEXT INPUT (TextBox / PasswordBox)
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush"      Value="{StaticResource Brush.Accent.Bright}" />
        <Setter Property="SelectionBrush"  Value="{StaticResource Brush.Accent.Deep}" />
        <Setter Property="Background"      Value="{StaticResource Brush.Surface.High}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="FontSize"        Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush"      Value="{StaticResource Brush.Accent.Bright}" />
        <Setter Property="SelectionBrush"  Value="{StaticResource Brush.Accent.Deep}" />
        <Setter Property="Background"      Value="{StaticResource Brush.Surface.High}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="FontSize"        Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         8. COMBOBOX
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Padding"    Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Faint}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Deep}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background"      Value="{StaticResource Brush.Surface.High}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="Padding"         Value="12,7" />
        <Setter Property="FontSize"        Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root" CornerRadius="8" BorderThickness="1.5"
                                            Background="{StaticResource Brush.Surface.High}"
                                            BorderBrush="{StaticResource Brush.Surface.Border}">
                                        <Path Data="M 0,0 L 4.5,5 L 9,0"
                                              Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Placement="Bottom"
                               PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="{StaticResource Brush.Surface.High}"
                                    BorderBrush="{StaticResource Brush.Surface.Border}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="0,4" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         9. SLIDER - accent thumb with glow, recessed track
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="26" Background="Transparent">
                        <Border Height="5" CornerRadius="2.5" Background="#1A2138" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <!-- The decrease button doubles as the filled (accent) part of the track. -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="5" CornerRadius="2.5"
                                                        Background="{StaticResource Brush.Accent.Deep}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="{StaticResource Brush.Accent.Bright}"
                                                     Stroke="#FFFFFF" StrokeThickness="0"
                                                     Effect="{StaticResource Effect.AccentGlow.Soft}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Effect" Value="{StaticResource Effect.AccentGlow}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         10. EXPANDER / SEPARATOR / SCROLLBAR / LISTBOX
         ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Arrow" Data="M 0,0 L 5,4.5 L 0,9"
                                                  Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center" Margin="2,0,8,0"
                                                  RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              TextElement.Foreground="{StaticResource Brush.Text.Secondary}"
                                                              VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Brush.Accent.Bright}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Content" Visibility="Collapsed" Margin="15,6,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="Height"     Value="1" />
        <Setter Property="Margin"     Value="0,18" />
    </Style>

    <!--
      Modern overlay scrollbar. The thumb is a slim translucent pill that thickens and
      brightens on hover and turns accent while dragging; the track itself stays invisible
      until the pointer is over the bar, then fades in a faint channel. The pill is inset
      with Margin (not Width) so the hit target stays the full bar width while the visible
      thumb looks light. IsHitTestVisible drag state via the Thumb's own IsDragging.
    -->
    <!-- Idle / hover / drag fills for the pill. The cross-axis gradient (light core,
         dark edges) gives the thumb a rounded 3D-tube read instead of a flat slab. -->
    <LinearGradientBrush x:Key="ScrollThumb.Idle" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#33405E" />
        <GradientStop Offset="0.5" Color="#54688F" />
        <GradientStop Offset="1.0" Color="#33405E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumb.Hover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#46567C" />
        <GradientStop Offset="0.5" Color="#7588B8" />
        <GradientStop Offset="1.0" Color="#46567C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumb.Drag" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#3D6CD6" />
        <GradientStop Offset="0.5" Color="#8FB5FF" />
        <GradientStop Offset="1.0" Color="#3D6CD6" />
    </LinearGradientBrush>

    <ControlTemplate x:Key="ScrollBarThumbTemplate" TargetType="Thumb">
        <Border x:Name="Pill" Background="{StaticResource ScrollThumb.Idle}"
                CornerRadius="2" Margin="1" SnapsToDevicePixels="True" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource ScrollThumb.Hover}" />
                <Setter TargetName="Pill" Property="Margin"     Value="0.5" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource ScrollThumb.Drag}" />
                <Setter TargetName="Pill" Property="Margin"     Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarPageButtonTemplate" TargetType="RepeatButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width"      Value="5" />
        <Setter Property="MinWidth"   Value="0" />
        <Setter Property="MinHeight"  Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Border x:Name="Channel" Background="Transparent" CornerRadius="6" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                              Template="{StaticResource ScrollBarPageButtonTemplate}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                              Template="{StaticResource ScrollBarPageButtonTemplate}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28" Template="{StaticResource ScrollBarThumbTemplate}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Channel" Property="Background" Value="#24070B16" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"  Value="Auto" />
                <Setter Property="Height" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border x:Name="Channel" Background="Transparent" CornerRadius="6" />
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                      Template="{StaticResource ScrollBarPageButtonTemplate}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                      Template="{StaticResource ScrollBarPageButtonTemplate}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinWidth="28" Template="{StaticResource ScrollBarThumbTemplate}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Channel" Property="Background" Value="#24070B16" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <!--
      Custom ScrollViewer template. The stock template sizes its scrollbar column to the
      system metric (~17px) regardless of any Width set on the ScrollBar style, so to get
      a genuinely slim bar we lay the scrollbars out ourselves with an explicit width.
      Also flips on smooth eased wheel scrolling for every ScrollViewer in the app.
    -->
    <Style TargetType="ScrollViewer">
        <Setter Property="b:SmoothScroll.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Margin="{TemplateBinding Padding}" />

                        <!-- 5px-wide bars; the thumb pill is inset from these via the
                             ScrollBar thumb template. -->
                        <!-- The left/top margins are the breathing gap between the content
                             and the bar; the Auto column/row collapses to nothing when the
                             bar is hidden, so no space is wasted then. -->
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                            Orientation="Vertical" Width="5" MinWidth="0" Margin="9,0,0,0"
                            Value="{TemplateBinding VerticalOffset}"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                            Orientation="Horizontal" Height="5" MinHeight="0" Margin="0,9,0,0"
                            Value="{TemplateBinding HorizontalOffset}"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only mono detail box (error dumps) -->
    <Style x:Key="TextBox.Detail" TargetType="TextBox">
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Background"      Value="#0C1120" />
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily"      Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize"        Value="10.5" />
        <Setter Property="Padding"         Value="8" />
        <Setter Property="IsReadOnly"      Value="True" />
        <Setter Property="CaretBrush"      Value="{StaticResource Brush.Accent.Bright}" />
        <Setter Property="SelectionBrush"  Value="{StaticResource Brush.Accent.Deep}" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         11. 3D DEVICE ICONS (isometric, drawn — no raster assets)
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Internal drive / SSD: an isometric box, top face lit, right face shadowed,
         front face a vertical gradient, with a small accent activity LED. 32x32. -->
    <DrawingImage x:Key="Icon.Drive3D">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- right (shadow) face -->
                <GeometryDrawing Brush="#222B43" Geometry="M24,11 L28,7 L28,22 L24,26 Z" />
                <!-- top (lit) face -->
                <GeometryDrawing Brush="#4E628C" Geometry="M6,11 L10,7 L28,7 L24,11 Z" />
                <!-- front face -->
                <GeometryDrawing Geometry="M6,11 L24,11 L24,26 L6,26 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3E5176" />
                            <GradientStop Offset="1" Color="#27314A" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- activity LED -->
                <GeometryDrawing Brush="#8FB5FF" Geometry="M9,22.5 L13,22.5 L13,24 L9,24 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- USB stick: isometric body + metallic connector. 32x32. -->
    <DrawingImage x:Key="Icon.Usb3D">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- body right (shadow) face -->
                <GeometryDrawing Brush="#222B43" Geometry="M20,13 L23,10 L23,26 L20,29 Z" />
                <!-- body top (lit) face -->
                <GeometryDrawing Brush="#46587E" Geometry="M11,13 L14,10 L23,10 L20,13 Z" />
                <!-- body front face -->
                <GeometryDrawing Geometry="M11,13 L20,13 L20,29 L11,29 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3E5176" />
                            <GradientStop Offset="1" Color="#27314A" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- metal connector right face -->
                <GeometryDrawing Brush="#7C8699" Geometry="M18,6 L20,4 L20,13 L18,15 Z" />
                <!-- metal connector top face -->
                <GeometryDrawing Brush="#AEB7C6" Geometry="M13,6 L15,4 L20,4 L18,6 Z" />
                <!-- metal connector front face -->
                <GeometryDrawing Brush="#9AA3B4" Geometry="M13,6 L18,6 L18,15 L13,15 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
