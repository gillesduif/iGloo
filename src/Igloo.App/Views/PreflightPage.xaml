<UserControl
    x:Class="Igloo.App.Views.PreflightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstractions="clr-namespace:Igloo.Core.Abstractions;assembly=Igloo.Core">

    <UserControl.Resources>

        <!-- Severity → left accent rail; danger keeps its gravity on dark -->
        <Style x:Key="FindingCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Surface.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="Margin"          Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}"
                             Value="{x:Static abstractions:FindingSeverity.Warning}">
                    <Setter Property="Background"  Value="{StaticResource Brush.Warning.Faint}" />
                    <Setter Property="BorderBrush" Value="#88FFC163" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}"
                             Value="{x:Static abstractions:FindingSeverity.Blocker}">
                    <Setter Property="Background"  Value="{StaticResource Brush.Danger.Faint}" />
                    <Setter Property="BorderBrush" Value="#AAFF7B72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FindingSeverityLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource Brush.Text.Tertiary}" />
            <Setter Property="FontSize"    Value="10.5" />
            <Setter Property="FontWeight"  Value="Bold" />
            <Setter Property="Margin"      Value="0,0,0,3" />
            <Setter Property="Text"        Value="INFO" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}"
                             Value="{x:Static abstractions:FindingSeverity.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                    <Setter Property="Text"       Value="WARNING" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}"
                             Value="{x:Static abstractions:FindingSeverity.Blocker}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                    <Setter Property="Text"       Value="BLOCKER" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Instrument row label -->
        <Style x:Key="GaugeLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- ── 1. RUNNING ─────────────────────────────────────────────────── -->
        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="340" />
            <TextBlock Text="Reading your hardware…"
                       Style="{StaticResource Text.Body}" FontSize="14"
                       Margin="0,16,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="firmware · secure boot · TPM · BitLocker · memory · storage"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ── 2. ERROR ───────────────────────────────────────────────────── -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource Card.Danger}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="System check failed"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Danger}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ── 3. RESULTS: the instrument panel ───────────────────────────── -->
        <ScrollViewer Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- System overview -->
                <TextBlock Text="THIS MACHINE" Style="{StaticResource Text.Section}" Margin="2,0,0,8" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <!-- left column -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Firmware" Style="{StaticResource GaugeLabel}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FirmwareDisplay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" />
                            <TextBlock Text="  ●" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Success}"
                                       Visibility="{Binding FirmwareOk, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Secure Boot" Style="{StaticResource GaugeLabel}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SecureBootDisplay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" />
                            <TextBlock Text="  ●" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Warning}"
                                       Visibility="{Binding SecureBootWarn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TPM" Style="{StaticResource GaugeLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TpmDisplay}"
                                   Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" VerticalAlignment="Center" />

                        <!-- right column -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="BitLocker" Style="{StaticResource GaugeLabel}" />
                        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BitLockerDisplay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" />
                            <TextBlock Text="  ●" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Danger}"
                                       Visibility="{Binding BitLockerBlocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="RAM" Style="{StaticResource GaugeLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding RamDisplay}"
                                   Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="GPU" Style="{StaticResource GaugeLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding GpuDisplay}"
                                   Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Findings -->
                <TextBlock Text="FINDINGS" Style="{StaticResource Text.Section}" Margin="2,22,0,8" />

                <Border Style="{StaticResource Card.Success}" Padding="14,10"
                        Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" Margin="0,0,10,0" />
                        <TextBlock Text="No issues detected. You are ready to proceed."
                                   Foreground="{StaticResource Brush.Success}" FontSize="13" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Findings}"
                              Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FindingCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FindingSeverityLabelStyle}" />
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock Text="{Binding Remediation}"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="FontSize" Value="12" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Remediation}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- One-click fix: Disable BitLocker -->
                                    <Button Margin="0,10,0,2"
                                            HorizontalAlignment="Left"
                                            Content="Disable BitLocker now"
                                            Command="{Binding DataContext.DisableBitLockerCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Code}" Value="BITLOCKER_ACTIVE">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BitLocker action status (while manage-bde runs) -->
                <Border Style="{StaticResource Card.Accent}" Padding="14,10" Margin="0,2,0,0"
                        Visibility="{Binding HasBitLockerActionStatus, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳  " Foreground="{StaticResource Brush.Accent.Bright}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BitLockerActionStatus}"
                                   Foreground="{StaticResource Brush.Accent.Bright}"
                                   TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Storage inventory -->
                <TextBlock Text="STORAGE" Style="{StaticResource Text.Section}" Margin="2,22,0,8" />

                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="12" Margin="8,1,0,0">
                                            <Run Text="{Binding TotalBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PartitionStyle, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Partitions}" Margin="2,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="▪  " Foreground="{StaticResource Brush.Accent.Deep}" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileSystem}" FontSize="12"
                                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                                    <TextBlock Margin="6,0,0,0" FontSize="12"
                                                               Foreground="{StaticResource Brush.Text.Tertiary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Label}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="6,0,0,0">
                                                        <Run Text="—  " /><Run Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <Border>
                                                        <TextBlock Text="SYSTEM" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource Brush.Accent.Bright}" />
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                                <Setter Property="Margin" Value="8,0,0,0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystem}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Border>
                                                        <TextBlock Text="BOOT" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="#C9B5FF" />
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Margin" Value="4,0,0,0" />
                                                                <Setter Property="Background" Value="#2B8F6CFF" />
                                                                <Setter Property="CornerRadius" Value="4" />
                                                                <Setter Property="Padding" Value="7,2" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBoot}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
