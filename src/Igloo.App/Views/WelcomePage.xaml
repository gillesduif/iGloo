<UserControl
    x:Class="Igloo.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Igloo.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:WelcomeDesignData, IsDesignTimeCreatable=True}"
    d:DesignWidth="900" d:DesignHeight="1100">

  <UserControl.Resources>
    <!-- One node of the journey map -->
    <Style x:Key="JourneyNode" TargetType="Border">
      <Setter Property="Width"  Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{StaticResource Brush.Surface.High}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Deep}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="JourneyEdge" TargetType="Border">
      <Setter Property="Height" Value="1.5" />
      <Setter Property="Background" Value="#332C66C9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="-26,17,-26,0" />
    </Style>
    <Style x:Key="JourneyLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="JourneyCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,3,6,0" />
    </Style>

    <!-- Quiz chips: same Win11 pill idiom as the picker's category chips -->
    <Style x:Key="QuizChipItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Win11}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" CornerRadius="14" Padding="13,5"
                                BorderThickness="1"
                                Background="Transparent"
                                BorderBrush="{StaticResource Brush.Stroke.Card}">
              <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       x:Name="ChipText" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.Layer.CardHover}" />
                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.AccentW11}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Brush.AccentW11}" />
                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuizChipList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Win11}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource QuizChipItem}" />
      <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuizQuestion" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>

    <!-- Feature cards: Win11 Settings idiom  neutral glyph box (Segoe Fluent
             Icons, no decorative color per the charter). Laid out 3x2, so the
             margin is even on all sides: a grid needs horizontal gutters too, and
             the six cards divide exactly into three columns. -->
    <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,14" />
      <Setter Property="Margin" Value="5" />
    </Style>
    <Style x:Key="FeatureGlyphBox" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource Brush.Layer.Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Card}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FeatureGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FeatureTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="FeatureCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <!-- Scrolls only when the quiz makes the page taller than the window;
         MinHeight = viewport keeps the star-row centering intact otherwise. -->
  <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroller}" Width="688">
      <!-- Hero + journey + quiz are one centered group; the warning anchors
             the bottom. Symmetric star rows keep the group visually centered
             without a dead gap in the middle. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--   Hero                              ─ -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" MaxWidth="760">
        <Image Height="169" Width="172" Source="/Views/iGloo.png"/>
        <TextBlock
               Style="{StaticResource Text.Body}"
               FontSize="22" TextAlignment="Center" TextWrapping="Wrap" Foreground="White" Width="685" FontWeight="Bold" ><Run Language="nl-be" Text="iGloo"/></TextBlock>
        <TextBlock
                       Style="{StaticResource Text.Body}"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FF8A8A8A" Width="685" ><Run Text="A windows tool for "/><Run Text="Linux i"/><Run Text="nstallation. "/></TextBlock>
      </StackPanel>

      <!--   What iGloo does for you: four feature rows (mockup 2026-07)    -->
      <!-- 3x2: exactly six features, so the grid divides evenly with no orphan card
           on a short final row. UniformGrid also keeps every card the same height
           regardless of caption length, which a WrapPanel would not. -->
      <!-- Right margin clears the overlay scrollbar (same 16px as the other
           scrolling pages); the cards' own 5px margins form the inner gutters. -->
      <UniformGrid Grid.Row="2" Rows="2" Columns="3" MaxWidth="760" Margin="0,24,16,0">
        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xE770;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Style="{StaticResource FeatureTitle}" ><Run Language="nl-be" Text="Linux System"/></TextBlock>
                            <TextBlock Text="Handles distribution installation and removal with dual-boot configuration." Style="{StaticResource FeatureCaption}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xE8B7;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Style="{StaticResource FeatureTitle}" ><Run Text="User "/><Run Language="nl-be" Text="D"/><Run Text="ata"/></TextBlock>
            <TextBlock Text="Migrating files and user profile data to the corresponding directories" Style="{StaticResource FeatureCaption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xE774;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Text="Web Browsers " Style="{StaticResource FeatureTitle}" />
              <TextBlock Text="Restores active tab sessions and stored login credentials." Style="{StaticResource FeatureCaption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xE713;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Text="System Settings " Style="{StaticResource FeatureTitle}" />
                            <TextBlock Style="{StaticResource FeatureCaption}" Text="Synchronizes system configurations and user preferences." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xE950;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Style="{StaticResource FeatureTitle}" Text="Graphics Drivers " />
                            <TextBlock Style="{StaticResource FeatureCaption}" Text="Detecting and installing compatible graphics drivers." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FeatureCard}">
          <StackPanel>
            <Border HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource FeatureGlyphBox}">
              <TextBlock Text="&#xED35;" Style="{StaticResource FeatureGlyph}" />
            </Border>
            <TextBlock Style="{StaticResource FeatureTitle}" Text="Applications "/>
              <TextBlock Style="{StaticResource FeatureCaption}"><Run Text="Installs native Linux alternatives for detected Windows apps."/></TextBlock>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--   Quiz                              ─ -->
      <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,24,37,0" Grid.RowSpan="3" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="What will you mostly use it for?" Style="{StaticResource QuizQuestion}" />
          <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding UseOptions}"
                         SelectedItem="{Binding SelectedUse, Mode=TwoWay}"
                         AutomationProperties.Name="What will you mostly use it for?" />

          <TextBlock Text="What should it feel like?" Style="{StaticResource QuizQuestion}" />
          <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding StyleOptions}"
                         SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                         AutomationProperties.Name="What should it feel like?" />

          <TextBlock Text="How should updates behave?" Style="{StaticResource QuizQuestion}" />
          <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding UpdateOptions}"
                         SelectedItem="{Binding SelectedUpdates, Mode=TwoWay}"
                         AutomationProperties.Name="How should updates behave?" />
        </StackPanel>
      </Border>

      <!-- The alpha warning is no longer a card here: a banner on a page the user
           scrolls past is read once and then becomes furniture. It is shown as a modal
           on startup instead (see WelcomePage.xaml.cs), which has to be acknowledged
           before anything can touch a disk. -->

    </Grid>
  </ScrollViewer>
</UserControl>
