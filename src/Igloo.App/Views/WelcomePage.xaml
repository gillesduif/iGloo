<UserControl
    x:Class="Igloo.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- One node of the journey map -->
        <Style x:Key="JourneyNode" TargetType="Border">
            <Setter Property="Width"  Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface.High}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Deep}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="JourneyEdge" TargetType="Border">
            <Setter Property="Height" Value="1.5" />
            <Setter Property="Background" Value="#332C66C9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-26,17,-26,0" />
        </Style>
        <Style x:Key="JourneyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="JourneyCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,3,6,0" />
        </Style>

        <!-- Quiz chips: same Win11 pill idiom as the picker's category chips -->
        <Style x:Key="QuizChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Win11}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="14" Padding="13,5"
                                BorderThickness="1"
                                Background="Transparent"
                                BorderBrush="{StaticResource Brush.Stroke.Card}">
                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       x:Name="ChipText" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.Layer.CardHover}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.AccentW11}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Brush.AccentW11}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuizChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Win11}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource QuizChipItem}" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuizQuestion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </UserControl.Resources>

    <!-- Scrolls only when the quiz makes the page taller than the window;
         MinHeight = viewport keeps the star-row centering intact otherwise. -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroller}">
        <!-- Hero + journey + quiz are one centered group; the warning anchors
             the bottom. Symmetric star rows keep the group visually centered
             without a dead gap in the middle. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Hero ─────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                <TextBlock.Inlines>
                    <Run Text="Your computer" FontSize="34" FontWeight="Light"
                         Foreground="{StaticResource Brush.Text.Primary}" />
                    <Run Text=" set free." FontSize="34" FontWeight="SemiBold"
                         Foreground="{StaticResource Brush.Accent.Bright}" />
                </TextBlock.Inlines>
            </TextBlock>
            <TextBlock Text="iGloo installs Linux from Windows. You do not need any IT background experience to use this program. Your files, browsers, settings and apps migrate with you."
                       Style="{StaticResource Text.Body}"
                       FontSize="14" TextAlignment="Center" MaxWidth="520"
                       Margin="0,14,0,0" Foreground="#FF8A8A8A" />
        </StackPanel>
        <!-- ── Pre-alpha warning: stern, no cuteness ─────────────────────────── -->
        <Border Grid.Row="5" Style="{StaticResource Card.Warning}" Padding="16,12"
           MaxWidth="640" Margin="0,8,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource Brush.Warning}"
                      VerticalAlignment="Top" Margin="0,1,12,0" />
                <TextBlock Style="{StaticResource Text.Body}" MaxWidth="560" Foreground="White">
               <Run FontWeight="Bold" Foreground="{StaticResource Brush.Warning}">Alpha software.</Run>
               <Run Foreground="{StaticResource Brush.Text.Tertiary}">
                   iGloo modifies partition tables and boot configuration.
                   Do not run this on your main machine that you cannot afford to lose.
               </Run>
                </TextBlock>
            </StackPanel>
        </Border>
        <!-- ── Journey map: four glowing waypoints ──────────────────────────── -->
        <Grid Grid.Row="2" MaxWidth="640" Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- connecting line behind the nodes -->
            <Border Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource JourneyEdge}"
                    Margin="84,18,76,0" VerticalAlignment="Top" />

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource JourneyNode}">
                    <TextBlock Text="1" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="System check" Style="{StaticResource JourneyLabel}" />
                <TextBlock Text="confirms your machine is ready" Style="{StaticResource JourneyCaption}" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource JourneyNode}">
                    <TextBlock Text="2" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Choose Linux" Style="{StaticResource JourneyLabel}" />
                <TextBlock Text="pick a distribution from the catalog" Style="{StaticResource JourneyCaption}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource JourneyNode}">
                    <TextBlock Text="3" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Download" Style="{StaticResource JourneyLabel}" />
                <TextBlock Text="fetched and cryptographically verified" Style="{StaticResource JourneyCaption}" />
            </StackPanel>

            <StackPanel Grid.Column="3">
                <Border Style="{StaticResource JourneyNode}">
                    <TextBlock Text="4" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Reboot &amp; install" Style="{StaticResource JourneyLabel}" />
                <TextBlock Text="Linux arrives, your files follow" Style="{StaticResource JourneyCaption}" />
            </StackPanel>
        </Grid>

        <!-- ── Find-your-Linux quiz: three questions against choice paralysis.
             Optional — all answers feed one RECOMMENDED badge in the picker. ── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14"
                MaxWidth="640" HorizontalAlignment="Center" Margin="0,26,0,0">
            <StackPanel>
                <TextBlock Text="NOT SURE WHICH LINUX?" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Answer three quick questions and iGloo highlights its pick in the catalog. Optional - skip ahead if you already know."
                           Style="{StaticResource Text.Caption}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="What will you mostly use it for?" Style="{StaticResource QuizQuestion}" />
                <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding UseOptions}"
                         SelectedItem="{Binding SelectedUse, Mode=TwoWay}"
                         AutomationProperties.Name="What will you mostly use it for?" />

                <TextBlock Text="What should it feel like?" Style="{StaticResource QuizQuestion}" />
                <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding StyleOptions}"
                         SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                         AutomationProperties.Name="What should it feel like?" />

                <TextBlock Text="How should updates behave?" Style="{StaticResource QuizQuestion}" />
                <ListBox Style="{StaticResource QuizChipList}"
                         ItemsSource="{Binding UpdateOptions}"
                         SelectedItem="{Binding SelectedUpdates, Mode=TwoWay}"
                         AutomationProperties.Name="How should updates behave?" />
            </StackPanel>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
