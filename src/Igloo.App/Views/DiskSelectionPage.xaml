<UserControl
    x:Class="Igloo.App.Views.DiskSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Igloo.App.Converters">

    <UserControl.Resources>

        <!-- Card style for each disk row -->
        <Style x:Key="DiskItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Margin"                     Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                BorderThickness="2" CornerRadius="8" Padding="16,14"
                                BorderBrush="#E0E0E0" Background="White">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0078D4" />
                                <Setter TargetName="Root" Property="Background"  Value="#F0F7FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected"  Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BBBBBB" />
                                <Setter TargetName="Root" Property="Background"  Value="#FAFAFA" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <!-- Warning banner — always visible on this step -->
        <Border Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚠  The selected disk will be completely erased."
                           FontWeight="SemiBold" Foreground="#E65100" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75">
                    All partitions and data on the chosen disk will be destroyed during installation.
                    Make sure you have backed up anything important. This cannot be undone.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Disk list -->
        <ListBox ItemsSource="{Binding DiskItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource DiskItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>

                        <!-- Disk model + system-disk badge -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Disk.Model}"
                                       FontSize="15" FontWeight="SemiBold" />

                            <!-- "Windows" badge when this is the system disk -->
                            <Border Background="#E3F2FD" CornerRadius="4"
                                    Padding="6,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Windows" FontSize="11" Foreground="#1565C0" />
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemDisk}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>

                        <!-- Capacity + free + partition style -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Foreground="#555555">
                                <Run Text="{Binding Disk.TotalBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                <Run Text=" total" />
                            </TextBlock>
                            <TextBlock Text=" · " Foreground="#999" />
                            <TextBlock Foreground="#555555">
                                <Run Text="{Binding Disk.FreeBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                <Run Text=" free" />
                            </TextBlock>
                            <TextBlock Text=" · " Foreground="#999" />
                            <TextBlock Text="{Binding Disk.PartitionStyle}" Foreground="#555555" />
                        </StackPanel>

                        <!-- System-disk replacement warning -->
                        <Border Background="#FFF3E0" CornerRadius="4"
                                Padding="8,5" Margin="0,10,0,0">
                            <TextBlock Text="{Binding SystemDiskWarning}"
                                       Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemDisk}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- No disks found hint -->
        <TextBlock Opacity="0.5" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DiskItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            No suitable disks detected. A disk of at least 20 GB is required for Linux installation.
        </TextBlock>

    </StackPanel>

</UserControl>
