<UserControl
    x:Class="Igloo.App.Views.UsbWriterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ── Drive picker ─────────────────────────────────────────── -->
                <TextBlock Text="TARGET USB DRIVE" Style="{StaticResource Text.Section}" Margin="2,0,0,8" />
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Content="↺  Refresh"
                            Command="{Binding RefreshDrivesCommand}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnumerating}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ComboBox ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              MinHeight="38"
                              AutomationProperties.Name="USB drive to write the installer to">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Icon.Usb3D}"
                                           Width="22" Height="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Model, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <Run Text="  ·  " Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <Run Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}"
                                             Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <Run Text="  (Disk " Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <Run Text="{Binding DriveIndex, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <Run Text=")" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <!-- No drives hint -->
                <TextBlock Margin="2,0,0,14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Drives.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    No USB drives detected. Plug in a drive of 8 GB or larger and click Refresh.
                </TextBlock>

                <!-- ── Erase warning: gravity preserved ─────────────────────── -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card.Warning}">
                            <Setter Property="Margin" Value="0,0,0,18" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" FontSize="13">
                            ⚠  This will permanently erase the selected drive.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" Margin="0,6,0,0">
                            All data on the USB drive is destroyed. Double-check the model and size above,
                            and close any Explorer windows showing the drive before writing.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" Margin="0,6,0,0">
                            Minimum <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}">8 GB</Run>.
                            Writing requires iGloo to run as
                            <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}">Administrator</Run>.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── RUNNING: hero progress ───────────────────────────────── -->
                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Width="460" HorizontalAlignment="Center" Margin="0,12,0,0">

                    <TextBlock Text="{Binding PhaseDisplay}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />

                    <TextBlock HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}}"
                             FontSize="84" FontWeight="Light"
                             Foreground="{StaticResource Brush.Text.Primary}" />
                        <Run Text="%" FontSize="30" FontWeight="Light"
                             Foreground="{StaticResource Brush.Text.Tertiary}" />
                    </TextBlock>

                    <ProgressBar Margin="0,14,0,0"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                 Minimum="0" Maximum="100" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="{Binding BytesWritten, Converter={StaticResource BytesToSize}}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" />
                        <TextBlock Foreground="{StaticResource Brush.Text.Tertiary}" Margin="6,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="of" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- ── ERROR ─────────────────────────────────────────────────── -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource Card.Danger}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Write failed"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Text.Body}" Margin="0,8,0,0" />

                        <StackPanel Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}"
                                    Margin="0,12,0,0">
                            <TextBlock Text="Technical details  (select all → Ctrl+C to copy)"
                                       Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ErrorDetail, Mode=OneWay}"
                                     Style="{StaticResource TextBox.Detail}"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     MaxHeight="200"
                                     AcceptsReturn="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── COMPLETE: receipt ─────────────────────────────────────── -->
                <Border Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource Card}" Padding="26,22" Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource Brush.Success.Faint}"
                                    BorderBrush="{StaticResource Brush.Success}" BorderThickness="1.5">
                                <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="USB drive is ready"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drive" Style="{StaticResource Text.Caption}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDrive.Model}"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontWeight="SemiBold" FontSize="13" />
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Body}">
                            Boot from this USB drive to start the installation. The kickstart file on the
                            OEMDRV partition configures the installer automatically - no questions asked.
                        </TextBlock>

                        <Border Visibility="{Binding HasGrubPatchNote, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource Card.Success}" Padding="12,8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding GrubPatchNote}"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Success}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Bottom strip: Write (primary) / Cancel ───────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,16,0,0">

            <Button Content="Write to USB"
                    Command="{Binding WriteCommand}"
                    MinWidth="150"
                    AutomationProperties.Name="Erase the selected drive and write the installer">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center">
                <Button Content="Cancel"
                        Command="{Binding WriteCancelCommand}"
                        IsEnabled="{Binding IsCancelable}"
                        Style="{StaticResource Button.Ghost}" />
                <TextBlock Text="Partitioning - please wait, this cannot be interrupted."
                           HorizontalAlignment="Center" Margin="0,5,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
