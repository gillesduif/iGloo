<UserControl
    x:Class="Igloo.App.Views.IsoAcquisitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Igloo.App.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"    />  <!-- Running / complete / error -->
            <RowDefinition Height="Auto" />  <!-- Cancel button -->
        </Grid.RowDefinitions>

        <!-- ── RUNNING ──────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="420">

            <!-- Phase label -->
            <TextBlock Text="{Binding PhaseDisplay}"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Progress bar -->
            <ProgressBar Height="6"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Minimum="0" Maximum="100" />

            <!-- Bytes counter (only during download) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <TextBlock Text="{Binding BytesCompleted, Converter={StaticResource BytesToSize}}"
                           Opacity="0.7" />
                <TextBlock Opacity="0.4" Margin="4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"       Value=" / " />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}}"
                           Opacity="0.7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        </StackPanel>

        <!-- ── ERROR ────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                CornerRadius="6" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Download failed"
                           FontSize="16" FontWeight="SemiBold" Foreground="#B71C1C" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#B71C1C" />
            </StackPanel>
        </Border>

        <!-- ── COMPLETE ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"
                Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="✓  Installer ready"
                           FontSize="18" FontWeight="SemiBold" Foreground="#2E7D32"
                           Margin="0,0,0,16" />

                <!-- SHA-256 result -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="180" Text="SHA-256" Opacity="0.65" />
                    <TextBlock Foreground="#2E7D32" FontWeight="SemiBold"
                               Visibility="{Binding Result.Sha256Verified,
                                   Converter={StaticResource BoolToVis}}">
                        ✓ Verified
                    </TextBlock>
                    <TextBlock Foreground="#E65100" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="⚠ Not verified" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.Sha256Verified}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- GPG result -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="180" Text="GPG signature" Opacity="0.65" />
                    <TextBlock Foreground="#2E7D32" FontWeight="SemiBold"
                               Visibility="{Binding Result.GpgVerified,
                                   Converter={StaticResource BoolToVis}}">
                        ✓ Verified
                    </TextBlock>
                    <TextBlock Foreground="#888888">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="— Skipped" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.GpgVerified}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Local path -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock Width="180" Text="Saved to" Opacity="0.65" />
                    <TextBlock Text="{Binding Result.LocalPath}"
                               TextWrapping="Wrap" Opacity="0.8"
                               FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Cancel button (only while running) ───────────────────────────── -->
        <Button Grid.Row="1"
                Content="Cancel download"
                Command="{Binding AcquireCancelCommand}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                Padding="16,6" Margin="0,16,0,0" />

    </Grid>
</UserControl>
