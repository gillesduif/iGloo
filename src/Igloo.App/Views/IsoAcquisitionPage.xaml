<UserControl
    x:Class="Igloo.App.Views.IsoAcquisitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--   RUNNING: one fact matters - the hero number            -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="460">

            <!-- Phase icon with an orbiting verification ring: a faint full
                 track (Win11 progress-ring reference), a soft sweep and a bright
                 accent comet circling the static icon. Runs only while
                 IsRunning. Dash units are multiples of the 3px stroke:
                 circumference ≈ 96.3 units, so dash+gap always sum to that. -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20">

                <!-- Static track -->
                <Ellipse Margin="2" Stroke="#12FFFFFF" StrokeThickness="3" />

                <!-- Rotating layer: soft tail + bright comet -->
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ShieldOrbit">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0" To="360" Duration="0:0:2.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="ShieldOrbit" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Soft sweep trailing the comet (static -46° phase offset) -->
                    <Ellipse Margin="2" Stroke="#2E4CC2FF" StrokeThickness="3"
                             StrokeDashArray="34 62.3" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-46" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Bright comet head -->
                    <Ellipse Margin="2" Stroke="{StaticResource Brush.AccentW11}" StrokeThickness="3"
                             StrokeDashArray="20 76.3" StrokeDashCap="Round" />
                </Grid>

                <!-- The shield is reserved for the signature check; the other
                     phases carry their own subject. -->
                <Image Width="56" Height="56"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="/Assets/Fluent3D/disk.png" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Phase}" Value="ResolvingMirror">
                                    <Setter Property="Source" Value="/Assets/Fluent3D/search.png" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Phase}" Value="VerifyingSha256">
                                    <Setter Property="Source" Value="/Assets/Fluent3D/search.png" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Phase}" Value="VerifyingGpg">
                                    <Setter Property="Source" Value="/Assets/Fluent3D/shield.png" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>

            <TextBlock Text="{Binding PhaseDisplay}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent}"
                       HorizontalAlignment="Center" Margin="0,0,0,6" />

            <!-- Big percentage (hidden while indeterminate) -->
            <TextBlock HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}}"
                     FontSize="84" FontWeight="Light"
                     Foreground="{StaticResource Brush.Text.Primary}" />
                <Run Text="%" FontSize="30" FontWeight="Light"
                     Foreground="{StaticResource Brush.Text.Tertiary}" />
            </TextBlock>

            <ProgressBar Margin="0,14,0,0"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Minimum="0" Maximum="100" />

            <!-- Bytes line -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="{Binding BytesCompleted, Converter={StaticResource BytesToSize}}"
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" />
                <TextBlock Foreground="{StaticResource Brush.Text.Tertiary}" Margin="6,0" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="of" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}}"
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

      <TextBlock Text="The installation image is verified against the official SHA-256 checksum."
                       Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="#FF9A9CA1" />

        </StackPanel>

        <!--   ERROR                               -->
        <Border Grid.Row="0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource Card.Danger}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Download failed"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Danger}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!--   COMPLETE: hero logo above the verification receipt  the logo
             fills the vertical emptiness and answers "ready for WHAT?".    ─ -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">

            <Image Source="{Binding Distro.LogoAbsolutePath}"
                   MaxHeight="150" MaxWidth="460" Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Reflection, Cover Flow-style: the same art flipped, fading out
                 fast (same alpha ramp as the picker's baked reflection). The
                 clipping border shows only the first 64px of the mirror. -->
            <Border Height="104" ClipToBounds="True" Margin="0,3,0,20">
                <Image Source="{Binding Distro.LogoAbsolutePath}"
                       MaxHeight="150" MaxWidth="460" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleY="-1" />
                    </Image.RenderTransform>
                    <!-- Mask flips along with the content: offset 1 is the
                         visible top of the mirror; the fade runs two thirds of
                         the way down so the glare's length matches the logo. -->
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0"    Color="#00FFFFFF" />
                            <GradientStop Offset="0.32" Color="#00FFFFFF" />
                            <GradientStop Offset="1"    Color="#52FFFFFF" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Border>

            <Border Style="{StaticResource Card}" Padding="26,22" MinWidth="480">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource Brush.Success.Faint}"
                            BorderBrush="{StaticResource Brush.Success}" BorderThickness="1.5">
                        <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Installer ready"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <!-- SHA-256 -->
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SHA-256" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="✓ Verified" Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold" FontSize="13"
                                   Visibility="{Binding Result.Sha256Verified, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Foreground="{StaticResource Brush.Warning}" FontWeight="SemiBold" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⚠ Not verified" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.Sha256Verified}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- GPG -->
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPG signature" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="✓ Verified" Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold" FontSize="13"
                                   Visibility="{Binding Result.GpgVerified, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="- Skipped" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.GpgVerified}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Path -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved to" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Result.LocalPath}"
                               Style="{StaticResource Text.Mono}" />
                </Grid>
            </StackPanel>
            </Border>
        </StackPanel>

        <!--   Cancel (running only)                       -->
        <Button Grid.Row="1"
                Content="Cancel download"
                Command="{Binding AcquireCancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="#FF8A8A8A" />

    </Grid>
</UserControl>
