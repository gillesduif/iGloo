<UserControl
    x:Class="Igloo.App.Views.DirectInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Igloo.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DirectInstallDesignData, IsDesignTimeCreatable=True}"
    d:DesignWidth="900" d:DesignHeight="1100">

    <UserControl.Resources>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Scroll.ContentGutter}">

            <!--   RUNNING: preparing the installer partition          ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding PhaseDisplay}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}"
                           Margin="0,4,0,12" />

                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Margin="0,0,0,10" />

                <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding BytesWritten, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                    <Run Text=" of " Foreground="{StaticResource Brush.Text.Tertiary}" />
                    <Run Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                </TextBlock>

                <Border Style="{StaticResource Card.Accent}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="System Preparation"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" Foreground="#FFC4C7D1"><Run Text="The installation files are being prepared."/><Run Language="nl-be" Text="..."/></TextBlock>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!--   COMPLETE: the point of no return               ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Ready banner -->
                <Border Style="{StaticResource Card.Success}" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                       
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Setup complete"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="Restart your computer via the Reboot button to proceed to the Linux installer."
                                       Style="{StaticResource Text.Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border  Margin="0,0,0,18">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Assets/PNG/Tux.png"
                               Width="331" Height="297"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Ready to launch Linux."
                                   Style="{StaticResource Text.Body}"
                                   FontSize="16" Margin="16,20,0,0" Width="159" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0" MaxWidth="520"
                           HorizontalAlignment="Left">
                   Save all open documents before proceeding. Windows will restart approximately 10 seconds after clicking "Reboot".
                </TextBlock>
            </StackPanel>

            <!--   ERROR                              -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Card.Danger}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Preparation failed"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Expander Header="Technical details" IsExpanded="False"
                          Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding ErrorDetail, Mode=OneWay}"
                             Style="{StaticResource TextBox.Detail}"
                             TextWrapping="Wrap" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>

            <!--   LOGS: always available, for people who want the detail   -->
            <Expander Header="Logs" IsExpanded="{Binding LogsExpanded, Mode=TwoWay}"
                      Margin="0,4,0,0">
                <StackPanel>
                    <TextBox x:Name="LogBox" Text="{Binding LogTail, Mode=OneWay}"
                             Style="{StaticResource TextBox.Detail}"
                             FontFamily="Cascadia Mono, Consolas"
                             TextWrapping="NoWrap" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="LogBox_TextChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh" Style="{StaticResource Button.Ghost}"
                                Command="{Binding RefreshLogTailCommand}" />
                        <Button Content="Open log folder" Style="{StaticResource Button.Ghost}"
                                Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
