<UserControl
    x:Class="Igloo.App.Views.DirectInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <!-- ── Running / progress panel ─────────────────────────────────── -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="{Binding PhaseDisplay}" FontSize="14" Margin="0,0,0,12" />

            <ProgressBar Height="8" Margin="0,0,0,8"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />

            <!-- Byte counter (only during ISO copy) -->
            <TextBlock Opacity="0.6" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding BytesWritten, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                <Run Text=" / " />
                <Run Text="{Binding BytesTotal,   Converter={StaticResource BytesToSize}, Mode=OneWay}" />
            </TextBlock>

            <!-- Explainer card -->
            <Border Background="#F0F7FF" BorderBrush="#90CAF9" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">What's happening?</TextBlock>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12">
                        Igloo is carving a small temporary partition on your disk, copying the Fedora
                        installer image onto it, and configuring a bootloader.
                        No USB drive is needed. After this step you will click
                        <Bold>Reboot to Install</Bold> - Windows will restart directly into the Fedora
                        installer. Linux will be installed alongside Windows in the free space created
                        by shrinking the Windows partition.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ── Complete panel ───────────────────────────────────────────── -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Success banner -->
            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#2E7D32" FontSize="14">
                        Installer partition ready ✓
                    </TextBlock>
                    <TextBlock Foreground="#388E3C" TextWrapping="Wrap" Margin="0,4,0,0">
                        The Fedora KDE installer has been placed on a temporary partition.
                        Click <Bold>Reboot to Install</Bold> to restart Windows and launch
                        the installer automatically. Linux will be installed alongside Windows.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- What will happen info -->
            <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">What happens next</TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                        1. Windows restarts into the Fedora KDE installer (Anaconda).
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,0">
                        2. Anaconda installs Fedora in the free space alongside Windows. This takes 10–20 minutes.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,0">
                        3. After installation the system reboots into GRUB where you can choose Windows or Fedora.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,0">
                        4. On first boot into Fedora, the migration agent restores your files and settings.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,0">
                        5. The temporary installer partition is removed automatically.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Reboot button -->
            <Button Command="{Binding RebootToInstallCommand}"
                    IsEnabled="{Binding IsRebooting, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                    HorizontalAlignment="Left"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"
                    Background="#D32F2F" Foreground="White"
                    BorderBrush="#B71C1C">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#B71C1C" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding IsRebooting, Converter={StaticResource BoolToVis}}"
                               Visibility="Collapsed" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="↺  Reboot to Install" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRebooting}" Value="True">
                                        <Setter Property="Text" Value="Rebooting…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <TextBlock Margin="0,8,0,0" Opacity="0.55" FontSize="11" TextWrapping="Wrap">
                Save all open documents before rebooting. Windows will restart in 10 seconds after
                you click the button.
            </TextBlock>

        </StackPanel>

        <!-- ── Error panel ───────────────────────────────────────────────── -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#B71C1C">Preparation failed</TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Foreground="#C62828" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Technical detail (collapsible) -->
            <Expander Header="Technical details" IsExpanded="False"
                      Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}">
                <TextBox Text="{Binding ErrorDetail, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="10"
                         Background="#FAFAFA" BorderThickness="0"
                         Padding="8" MaxHeight="200"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Expander>

            <TextBlock Margin="0,12,0,0" Opacity="0.65" TextWrapping="Wrap" FontSize="12">
                Tip: make sure Igloo is running as Administrator, then try again.
                If a partial installer partition was created, remove it in
                Disk Management (diskmgmt.msc) first.
            </TextBlock>

        </StackPanel>

    </StackPanel>
</UserControl>
