<UserControl
    x:Class="Igloo.App.Views.DirectInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Chevron overlaying the slide edge; disabled at the ends of the run. -->
        <Style x:Key="SlideChevron" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="#66000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#99000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Scroll.ContentGutter}">

            <!--   RUNNING: preparing the installer partition          ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding PhaseDisplay}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}"
                           Margin="0,4,0,12" />

                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Margin="0,0,0,10" />

                <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding BytesWritten, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                    <Run Text=" of " Foreground="{StaticResource Brush.Text.Tertiary}" />
                    <Run Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                </TextBlock>

                <Border Style="{StaticResource Card.Accent}" Margin="0,18,0,0">
                    <StackPanel>
            <TextBlock Text="System Preparation"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" Foreground="#FFC4C7D1">
              iGloo creates a temporary partition and copies the installation image. Next it configures the bootloader. Windows will then restart into the Linux installer after clicking   <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}">Reboot</Run>.
            </TextBlock>
                       
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--   COMPLETE: the point of no return               ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Ready banner -->
                <Border Style="{StaticResource Card.Success}" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource Brush.Success.Faint}"
                                BorderBrush="{StaticResource Brush.Success}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Installer partition ready"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Success}" />
              <TextBlock Text="All components are ready. The system will restart directly into the Linux installer."
                                       Style="{StaticResource Text.Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The journey ahead: one slide per step, arrows or Left/Right -->
                <TextBlock Text="WHAT HAPPENS NEXT" Style="{StaticResource Text.Section}" Margin="2,0,0,4" />
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Fixed frame: the image scales into it, so the card never
                             changes height between slides of different proportions. -->
                        <!-- Viewbox, not a fixed height: the frame keeps the image's
                             proportions as the window resizes instead of cropping it. -->
                        <Grid Background="{StaticResource Brush.Surface}">
                            <Viewbox Stretch="Uniform" MaxHeight="360">
                                <Image x:Name="SlideImage" />
                            </Viewbox>
                            <Button x:Name="PrevSlide" Style="{StaticResource SlideChevron}" Content="&#xE76B;"
                                    HorizontalAlignment="Left"  Margin="10,0,0,0" Click="PrevSlide_Click"
                                    AutomationProperties.Name="Previous step" />
                            <Button x:Name="NextSlide" Style="{StaticResource SlideChevron}" Content="&#xE76C;"
                                    HorizontalAlignment="Right" Margin="0,0,10,0" Click="NextSlide_Click"
                                    AutomationProperties.Name="Next step" />
                        </Grid>
                        <TextBlock x:Name="SlideCaption" Style="{StaticResource Text.Body}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="16,14,16,16" />
                    </StackPanel>
                </Border>


                <!-- No action button here: rebooting is the wizard's last navigation
                     step, so it lives on the shared forward button in the nav bar. -->

                <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0" MaxWidth="520"
                           HorizontalAlignment="Left">
                   Save all open documents before proceeding. Windows will restart approximately 10 seconds after clicking "Reboot".
                </TextBlock>
            </StackPanel>

            <!--   ERROR                              -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Card.Danger}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Preparation failed"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

        <Expander Header="Technical details" IsExpanded="False"
                          Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}">
          <TextBox Text="{Binding ErrorDetail, Mode=OneWay}"
                             Style="{StaticResource TextBox.Detail}"
                             TextWrapping="Wrap" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" />
        </Expander>
      </StackPanel>

            <!--   LOGS: always available, for people who want the detail   -->
            <Expander Header="Show logs" IsExpanded="{Binding LogsExpanded, Mode=TwoWay}"
                      Margin="0,4,0,0">
                <StackPanel>
                    <TextBox Text="{Binding LogTail, Mode=OneWay}"
                             Style="{StaticResource TextBox.Detail}"
                             FontFamily="Cascadia Mono, Consolas"
                             TextWrapping="NoWrap" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh" Style="{StaticResource Button.Ghost}"
                                Command="{Binding RefreshLogTailCommand}" />
                        <Button Content="Open log folder" Style="{StaticResource Button.Ghost}"
                                Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
