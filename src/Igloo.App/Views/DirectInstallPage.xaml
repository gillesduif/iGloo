<UserControl
    x:Class="Igloo.App.Views.DirectInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Timeline node for the "what happens next" sequence -->
        <Style x:Key="TimelineNode" TargetType="Border">
            <Setter Property="Width"  Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background"  Value="{StaticResource Brush.Surface.High}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Deep}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TimelineText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Margin" Value="12,1,0,0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="TimelineRail" TargetType="Border">
            <Setter Property="Width" Value="1.5" />
            <Setter Property="Background" Value="#332C66C9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="MinHeight" Value="14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Scroll.ContentGutter}">

            <!--   RUNNING: preparing the installer partition          ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding PhaseDisplay}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}"
                           Margin="0,4,0,12" />

                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Margin="0,0,0,10" />

                <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding BytesWritten, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                    <Run Text=" of " Foreground="{StaticResource Brush.Text.Tertiary}" />
                    <Run Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                </TextBlock>

                <Border Style="{StaticResource Card.Accent}" Margin="0,18,0,0">
                    <StackPanel>
            <TextBlock Text="System Preparation"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" Foreground="#FFC4C7D1">
              iGloo creates a temporary partition and copies the installation image. Next it configures the bootloader. Windows will then restart into the Linux installer after clicking   <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}">Reboot</Run>.
            </TextBlock>
                       
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--   COMPLETE: the point of no return               ─ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Ready banner -->
                <Border Style="{StaticResource Card.Success}" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource Brush.Success.Faint}"
                                BorderBrush="{StaticResource Brush.Success}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Installer partition ready"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Success}" />
              <TextBlock Text="All components are ready. The system will restart directly into the Linux installer."
                                       Style="{StaticResource Text.Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The journey ahead: glowing timeline -->
                <TextBlock Text="WHAT HAPPENS NEXT" Style="{StaticResource Text.Section}" Margin="2,0,0,4" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TimelineNode}">
                            <TextBlock Text="1" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Bright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TimelineText}"
                                   Text="Windows restarts into the Linux installer." />
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TimelineRail}" />

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TimelineNode}">
                            <TextBlock Text="2" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Bright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TimelineText}"
                                   Text="Linux installs automatically into the allocated space alongside Windows (takes 10–20 minutes)." />
                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TimelineRail}" />

                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TimelineNode}">
                            <TextBlock Text="3" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Bright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TimelineText}"
                                   Text="The system restarts into a boot menu for operating system selection." />
                        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TimelineRail}" />

                        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TimelineNode}">
                            <TextBlock Text="4" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Bright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource TimelineText}"
                                   Text="The migration agent restores your folders, browser profiles and applications." />
                        <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource TimelineRail}" />

                        <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource TimelineNode}"
                                Effect="{StaticResource Effect.AccentGlow.Soft}">
                            <TextBlock Text="5" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Bright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource TimelineText}"
                                   Text="The temporary installation partition is automatically removed." />
                    </Grid>
                </Border>

                <!-- No action button here: rebooting is the wizard's last navigation
                     step, so it lives on the shared forward button in the nav bar. -->

                <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0" MaxWidth="520"
                           HorizontalAlignment="Left">
                   Save all open documents before proceeding. Windows will restart approximately 10 seconds after clicking "Reboot".
                </TextBlock>
            </StackPanel>

            <!--   ERROR                              -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Card.Danger}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Preparation failed"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Expander Header="Technical details" IsExpanded="False"
                          Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding ErrorDetail, Mode=OneWay}"
                             Style="{StaticResource TextBox.Detail}"
                             TextWrapping="Wrap" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" />
                </Expander>

                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Margin="0,12,0,0">
                    Tip: make sure iGloo is running as Administrator, then try again. If a partial
                    installer partition was created, remove it in Disk Management (diskmgmt.msc) first.
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
