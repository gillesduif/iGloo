<UserControl
    x:Class="Igloo.App.Views.DistroSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Igloo.App.Controls">

    <!-- The stage: deep dark gradient, near-black into deep blue, that the 3D
         carousel's depth fog dissolves into. -->
    <Border CornerRadius="14" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF02040A" Offset="0" />
                <GradientStop Color="#FF0B1330" Offset="0.62" />
                <GradientStop Color="#FF070B16" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 3D Cover Flow. Enter / clicking the centered cover proceeds via the
                 wizard's NextCommand, gated by the view-model's CanProceed. -->
            <controls:CoverFlow3DControl
                x:Name="CoverFlow"
                Grid.Row="0" Grid.RowSpan="2"
                ItemsSource="{Binding DistroItems}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                CanConfirm="{Binding CanProceed}"
                ConfirmCommand="{Binding DataContext.NextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Choose your Linux distribution" />

            <!-- 2D caption overlay: crisp text is never texture-mapped onto 3D planes. -->
            <StackPanel Grid.Row="1"
                        IsHitTestVisible="False"
                        Margin="48,0,48,18"
                        HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItem.Manifest.DisplayName}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#F2F5FF" />
                    <TextBlock Text="{Binding SelectedItem.Manifest.DefaultDesktopEnvironment}"
                               FontSize="14" Foreground="#7E8AAE"
                               Margin="12,0,0,3" VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Manifest.DefaultDesktopEnvironment}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- One-line description, ellipsized -->
                <TextBlock Text="{Binding SelectedItem.Manifest.Description}"
                           FontSize="13" Foreground="#9AA4C4"
                           Margin="0,6,0,0" MaxWidth="560"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center" />

                <!-- Incompatibility chip (replaces the confirm hint when shown) -->
                <Border Background="#33B71C1C" BorderBrush="#66E53935" BorderThickness="1"
                        CornerRadius="4" Padding="10,4" Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘  " Foreground="#FF8A80" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedItem.IncompatibilityReason}"
                                   Foreground="#FF8A80" FontSize="12" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem.IsCompatible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <TextBlock Text="←  →  browse   ·   Enter or click the cover to continue"
                           FontSize="11" Foreground="#55617F"
                           Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem.IsCompatible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>
