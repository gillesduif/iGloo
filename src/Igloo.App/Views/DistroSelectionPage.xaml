<UserControl
    x:Class="Igloo.App.Views.DistroSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Card style for each distro row in the ListBox -->
        <Style x:Key="DistroItemStyle" TargetType="ListBoxItem">
            <Setter Property="IsEnabled"                  Value="{Binding IsCompatible}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Margin"                     Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                BorderThickness="2" CornerRadius="8" Padding="16,14"
                                BorderBrush="#E0E0E0" Background="White">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0078D4" />
                                <Setter TargetName="Root" Property="Background"  Value="#F0F7FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected"  Value="False" />
                                    <Condition Property="IsEnabled"   Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BBBBBB" />
                                <Setter TargetName="Root" Property="Background"  Value="#FAFAFA" />
                            </MultiTrigger>
                            <!-- Greyed-out state for incompatible distros -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background"   Value="#F8F8F8" />
                                <Setter TargetName="Root" Property="BorderBrush"  Value="#E8E8E8" />
                                <Setter TargetName="Root" Property="Opacity"      Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ListBox ItemsSource="{Binding DistroItems}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             ItemContainerStyle="{StaticResource DistroItemStyle}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             BorderThickness="0"
             Background="Transparent">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel>

                    <!-- Name + desktop environment -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Manifest.DisplayName}"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Manifest.DefaultDesktopEnvironment}"
                                   Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Manifest.DefaultDesktopEnvironment}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Text="{Binding Manifest.Description}"
                               TextWrapping="Wrap" Opacity="0.8"
                               Margin="0,6,0,0" LineHeight="20" />

                    <!-- Tags row (only for compatible distros) -->
                    <ItemsControl ItemsSource="{Binding Manifest.Tags}" Margin="0,10,0,0"
                                  Visibility="{Binding IsCompatible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E8F5E9" CornerRadius="4"
                                        Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11" Foreground="#1B5E20" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Incompatibility reason chip (shown instead of tags) -->
                    <Border Background="#FFEBEE" CornerRadius="4"
                            Padding="8,3" Margin="0,10,0,0"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊘  " Foreground="#B71C1C"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IncompatibilityReason}"
                                       Foreground="#B71C1C" FontSize="12" />
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>
