<UserControl
    x:Class="Igloo.App.Views.FileStagingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--   RUNNING: hero number, same visual language as the download   ─ -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="460">

            <TextBlock Text="{Binding PhaseDisplay}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent}"
                       HorizontalAlignment="Center" Margin="0,0,0,6" />

            <TextBlock HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}}"
                     FontSize="84" FontWeight="Light"
                     Foreground="{StaticResource Brush.Text.Primary}" />
                <Run Text="%" FontSize="30" FontWeight="Light"
                     Foreground="{StaticResource Brush.Text.Tertiary}" />
            </TextBlock>

            <ProgressBar Margin="0,14,0,0"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Minimum="0" Maximum="100" />

            <!-- Bytes line -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="{Binding BytesCopied, Converter={StaticResource BytesToSize}}"
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" />
                <TextBlock Foreground="{StaticResource Brush.Text.Tertiary}" Margin="6,0" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="of" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}}"
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Current file in mono, quiet -->
            <TextBlock Text="{Binding CurrentFile}"
                       Style="{StaticResource Text.Mono}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,10,0,0" />

        </StackPanel>

        <!--   ERROR                               -->
        <Border Grid.Row="0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource Card.Danger}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Staging failed"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Danger}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!--   COMPLETE: the migration receipt                  -->
        <Border Grid.Row="0"
                Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource Card}" Padding="26,22"
                VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="480">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource Brush.Success.Faint}"
                            BorderBrush="{StaticResource Brush.Success}" BorderThickness="1.5">
                        <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Migration package ready"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Files staged" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Result.FileCount}"
                               Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="13" />
                </Grid>

                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total size" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Result.TotalBytesCopied, Converter={StaticResource BytesToSize}}"
                               Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="13" />
                </Grid>

                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Staging directory" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Result.StagingDirectory}"
                               Style="{StaticResource Text.Mono}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Installer config" Style="{StaticResource Text.Caption}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="✓ ks.cfg generated"
                               Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>

        <!--   Cancel (running only)                       -->
        <Button Grid.Row="1"
                Content="Cancel"
                Command="{Binding StageCancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="#FF8A8A8A" />

    </Grid>
</UserControl>
