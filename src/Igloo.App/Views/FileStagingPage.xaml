<UserControl
    x:Class="Igloo.App.Views.FileStagingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Igloo.App.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"    />  <!-- Running / complete / error -->
            <RowDefinition Height="Auto" />  <!-- Cancel button -->
        </Grid.RowDefinitions>

        <!-- ── RUNNING ──────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="420">

            <!-- Phase label -->
            <TextBlock Text="{Binding PhaseDisplay}"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Progress bar -->
            <ProgressBar Height="6"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Minimum="0" Maximum="100" />

            <!-- Bytes counter -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <TextBlock Text="{Binding BytesCopied, Converter={StaticResource BytesToSize}}"
                           Opacity="0.7" />
                <TextBlock Opacity="0.4" Margin="4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"       Value=" / " />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToSize}}"
                           Opacity="0.7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BytesTotal}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Current file (shown during copy phase) -->
            <TextBlock Text="{Binding CurrentFile}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Opacity="0.45" FontSize="11" FontFamily="Consolas"
                       Margin="0,8,0,0" />

        </StackPanel>

        <!-- ── ERROR ────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                CornerRadius="6" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Staging failed"
                           FontSize="16" FontWeight="SemiBold" Foreground="#B71C1C" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#B71C1C" />
            </StackPanel>
        </Border>

        <!-- ── COMPLETE ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"
                Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="✓  Migration package ready"
                           FontSize="18" FontWeight="SemiBold" Foreground="#2E7D32"
                           Margin="0,0,0,20" />

                <!-- File count -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="180" Text="Files staged" Opacity="0.65" />
                    <TextBlock Text="{Binding Result.FileCount}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <!-- Total size -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="180" Text="Total size" Opacity="0.65" />
                    <TextBlock Text="{Binding Result.TotalBytesCopied, Converter={StaticResource BytesToSize}}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <!-- Staging path -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="180" Text="Staging directory" Opacity="0.65" />
                    <TextBlock Text="{Binding Result.StagingDirectory}"
                               TextWrapping="Wrap" Opacity="0.8"
                               FontFamily="Consolas" FontSize="12" />
                </StackPanel>

                <!-- Installer config -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock Width="180" Text="Installer config" Opacity="0.65" />
                    <TextBlock Text="ks.cfg generated ✓"
                               Foreground="#2E7D32" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Cancel button (only while running) ───────────────────────────── -->
        <Button Grid.Row="1"
                Content="Cancel"
                Command="{Binding StageCancelCommand}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                Padding="16,6" Margin="0,16,0,0" />

    </Grid>
</UserControl>
