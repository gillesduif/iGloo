<UserControl
    x:Class="Igloo.App.Views.MigrationSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Igloo.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MigrationSetupDesignData, IsDesignTimeCreatable=True}"
    d:DesignWidth="900" d:DesignHeight="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Scroll.ContentGutter}">

            <!--   Linux account                        ─ -->
            <TextBlock Text="LINUX ACCOUNT" Style="{StaticResource Text.Section}" Margin="2,0,0,4" Foreground="White" />
            <Border Style="{StaticResource Card}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Centred against the three rows rather than pinned to a
                     corner: the picture belongs to the account as a whole.
                     It travels to Linux as the user's avatar. -->
                <Ellipse Grid.Column="0" Grid.RowSpan="3" Width="64" Height="64"
                         VerticalAlignment="Center" Margin="0,0,22,0"
                         Visibility="{Binding HasAccountPicture, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AccountPicturePath}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Linux username"
                           Style="{StaticResource Text.Caption}" FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <TextBox Text="{Binding LinuxUsername, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" />
                    <TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsUsernameValid, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Foreground="{StaticResource Brush.Danger}" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="Must start with a–z, then a–z / 0–9 / _ / -" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsernameValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="Password"
                           Style="{StaticResource Text.Caption}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,12,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <PasswordBox x:Name="PasswordBox"
                                 Width="220" PasswordChanged="OnPasswordChanged" />
                    <TextBlock Foreground="{StaticResource Brush.Danger}" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="At least 8 characters" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPasswordLengthError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="1" Text="Confirm password"
                           Style="{StaticResource Text.Caption}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,12,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <PasswordBox x:Name="PasswordConfirmBox"
                                 Width="220" PasswordChanged="OnPasswordChanged" />
                    <TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPasswordValid}" Value="True" />
                                            <Condition Binding="{Binding IsPasswordMatch}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource Brush.Danger}" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="Passwords do not match" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPasswordMismatch}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Border>

            <!--   Files to migrate: chip toggles                 -->
            <TextBlock Text="FILE TRANSFER" Style="{StaticResource Text.Section}" Margin="2,22,0,8" Foreground="White" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                               Style="{StaticResource Text.Body}" Margin="0,0,0,14" Text="Select the folders that need to be restored to their corresponding Linux directories." />
                    <WrapPanel>
                        <CheckBox Content="Documents" Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludeDocuments}" Margin="0,0,8,8" />
                        <CheckBox Content="Downloads" Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludeDownloads}" Margin="0,0,8,8" />
                        <CheckBox Content="Pictures"  Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludePictures}"  Margin="0,0,8,8" />
                        <CheckBox Content="Desktop"   Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludeDesktop}"   Margin="0,0,8,8" />
                        <CheckBox Content="Music"     Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludeMusic}"     Margin="0,0,8,8" />
                        <CheckBox Content="Videos"    Style="{StaticResource CheckBox.Chip}" IsChecked="{Binding IncludeVideos}"    Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--   Suggested Linux apps                      -->
            <StackPanel Visibility="{Binding HasDetectedSuggestions, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SUGGESTED LINUX APPS" Style="{StaticResource Text.Section}" Margin="2,22,0,8" Foreground="White" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
            <TextBlock Text="Select the detected Windows applications that you want to install on Linux."
                                   Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding DetectedSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,8">
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text           ="{Binding LinuxAppName}" FontWeight="Medium"
                                                           Foreground     ="{StaticResource Brush.Text.Primary}" />
                                                <TextBlock Foreground     ="{StaticResource Brush.Text.Tertiary}" Margin="6,0,0,0">
                                                    <Run Text="replaces " /><Run Text="{Binding WindowsDisplayName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--   Browser profiles                        -->
            <StackPanel Visibility="{Binding HasDetectedBrowsers, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="BROWSER PROFILES" Style="{StaticResource Text.Section}" Margin="2,22,0,8" Foreground="White" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Select the detected web browsers that you want to transfer to Linux."
                                   Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding DetectedBrowsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected}"
                                              Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--   System settings                       ─ -->
            <TextBlock Text="SYSTEM SETTINGS" Style="{StaticResource Text.Section}" Margin="2,22,0,8" Foreground="White" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Timezone"
                               Style="{StaticResource Text.Caption}" FontSize="12" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="2"
                             Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}"
                             Width="260" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" />

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Keyboard"
                               Style="{StaticResource Text.Caption}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="2"
                             Text="{Binding Keymap, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
