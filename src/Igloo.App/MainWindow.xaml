<Window
    x:Class="Igloo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iGloo"
    MinWidth="680" MinHeight="520"
    Width="800" Height="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header   -->
            <RowDefinition Height="*"    />  <!-- Content  -->
            <RowDefinition Height="Auto" />  <!-- Footer   -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <TextBlock Text="iGloo"
                       FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StepDescription}"
                       FontSize="13" Opacity="0.55" Margin="0,2,0,0" />
        </StackPanel>

        <!-- ── Content (wizard step fills this area) ────────────────────── -->
        <ContentControl Grid.Row="1"
                        Margin="32,16,32,0"
                        Content="{Binding CurrentPage}"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" />

        <!-- ── Footer navigation ────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="32,14,32,14">
                <!-- Back on the left -->
                <Button Content="← Back"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        HorizontalAlignment="Left"
                        Padding="16,6" />

                <!-- Quit + Next on the right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quit"
                            Command="{Binding QuitCommand}"
                            Padding="16,6" Margin="0,0,8,0" />
                    <Button Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Padding="16,6"
                            FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Next →" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                        <Setter Property="Content" Value="Finish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
