<Window
    x:Class="Igloo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iGloo"
    MinWidth="760" MinHeight="580"
    Width="930" Height="675"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="{StaticResource Brush.Window}"
    TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <!--
      WinUI-3-style shell: custom title bar (row 0), a left step rail naming
      every wizard step (Visual Studio Installer / Settings pattern), a content
      column, and a bottom command bar. WindowChrome keeps native drag, Aero
      Snap, double-click maximize and resize borders.
    -->
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness -1 = DWM sheet covers the whole client area, the
             prerequisite for the Mica backdrop to show through (set in code). -->
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="91*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"   />
            <!-- Title bar   -->
            <RowDefinition Height="*"    />
            <!-- Rail + page -->
            <RowDefinition Height="Auto" />
            <!-- Command bar -->
        </Grid.RowDefinitions>

        <!--   Title bar                             -->
        <Grid Grid.Row="0" Background="Transparent" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="iGloo"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}" />
                <Border Background="{StaticResource Brush.Layer.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Card}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ALPHA 0.2" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource Button.Caption}"
                        Content="&#xE921;"
                        Click="OnMinimizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize" />
                <Button x:Name="MaxRestoreButton"
                        Click="OnMaxRestoreClick"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                            <Setter Property="Content" Value="&#xE922;" />
                            <Setter Property="AutomationProperties.Name" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;" />
                                    <Setter Property="AutomationProperties.Name" Value="Restore down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource Button.Caption.Close}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <!--   Rail + content                         ─ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step rail: every step by name with done / current / upcoming
                 state. Answers "Where am I? What's done? What's next?" at a
                 glance. Not interactive  the wizard is linear by design. -->
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding StepMarkers}"
                          Margin="8,8,0,8"
                          IsTabStop="False"
                          AutomationProperties.Name="Installation steps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="36" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- WinUI selection pill for the current step -->
                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Margin="0,8"
                                    Background="{StaticResource Brush.AccentW11}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- State glyph: ✓ when done · the step's Fluent icon otherwise -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="14"
                                       FontFamily="Segoe MDL2 Assets">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Glyph}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentW11}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Subtle row fill for the current step -->
                            <Border Grid.ColumnSpan="3" CornerRadius="4" Panel.ZIndex="-1" Margin="4,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Layer.Card}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Content column: page title + page -->
            <Grid Grid.Column="1" Margin="24,4,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Collapsed (not Hidden) on Welcome, so the Auto row gives its
                     height back to the page instead of leaving a gap. -->
                <TextBlock Grid.Row="0"
                           Text="{Binding StepDescription}"
                           Visibility="{Binding ShowStepTitle, Converter={StaticResource BoolToVis}}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           Margin="0,4,0,12" />

                <ContentControl x:Name="StepHost"
                                Grid.Row="1"
                                Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Binding.TargetUpdated="OnStepChanged"
                                RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="StepTransform" />
                    </ContentControl.RenderTransform>
                </ContentControl>

            </Grid>
        </Grid>

        <!--   Command bar                            -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource Brush.Stroke.Card}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource Brush.Layer.Card}"
                Margin="0,12,0,0" Grid.ColumnSpan="2">
            <Grid Margin="24,12,28,14">
                <Button Content="←  Back"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        MinWidth="96"
                        HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- One forward button for the whole wizard: "Next", then "Finish"
                         or "Restart" on the last step depending on the install path. -->
                    <Button Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            MinWidth="120" Background="#0DFFFFFF" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <!-- Collapsed on every step but the restart one, so
                                 "Next  →" keeps its arrow trailing the word. -->
                            <TextBlock Text="{Binding PrimaryActionGlyph}"
                                       FontFamily="Segoe Fluent Icons" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="{Binding HasPrimaryActionGlyph,
                                                    Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PrimaryActionLabel}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
