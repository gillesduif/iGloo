<Window
    x:Class="Igloo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iGloo"
    MinWidth="720" MinHeight="560"
    Width="860" Height="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="{StaticResource Brush.Window}"
    TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <!--
      Custom chrome: the OS title bar is replaced by row 0 below, drawn directly on
      the window gradient (no separate bar color, no seam). WindowChrome keeps all
      native behaviors - drag, Aero Snap, double-click maximize, resize borders -
      without hand-rolled mouse handling. The 1px glass edge preserves the DWM
      shadow and Win11 rounded corners.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"   />  <!-- Title bar -->
            <RowDefinition Height="Auto" />  <!-- Header    -->
            <RowDefinition Height="*"    />  <!-- Content   -->
            <RowDefinition Height="Auto" />  <!-- Footer    -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand (same wordmark the header used to carry) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="iGloo"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Accent.Bright}" />
                <TextBlock Text="  LEAVE THE ICE AGE"
                           FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           VerticalAlignment="Center" Margin="2,2,0,0" />
            </StackPanel>

            <!-- Caption buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource Button.Caption}"
                        Content="&#xE921;"
                        Click="OnMinimizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize" />
                <Button x:Name="MaxRestoreButton"
                        Click="OnMaxRestoreClick"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                            <Setter Property="Content" Value="&#xE922;" />
                            <Setter Property="AutomationProperties.Name" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;" />
                                    <Setter Property="AutomationProperties.Name" Value="Restore down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource Button.Caption.Close}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <!-- ── Header: step title · step indicator ─────────────────────────── -->
        <Grid Grid.Row="1" Margin="36,12,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StepDescription}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Primary}" />

            <!-- Step indicator: dots with the current one glowing -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <TextBlock HorizontalAlignment="Right"
                           FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}">
                    <Run Text="Step " /><Run Text="{Binding StepNumber, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding StepCount, Mode=OneWay}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding StepMarkers}"
                              Margin="0,7,0,0" HorizontalAlignment="Right"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="20" Height="4" CornerRadius="2" Margin="3,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- future: hollow -->
                                        <Setter Property="Background" Value="#1C2440" />
                                        <Style.Triggers>
                                            <!-- done: dim accent -->
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Accent.Deep}" />
                                            </DataTrigger>
                                            <!-- current: bright + glow -->
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Accent.Bright}" />
                                                <Setter Property="Effect" Value="{StaticResource Effect.AccentGlow.Soft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ── Content (wizard step fills this area) ────────────────────────── -->
        <ContentControl x:Name="StepHost"
                        Grid.Row="2"
                        Margin="36,18,36,0"
                        Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Binding.TargetUpdated="OnStepChanged"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="StepTransform" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ── Footer navigation ────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource Brush.Surface.Border}"
                BorderThickness="0,1,0,0"
                Background="#660A0F1E"
                Margin="0,18,0,0">
            <Grid Margin="36,14,36,16">
                <!-- Back on the left -->
                <Button Content="←  Back"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left" />

                <!-- Quit + Next on the right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quit"
                            Command="{Binding QuitCommand}"
                            Style="{StaticResource Button.Ghost}"
                            Margin="0,0,10,0" />
                    <Button Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            MinWidth="120">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="Content" Value="Next  →" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                        <Setter Property="Content" Value="Finish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
