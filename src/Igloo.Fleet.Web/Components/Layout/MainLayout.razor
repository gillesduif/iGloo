@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<ShellStrings> L
@inject IFleetOperatorClient Client
@inject ConsoleShell Shell
@inject ConsoleSession Session
@inject ConsolePreferencesStore Preferences
@inject IJSRuntime JS

<FluentLayout GlobalScrollbar="true">
    <FluentLayoutItem Area="LayoutArea.Header" Sticky="true" Class="console-header-area">
        <ConsoleHeader />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Sticky="true" Width="@NavigationWidth" Class="console-nav-area">
        <ConsoleNav />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="console-content-area">
        <main id="main-content" tabindex="-1" class="console-main">
            @if (Client.IsSampleData)
            {
                <SampleDataBar />
            }
            @Body
        </main>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Class="console-footer-area">
        <footer class="console-footer">@L["FooterText"]</footer>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@code {
    private string NavigationWidth => Shell.NavigationCollapsed ? "0px" : "260px";

    protected override void OnInitialized() => Shell.Changed += OnShellChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var account = await Session.GetAccountAsync();
        await ConsoleTheme.ApplyAsync(JS, Preferences.Get(account.AccountId).Theme);
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnShellChanged;
}
