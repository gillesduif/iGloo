@inject IStringLocalizer<ShellStrings> L
@inject NavigationManager Navigation

<div id="console-navigation" class="console-nav">
    <FluentNav Width="100%" UseSingleExpanded="false" Density="NavDensity.Small" aria-label="@L["MainNavigation"]">
        <FluentNavItem Href="@ConsoleNavigation.Overview.Href" Match="NavLinkMatch.All" IconRest="@ConsoleNavigation.Overview.Icon!()">
            @L[ConsoleNavigation.Overview.Key]
        </FluentNavItem>

        @foreach (var section in ConsoleNavigation.Sections.Where(static s => s.Entries.Any(static e => e.Implemented)))
        {
            <FluentNavCategory Title="@L[section.Key]" IconRest="@section.Icon()" Expanded="@IsCurrent(section)">
                @foreach (var entry in section.Entries.Where(static e => e.Implemented))
                {
                    <FluentNavItem Href="@entry.Href" Match="entry.Match">@L[entry.Key]</FluentNavItem>
                }
            </FluentNavCategory>
        }

        @if (ConsoleNavigation.Audit.Implemented)
        {
            <FluentNavItem Href="@ConsoleNavigation.Audit.Href" IconRest="@ConsoleNavigation.Audit.Icon!()">
                @L[ConsoleNavigation.Audit.Key]
            </FluentNavItem>
        }

        @foreach (var group in ModuleCatalog.Groups)
        {
            if (group.Standalone)
            {
                <FluentNavItem Href="@(group.Pages[0].Href)" IconRest="@group.Icon()">@L[group.Key]</FluentNavItem>
            }
            else
            {
                <FluentNavCategory Title="@L[group.Key]" IconRest="@group.Icon()" Expanded="@IsCurrent(group)">
                    @foreach (var item in group.Pages)
                    {
                        <FluentNavItem Href="@(item.Href)">@L[item.Key]</FluentNavItem>
                    }
                </FluentNavCategory>
            }
        }
    </FluentNav>
</div>

@code {
    private string RelativePath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

    private bool IsCurrent(NavSection section) => ReferenceEquals(ConsoleNavigation.SectionFor(RelativePath), section);

    private bool IsCurrent(ModuleGroup group) => ReferenceEquals(ModuleCatalog.GroupFor(RelativePath), group);
}
