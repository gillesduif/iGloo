@inherits FluentDialogInstance
@inject IStringLocalizer<SharedStrings> S

<FluentDialogBody>
    <ChildContent>
        <p>@Message</p>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => DialogInstance.CloseAsync(true))">@(ConfirmLabel ?? S["Yes"].Value)</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => DialogInstance.CancelAsync())">@S["Cancel"]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? ConfirmLabel { get; set; }

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer) => header.Title = Title;

    protected override Task OnActionClickedAsync(bool primary) => Task.CompletedTask;
}
