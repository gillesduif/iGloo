@inject IStringLocalizer<ShellStrings> L

<nav aria-label="@L["Breadcrumb"]" class="console-breadcrumbs">
    <ol>
        @foreach (var item in Items)
        {
            <li>
                <a href="@item.Href">@item.Text</a>
                <FluentIcon Value="@(new Icons.Regular.Size12.ChevronRight())" Class="console-breadcrumb-separator" />
            </li>
        }
        <li aria-current="page">@Current</li>
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BreadcrumbItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public string Current { get; set; } = string.Empty;
}
