@inject IStringLocalizer<SharedStrings> S

@if (Value is null)
{
    <span class="text-secondary">@S["Never"]</span>
}
else
{
    <time datetime="@ConsoleFormat.Iso(Value.Value)">@ConsoleFormat.UtcDateTime(Value.Value)</time>
    @if (ShowRelative)
    {
        <span class="text-secondary datetime-relative">@ConsoleFormat.Relative(Value.Value, Now ?? DateTimeOffset.UtcNow, S)</span>
    }
}

@code {
    [Parameter]
    public DateTimeOffset? Value { get; set; }

    [Parameter]
    public bool ShowRelative { get; set; } = true;

    [Parameter]
    public DateTimeOffset? Now { get; set; }
}
