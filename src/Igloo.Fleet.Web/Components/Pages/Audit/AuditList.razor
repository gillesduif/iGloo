@page "/audit"
@implements IDisposable
@inject IStringLocalizer<AuditStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject ConsoleShell ConsoleShell

<PageFrame Title="@L["Title"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/")])">
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
        <FluentAnchorButton Href="/export/audit.csv" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Download="audit.csv">@S["ExportCsv"]</FluentAnchorButton>
    </SecondaryActions>
    <Filters>
        <FluentSelect TOption="string" TValue="string" Items="@ActorOptions" OptionText="@(o => ActorLabel(o))" OptionValue="@(o => o)" Label="@L["FilterActorType"]" @bind-Value="_actorFilter" Width="180px" />
        <FluentSelect TOption="string" TValue="string" Items="@_actionOptions" OptionText="@(o => ActionLabel(o))" OptionValue="@(o => o)" Label="@L["FilterAction"]" @bind-Value="_actionFilter" Width="260px" />
        @if (HasFilters)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilters">@S["ClearFilters"]</FluentButton>
        }
    </Filters>
    <ChildContent>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_events.Count == 0)
        {
            <EmptyState Title="@L["EmptyTitle"]" Message="@L["EmptyMessage"]" Icon="@(new Icons.Regular.Size24.DocumentBulletList())" />
        }
        else if (!Filtered.Any())
        {
            <NoResultsState OnClear="ClearFilters" />
        }
        else
        {
            <div class="grid-scroll">
            <FluentDataGrid Items="@Filtered" Pagination="@_pagination" RowSize="DataGridRowSize.Small" ResizableColumns="true" ItemKey="@(e => e.EventId)" TGridItem="FleetAuditEvent" aria-label="@L["Title"]">
                <TemplateColumn Title="@L["ColumnTime"]" SortBy="@(GridSort<FleetAuditEvent>.ByDescending(e => e.AtUtc))" Sortable="true" InitialSortDirection="DataGridSortDirection.Descending" IsDefaultSortColumn="true" Width="230px"><DateTimeText Value="context.AtUtc" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnActorType"]" SortBy="@(GridSort<FleetAuditEvent>.ByAscending(e => e.ActorType))" Sortable="true" Width="120px">@ActorLabel(context.ActorType)</TemplateColumn>
                <TemplateColumn Title="@L["ColumnActor"]" Width="200px"><code>@context.ActorId</code></TemplateColumn>
                <TemplateColumn Title="@L["ColumnAction"]" SortBy="@(GridSort<FleetAuditEvent>.ByAscending(e => e.Action))" Sortable="true" Width="240px"><span title="@context.Action">@ActionLabel(context.Action)</span></TemplateColumn>
                <TemplateColumn Title="@L["ColumnTarget"]" Width="160px"><IdentifierText Value="@context.TargetId.ToString("D")" Href="@TargetHref(context)" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnCorrelation"]" Width="160px"><IdentifierText Value="@context.CorrelationId.ToString("D")" /></TemplateColumn>
            </FluentDataGrid>
            </div>
            <div class="grid-footer"><FluentPaginator State="@_pagination" /></div>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] ActorOptions = ["any", "Operator", "Agent", "Server", "Enrollment"];
    private readonly PaginationState _pagination = new() { ItemsPerPage = 50 };
    private bool _loading = true;
    private OperatorFailure? _failure;
    private IReadOnlyList<FleetAuditEvent> _events = [];
    private string[] _actionOptions = ["any"];
    private string _actorFilter = "any";
    private string _actionFilter = "any";

    private bool HasFilters => _actorFilter != "any" || _actionFilter != "any" || ConsoleShell.Query.Length > 0;

    private IQueryable<FleetAuditEvent> Filtered => _events.Where(Matches).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        ConsoleShell.AttachSearch(L["SearchPlaceholder"]);
        ConsoleShell.Changed += OnShellChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetAuditAsync();
        if (result.Succeeded)
        {
            _events = result.Value!;
            _actionOptions = ["any", .. _events.Select(static e => e.Action).Distinct().Order(StringComparer.Ordinal)];
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }

    private bool Matches(FleetAuditEvent entry)
    {
        if (_actorFilter != "any" && entry.ActorType != _actorFilter) return false;
        if (_actionFilter != "any" && entry.Action != _actionFilter) return false;
        var query = ConsoleShell.Query.Trim();
        return query.Length == 0
            || entry.ActorId.Contains(query, StringComparison.OrdinalIgnoreCase)
            || entry.Action.Contains(query, StringComparison.OrdinalIgnoreCase)
            || ActionLabel(entry.Action).Contains(query, StringComparison.OrdinalIgnoreCase)
            || entry.TargetId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || entry.CorrelationId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string ActorLabel(string option)
    {
        if (option == "any") return L["FilterAny"];
        var label = Status[StatusCatalog.ActorTypeKey(option)];
        return label.ResourceNotFound ? option : label.Value;
    }

    private string ActionLabel(string action)
    {
        if (action == "any") return L["FilterAny"];
        var label = Status[StatusCatalog.ActionKey(action)];
        return label.ResourceNotFound ? action : label.Value;
    }

    // Target routes follow from the action; actions whose target has no page stay unlinked.
    private static string? TargetHref(FleetAuditEvent entry) => entry.Action switch
    {
        "DeviceEnrolled" => $"/enrollments/{entry.TargetId:D}",
        "EnrollmentTokenCreated" or "EnrollmentTokenRevoked" => "/enrollments/tokens",
        "MigrationProfileCreated" or "MigrationProfileRevised" => $"/planning/profiles/{entry.CorrelationId:D}",
        "AssessmentRequested" or "DryRunRequested" => $"/planning/work/{entry.TargetId:D}",
        "AssessmentReceived" or "DryRunCompleted" => $"/planning/evidence/{entry.TargetId:D}",
        "PlanApproved" or "ApprovalRevoked" or "ApprovalInvalidated" => $"/planning/approvals/{entry.TargetId:D}",
        "PreparedPlanCreated" or "PreparedPlanInvalidated" => $"/planning/plans/{entry.TargetId:D}",
        _ => null,
    };

    private void ClearFilters()
    {
        _actorFilter = "any";
        _actionFilter = "any";
        ConsoleShell.SetQuery(string.Empty);
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConsoleShell.Changed -= OnShellChanged;
        ConsoleShell.DetachSearch();
    }
}
