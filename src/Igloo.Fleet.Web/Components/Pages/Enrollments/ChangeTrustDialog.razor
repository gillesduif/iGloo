@inherits FluentDialogInstance
@inject IStringLocalizer<EnrollmentStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<StatusStrings> Status

<FluentDialogBody>
    <ChildContent>
        <FluentRadioGroup TValue="AgentTrustStatus" @bind-Value="_selected" Orientation="Orientation.Vertical" Label="@L["TrustCard"]">
            @foreach (var status in new[] { AgentTrustStatus.Active, AgentTrustStatus.Disabled, AgentTrustStatus.Revoked })
            {
                <FluentRadio Value="@status">
                    <strong>@Status["Trust_" + status]</strong> <span class="text-secondary">@Status["Trust_" + status + "_Meaning"]</span>
                </FluentRadio>
            }
        </FluentRadioGroup>
        @if (_selected == AgentTrustStatus.Revoked)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false" AriaLive="AriaLive.Polite" Class="dialog-warning">@L["ChangeTrustRevokedWarning"]</FluentMessageBar>
            <FluentCheckbox Label="@L["ChangeTrustConfirmRevoke"]" @bind-Value="_confirmed" />
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanApply)" OnClick="@(() => DialogInstance.CloseAsync(_selected))">@L["ChangeTrustApply"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => DialogInstance.CancelAsync())">@S["Cancel"]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    private AgentTrustStatus _selected;
    private bool _confirmed;

    [Parameter]
    public AgentTrustStatus Current { get; set; }

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        _selected = Current;
        header.Title = L["ChangeTrust"];
    }

    protected override Task OnActionClickedAsync(bool primary) => Task.CompletedTask;

    private bool CanApply => _selected != Current && (_selected != AgentTrustStatus.Revoked || _confirmed);
}
