@page "/enrollments/tokens"
@implements IDisposable
@inject IStringLocalizer<EnrollmentStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject IDialogService Dialogs
@inject ConsoleShell ConsoleShell
@inject ConsoleAuditLog ConsoleAudit
@inject NavigationManager Navigation

<PageFrame Title="@L["TokensTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(L["ListTitle"], "/enrollments")])">
    <PrimaryActions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Key())" OnClick="CreateAsync">@L["TokenCreate"]</FluentButton>
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
        <FluentAnchorButton Href="/export/enrollment-tokens.csv" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Download="enrollment-tokens.csv">@S["ExportCsv"]</FluentAnchorButton>
    </SecondaryActions>
    <Filters>
        <FluentSelect TOption="string" TValue="string" Items="@StateOptions" OptionText="@(o => StateLabel(o))" OptionValue="@(o => o)" Label="@L["TokenFilterState"]" @bind-Value="_stateFilter" Width="180px" />
        @if (HasFilters)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilters">@S["ClearFilters"]</FluentButton>
        }
    </Filters>
    <ChildContent>
        @if (_message is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="true" Class="page-message">@_message</FluentMessageBar>
        }
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_tokens.Count == 0)
        {
            <EmptyState Title="@L["TokensEmptyTitle"]" Message="@L["TokensEmptyMessage"]" Icon="@(new Icons.Regular.Size24.Key())">
                <Action><FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateAsync">@L["TokenCreate"]</FluentButton></Action>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <NoResultsState OnClear="ClearFilters" />
        }
        else
        {
            <div class="grid-scroll">
            <FluentDataGrid Items="@Filtered" Pagination="@_pagination" RowSize="DataGridRowSize.Small" ResizableColumns="true" ItemKey="@(t => t.TokenId)" TGridItem="EnrollmentTokenInfo" aria-label="@L["TokensTitle"]">
                <TemplateColumn Title="@L["TokenColumnId"]" SortBy="@(GridSort<EnrollmentTokenInfo>.ByAscending(t => t.TokenId))" Sortable="true" Width="160px">
                    <IdentifierText Value="@context.TokenId.ToString("D")" />
                </TemplateColumn>
                <TemplateColumn Title="@L["TokenColumnState"]" Width="140px">
                    <StatusBadge Presentation="StatusCatalog.Token(context, _now)" />
                </TemplateColumn>
                <TemplateColumn Title="@L["TokenColumnCreated"]" SortBy="@(GridSort<EnrollmentTokenInfo>.ByDescending(t => t.CreatedAtUtc))" Sortable="true" InitialSortDirection="DataGridSortDirection.Descending" IsDefaultSortColumn="true" Width="240px">
                    <DateTimeText Value="context.CreatedAtUtc" />
                </TemplateColumn>
                <TemplateColumn Title="@L["TokenColumnExpires"]" SortBy="@(GridSort<EnrollmentTokenInfo>.ByAscending(t => t.ExpiresAtUtc))" Sortable="true" Width="240px">
                    <DateTimeText Value="context.ExpiresAtUtc" />
                </TemplateColumn>
                <TemplateColumn Title="@L["TokenColumnCreatedBy"]" Width="220px">
                    <code>@context.CreatedBy</code>
                    @if (ConsoleAccountFor(context.TokenId) is { } account)
                    {
                        <span class="text-secondary"> @L["TokenFromConsoleAccount", account]</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@S["Actions"]" Width="120px" Align="DataGridCellAlignment.End">
                    @if (StatusCatalog.TokenIsAvailable(context, _now))
                    {
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" OnClick="@(() => RevokeAsync(context))">@L["TokenRevoke"]</FluentButton>
                    }
                </TemplateColumn>
            </FluentDataGrid>
            </div>
            <div class="grid-footer">
                <FluentPaginator State="@_pagination" />
            </div>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] StateOptions = ["any", "available", "used", "revoked", "expired"];
    private readonly PaginationState _pagination = new() { ItemsPerPage = 25 };
    private bool _loading = true;
    private bool _createHandled;
    private OperatorFailure? _failure;
    private string? _message;
    private IReadOnlyList<EnrollmentTokenInfo> _tokens = [];
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private string _stateFilter = "any";

    [SupplyParameterFromQuery(Name = "create")]
    private string? CreateQuery { get; set; }

    private bool HasFilters => _stateFilter != "any" || ConsoleShell.Query.Length > 0;

    private IQueryable<EnrollmentTokenInfo> Filtered => _tokens.Where(Matches).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        ConsoleShell.AttachSearch(L["TokenSearchPlaceholder"]);
        ConsoleShell.Changed += OnShellChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_createHandled && CreateQuery == "1")
        {
            _createHandled = true;
            await CreateAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetEnrollmentTokensAsync();
        _now = DateTimeOffset.UtcNow;
        if (result.Succeeded)
        {
            _tokens = result.Value!;
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }

    private bool Matches(EnrollmentTokenInfo token)
    {
        var state = token.Consumed ? "used" : token.Revoked ? "revoked" : token.ExpiresAtUtc <= _now ? "expired" : "available";
        if (_stateFilter != "any" && state != _stateFilter) return false;
        var query = ConsoleShell.Query.Trim();
        return query.Length == 0 || token.TokenId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string StateLabel(string option) => option switch
    {
        "available" => Status["Token_Available"],
        "used" => Status["Token_Used"],
        "revoked" => Status["Token_Revoked"],
        "expired" => Status["Token_Expired"],
        _ => L["FilterAny"],
    };

    private void ClearFilters()
    {
        _stateFilter = "any";
        ConsoleShell.SetQuery(string.Empty);
    }

    private string? ConsoleAccountFor(Guid tokenId) => ConsoleAudit.FindByTarget(tokenId.ToString("D"))?.Account;

    private async Task CreateAsync()
    {
        var result = await Dialogs.ShowDialogAsync<CreateTokenDialog>(options =>
        {
            options.Modal = true;
            options.PreventDismissOnEscape = true;
        });

        if (!result.Cancelled)
        {
            await LoadAsync();
        }

        if (CreateQuery == "1")
        {
            Navigation.NavigateTo("/enrollments/tokens", replace: true);
        }
    }

    private async Task RevokeAsync(EnrollmentTokenInfo token)
    {
        var confirm = await Dialogs.ShowDialogAsync<ConfirmDialog>(options =>
        {
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDialog.Title), L["TokenRevokeTitle"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.Message), L["TokenRevokeMessage"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.ConfirmLabel), L["TokenRevoke"].Value);
        });

        if (confirm.Cancelled)
        {
            return;
        }

        var result = await Client.RevokeEnrollmentTokenAsync(token.TokenId);
        if (result.Succeeded)
        {
            _message = L["TokenRevoked"];
            await LoadAsync();
        }
        else
        {
            _failure = result.Failure;
        }
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConsoleShell.Changed -= OnShellChanged;
        ConsoleShell.DetachSearch();
    }
}
