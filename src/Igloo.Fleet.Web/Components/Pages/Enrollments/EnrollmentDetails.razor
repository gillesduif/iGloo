@page "/enrollments/{DeviceId:guid}"
@page "/enrollments/{DeviceId:guid}/{Tab}"
@inject IStringLocalizer<EnrollmentStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<ConsoleOptions> Options

<PageFrame Title="@(_device is null ? L["DetailTitle"] : ConsoleFormat.ShortId(_device.Identity.DeviceId))"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(L["ListTitle"], "/enrollments")])">
    <HeaderEnd>
        @if (_device is not null)
        {
            <StatusBadge Presentation="StatusCatalog.Trust(_device.Status)" />
        }
    </HeaderEnd>
    <PrimaryActions>
        @if (_device is not null && _device.Status != AgentTrustStatus.Revoked)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.ShieldCheckmark())" OnClick="ChangeTrustAsync">@L["ChangeTrust"]</FluentButton>
        }
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
    </SecondaryActions>
    <ChildContent>
        @if (_message is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="true" Class="page-message">@_message</FluentMessageBar>
        }
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_device is null)
        {
            <EmptyState Title="@L["NotFoundTitle"]" Message="@S["RecordNotFoundMessage"]" Icon="@(new Icons.Regular.Size24.Certificate())">
                <Action><FluentAnchorButton Href="/enrollments" Appearance="ButtonAppearance.Outline">@L["ListTitle"]</FluentAnchorButton></Action>
            </EmptyState>
        }
        else
        {
            <FluentTabs ActiveTabId="@ActiveTab" ActiveTabIdChanged="OnTabChanged" Size="TabsSize.Medium">
                <FluentTab Id="overview" Header="@L["TabOverview"]">
                    <div class="panel-grid panel-grid-3">
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@L["IdentityCard"]</h2>
                            <dl class="property-list">
                                <dt>@L["EnrollmentId"]</dt><dd><IdentifierText Value="@_device.Identity.DeviceId.ToString("D")" Short="false" /></dd>
                                <dt>@L["AgentId"]</dt><dd><IdentifierText Value="@_device.Identity.AgentId.ToString("D")" Short="false" /></dd>
                                <dt>@L["ServerEnrollmentId"]</dt><dd><IdentifierText Value="@_device.EnrollmentId.ToString("D")" Short="false" /></dd>
                            </dl>
                        </FluentCard>
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@L["ContactCard"]</h2>
                            <p><DateTimeText Value="_device.LastHeartbeatUtc" /></p>
                            <h3 class="panel-subtitle">@L["CapabilitiesCard"]</h3>
                            @if (_device.Heartbeat is null || _device.Heartbeat.Capabilities.IsDefaultOrEmpty)
                            {
                                <p class="text-secondary">@L["NoCapabilities"]</p>
                            }
                            else
                            {
                                <ul class="capability-list">
                                    @foreach (var capability in _device.Heartbeat.Capabilities)
                                    {
                                        <li><strong>@Status[StatusCatalog.CapabilityKey(capability)]</strong> <span class="text-secondary">@Status[StatusCatalog.CapabilityMeaningKey(capability)]</span></li>
                                    }
                                </ul>
                            }
                        </FluentCard>
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@L["RelatedCard"]</h2>
                            <ul class="related-list">
                                <li><a href="@TabHref("evidence")">@L["RelatedEvidence", _evidence.Count]</a></li>
                                <li><a href="@TabHref("work")">@L["RelatedWork", _work.Count]</a></li>
                                <li><a href="@TabHref("plans")">@L["RelatedApprovals", _approvals.Count]</a></li>
                                <li><a href="@TabHref("plans")">@L["RelatedPlans", _plans.Count]</a></li>
                            </ul>
                        </FluentCard>
                    </div>
                </FluentTab>

                <FluentTab Id="trust" Header="@L["TabTrust"]">
                    <div class="panel-grid">
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@L["TrustCard"]</h2>
                            <p><StatusBadge Presentation="StatusCatalog.Trust(_device.Status)" /> <span class="text-secondary">@Status["Trust_" + _device.Status + "_Meaning"]</span></p>
                            @if (_device.Status == AgentTrustStatus.Revoked)
                            {
                                <p class="text-secondary">@L["ChangeTrustAlreadyRevoked"]</p>
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="ChangeTrustAsync">@L["ChangeTrust"]</FluentButton>
                            }
                        </FluentCard>
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@L["CertificateCard"]</h2>
                            <dl class="property-list">
                                <dt>@L["ColumnCertificate"]</dt><dd><StatusBadge Presentation="StatusCatalog.Certificate(_device.CertificateExpiresAtUtc, _now, Options.Value.CertificateExpiryWarningDays)" /></dd>
                                <dt>@L["CertificateExpires"]</dt><dd><DateTimeText Value="_device.CertificateExpiresAtUtc" /></dd>
                                <dt>@L["CertificateHash"]</dt><dd><IdentifierText Value="@_device.CertificateHash" Short="false" /></dd>
                            </dl>
                        </FluentCard>
                    </div>
                </FluentTab>

                <FluentTab Id="agent" Header="@L["TabAgent"]">
                    <FluentCard Class="panel">
                        <h2 class="panel-title">@L["AgentCard"]</h2>
                        <dl class="property-list">
                            <dt>@L["AgentVersion"]</dt><dd>@(_device.Heartbeat?.AgentVersion ?? S["NotReported"])</dd>
                            <dt>@L["IglooVersion"]</dt><dd>@(_device.Heartbeat?.IglooVersion ?? S["NotReported"])</dd>
                            <dt>@L["Protocol"]</dt><dd>@(_device.Heartbeat is { } h ? $"{h.Protocol.Major}.{h.Protocol.Minor}" : S["NotReported"])</dd>
                        </dl>
                    </FluentCard>
                </FluentTab>

                <FluentTab Id="evidence" Header="@L["TabEvidence"]">
                    @if (_evidence.Count == 0)
                    {
                        <EmptyState Title="@Shell["Evidence"]" Message="@S["None"]" />
                    }
                    else
                    {
                        <table class="data-table">
                            <thead><tr><th scope="col">@Shell["WorkItems"]</th><th scope="col">@Status["WorkType_RunAssessment"] / @Status["WorkType_RunMigrationDryRun"]</th><th scope="col">@Status["Eligibility_Eligible"]</th><th scope="col">@L["ColumnLastContact"]</th></tr></thead>
                            <tbody>
                                @foreach (var evidence in _evidence.OrderByDescending(static e => e.ReceivedAtUtc))
                                {
                                    <tr>
                                        <td><IdentifierText Value="@evidence.DryRunId.ToString("D")" /></td>
                                        <td>@Status[StatusCatalog.WorkTypeKey(evidence.Result.Planning is null ? ReadOnlyWorkType.RunAssessment : ReadOnlyWorkType.RunMigrationDryRun)]</td>
                                        <td>
                                            @if (evidence.Result.Planning is null)
                                            {
                                                <StatusBadge Presentation="StatusCatalog.Assessment(evidence.Result.Assessment.Eligibility)" />
                                            }
                                            else
                                            {
                                                <StatusBadge Presentation="StatusCatalog.Eligibility(evidence.Decision.Status)" />
                                            }
                                        </td>
                                        <td><DateTimeText Value="evidence.ReceivedAtUtc" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </FluentTab>

                <FluentTab Id="work" Header="@L["TabWork"]">
                    @if (_work.Count == 0)
                    {
                        <EmptyState Title="@Shell["WorkItems"]" Message="@S["None"]" />
                    }
                    else
                    {
                        <table class="data-table">
                            <thead><tr><th scope="col">@Shell["WorkItems"]</th><th scope="col">@Status["WorkType_RunAssessment"] / @Status["WorkType_RunMigrationDryRun"]</th><th scope="col">@L["ColumnTrustStatus"]</th><th scope="col">@L["TokenColumnCreated"]</th><th scope="col">@L["TokenColumnExpires"]</th></tr></thead>
                            <tbody>
                                @foreach (var work in _work.OrderByDescending(static w => w.CreatedAtUtc))
                                {
                                    <tr>
                                        <td><IdentifierText Value="@work.WorkItemId.ToString("D")" /></td>
                                        <td>@Status[StatusCatalog.WorkTypeKey(work.Type)]</td>
                                        <td><StatusBadge Presentation="StatusCatalog.Work(work.Status)" /></td>
                                        <td><DateTimeText Value="work.CreatedAtUtc" /></td>
                                        <td><DateTimeText Value="work.ExpiresAtUtc" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </FluentTab>

                <FluentTab Id="plans" Header="@L["TabPlans"]">
                    <div class="panel-grid">
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@Shell["Approvals"]</h2>
                            @if (_approvals.Count == 0)
                            {
                                <p class="text-secondary">@S["None"]</p>
                            }
                            else
                            {
                                <table class="data-table">
                                    <thead><tr><th scope="col">@Shell["Approvals"]</th><th scope="col">@L["ColumnTrustStatus"]</th><th scope="col">@L["TokenColumnCreated"]</th><th scope="col">@L["TokenColumnExpires"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var approval in _approvals.OrderByDescending(static a => a.ApprovedAtUtc))
                                        {
                                            <tr>
                                                <td><IdentifierText Value="@approval.ApprovalId.ToString("D")" /></td>
                                                <td><StatusBadge Presentation="StatusCatalog.Approval(approval.Status)" /></td>
                                                <td><DateTimeText Value="approval.ApprovedAtUtc" /></td>
                                                <td><DateTimeText Value="approval.ExpiresAtUtc" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </FluentCard>
                        <FluentCard Class="panel">
                            <h2 class="panel-title">@Shell["PreparedPlans"]</h2>
                            @if (_plans.Count == 0)
                            {
                                <p class="text-secondary">@S["None"]</p>
                            }
                            else
                            {
                                <table class="data-table">
                                    <thead><tr><th scope="col">@Shell["PreparedPlans"]</th><th scope="col">@L["ColumnTrustStatus"]</th><th scope="col">@L["TokenColumnCreated"]</th><th scope="col">@L["TokenColumnExpires"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var plan in _plans.OrderByDescending(static p => p.CreatedAtUtc))
                                        {
                                            <tr>
                                                <td><IdentifierText Value="@plan.PlanId.ToString("D")" /></td>
                                                <td><StatusBadge Presentation="StatusCatalog.Plan(plan.Status)" /></td>
                                                <td><DateTimeText Value="plan.CreatedAtUtc" /></td>
                                                <td><DateTimeText Value="plan.ExpiresAtUtc" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="text-secondary">@_plans[0].SafetyBoundary</p>
                            }
                        </FluentCard>
                    </div>
                </FluentTab>

                <FluentTab Id="audit" Header="@L["TabAudit"]">
                    @if (_audit.Count == 0)
                    {
                        <EmptyState Title="@Shell["AuditEvents"]" Message="@S["None"]" />
                    }
                    else
                    {
                        <table class="data-table">
                            <thead><tr><th scope="col">@L["TokenColumnCreated"]</th><th scope="col">@Status["Actor_Operator"] / @Status["Actor_Agent"] / @Status["Actor_Server"]</th><th scope="col">@Shell["AuditEvents"]</th><th scope="col">@L["ColumnEnrollmentId"]</th></tr></thead>
                            <tbody>
                                @foreach (var entry in _audit.OrderByDescending(static a => a.AtUtc))
                                {
                                    <tr>
                                        <td><DateTimeText Value="entry.AtUtc" /></td>
                                        <td>@Status[StatusCatalog.ActorTypeKey(entry.ActorType)] <code class="text-secondary">@entry.ActorId</code></td>
                                        <td>@ActionLabel(entry.Action)</td>
                                        <td><IdentifierText Value="@entry.TargetId.ToString("D")" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </FluentTab>
            </FluentTabs>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] Tabs = ["overview", "trust", "agent", "evidence", "work", "plans", "audit"];

    private bool _loading = true;
    private OperatorFailure? _failure;
    private string? _message;
    private TrustedDeviceView? _device;
    private IReadOnlyList<DryRunEvidence> _evidence = [];
    private IReadOnlyList<ReadOnlyWorkItem> _work = [];
    private IReadOnlyList<PlanApproval> _approvals = [];
    private IReadOnlyList<PreparedMigrationPlan> _plans = [];
    private IReadOnlyList<FleetAuditEvent> _audit = [];
    private DateTimeOffset _now = DateTimeOffset.UtcNow;

    [Parameter]
    public Guid DeviceId { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    private string ActiveTab => Tabs.Contains(Tab) ? Tab! : "overview";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var enrollments = Client.GetEnrollmentsAsync();
        var evidence = Client.GetEvidenceAsync();
        var work = Client.GetWorkItemsAsync();
        var approvals = Client.GetApprovalsAsync();
        var plans = Client.GetPlansAsync();
        var audit = Client.GetAuditAsync();
        await Task.WhenAll(enrollments, evidence, work, approvals, plans, audit);
        _now = DateTimeOffset.UtcNow;

        _failure = new[] { enrollments.Result.Failure, evidence.Result.Failure, work.Result.Failure, approvals.Result.Failure, plans.Result.Failure, audit.Result.Failure }
            .FirstOrDefault(static f => f is not null);
        if (_failure is null)
        {
            _device = enrollments.Result.Value!.SingleOrDefault(d => d.Identity.DeviceId == DeviceId);
            _evidence = evidence.Result.Value!.Where(e => e.Result.Assessment.Identity.DeviceId == DeviceId).ToArray();
            _work = work.Result.Value!.Where(w => w.Identity.DeviceId == DeviceId).ToArray();
            _approvals = approvals.Result.Value!.Where(a => a.Identity.DeviceId == DeviceId).ToArray();
            _plans = plans.Result.Value!.Where(p => p.Identity.DeviceId == DeviceId).ToArray();
            var correlations = _work.Select(static w => w.CorrelationId).ToHashSet();
            _audit = audit.Result.Value!.Where(a => a.TargetId == DeviceId || correlations.Contains(a.CorrelationId)).ToArray();
        }

        _loading = false;
    }

    private string TabHref(string tab) => $"/enrollments/{DeviceId:D}/{tab}";

    private void OnTabChanged(string? tab)
    {
        if (tab is not null && tab != ActiveTab)
        {
            Navigation.NavigateTo(TabHref(tab));
        }
    }

    private async Task ChangeTrustAsync()
    {
        if (_device is null)
        {
            return;
        }

        var result = await Dialogs.ShowDialogAsync<ChangeTrustDialog>(options =>
        {
            options.Modal = true;
            options.Parameters.Add(nameof(ChangeTrustDialog.Current), _device.Status);
        });

        if (result.Cancelled || result.Value is not AgentTrustStatus status)
        {
            return;
        }

        var change = await Client.ChangeTrustAsync(DeviceId, status);
        if (change.Succeeded)
        {
            _message = L["TrustChanged", Status["Trust_" + status].Value];
            await LoadAsync();
        }
        else
        {
            _failure = change.Failure;
        }
    }

    private string ActionLabel(string action)
    {
        var label = Status[StatusCatalog.ActionKey(action)];
        return label.ResourceNotFound ? action : label.Value;
    }
}
