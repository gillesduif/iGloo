@page "/enrollments"
@implements IDisposable
@inject IStringLocalizer<EnrollmentStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject ConsoleShell ConsoleShell
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<ConsoleOptions> Options

<PageFrame Title="@L["ListTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/")])">
    <PrimaryActions>
        <FluentAnchorButton Href="/enrollments/tokens?create=1" Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Key())">@L["CreateToken"]</FluentAnchorButton>
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
        <FluentAnchorButton Href="/export/enrollments.csv" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Download="enrollments.csv">@S["ExportCsv"]</FluentAnchorButton>
        <FluentButton Id="enrollment-columns-button" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.Settings())" aria-haspopup="dialog" aria-expanded="@_columnsOpen" OnClick="@(() => _columnsOpen = !_columnsOpen)">@S["Columns"]</FluentButton>
        <FluentPopover AnchorId="enrollment-columns-button" @bind-Opened="_columnsOpen" Width="260px">
            <div class="column-chooser" role="group" aria-label="@S["Columns"]">
                @foreach (var column in _optionalColumns)
                {
                    <FluentCheckbox Label="@L[column.Key]" Value="@column.Visible" ValueChanged="@(value => column.Visible = value)" />
                }
            </div>
        </FluentPopover>
    </SecondaryActions>
    <Filters>
        <FluentSelect TOption="string" TValue="string" Items="@TrustOptions" OptionText="@(o => TrustLabel(o))" OptionValue="@(o => o)" Label="@L["FilterTrust"]" @bind-Value="_trustFilter" Width="180px" />
        <FluentSelect TOption="string" TValue="string" Items="@ContactOptions" OptionText="@(o => ContactLabel(o))" OptionValue="@(o => o)" Label="@L["FilterContact"]" @bind-Value="_contactFilter" Width="220px" />
        <FluentSelect TOption="string" TValue="string" Items="@CertificateOptions" OptionText="@(o => CertificateLabel(o))" OptionValue="@(o => o)" Label="@L["FilterCertificate"]" @bind-Value="_certificateFilter" Width="180px" />
        @if (HasFilters)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilters">@S["ClearFilters"]</FluentButton>
        }
    </Filters>
    <ChildContent>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_rows.Count == 0)
        {
            <EmptyState Title="@L["EmptyTitle"]" Message="@L["EmptyMessage"]" Icon="@(new Icons.Regular.Size24.Certificate())">
                <Action>
                    <FluentAnchorButton Href="/enrollments/tokens?create=1" Appearance="ButtonAppearance.Primary">@L["CreateToken"]</FluentAnchorButton>
                </Action>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <NoResultsState OnClear="ClearFilters" />
        }
        else
        {
            <div class="grid-scroll">
            <FluentDataGrid Items="@Filtered" Pagination="@_pagination" RowSize="DataGridRowSize.Small" ResizableColumns="true" ItemKey="@(r => r.Device.Identity.DeviceId)" TGridItem="EnrollmentRow" aria-label="@L["ListTitle"]">
                <TemplateColumn Title="@L["ColumnEnrollmentId"]" SortBy="@(GridSort<EnrollmentRow>.ByAscending(r => r.Id))" Sortable="true" Width="160px">
                    <IdentifierText Value="@context.Id" Href="@($"/enrollments/{context.Id}")" />
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnTrustStatus"]" SortBy="@(GridSort<EnrollmentRow>.ByAscending(r => r.Device.Status))" Sortable="true" Width="140px">
                    <StatusBadge Presentation="StatusCatalog.Trust(context.Device.Status)" />
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnLastContact"]" SortBy="@(GridSort<EnrollmentRow>.ByDescending(r => r.Device.LastHeartbeatUtc))" Sortable="true" InitialSortDirection="DataGridSortDirection.Descending" IsDefaultSortColumn="true" Width="240px">
                    <DateTimeText Value="context.Device.LastHeartbeatUtc" />
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnAgentVersion"]" SortBy="@(GridSort<EnrollmentRow>.ByAscending(r => r.AgentVersion))" Sortable="true" Width="130px">
                    @(context.Device.Heartbeat?.AgentVersion ?? S["NotReported"])
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnCertificate"]" SortBy="@(GridSort<EnrollmentRow>.ByAscending(r => r.Device.CertificateExpiresAtUtc))" Sortable="true" Width="190px">
                    <StatusBadge Presentation="StatusCatalog.Certificate(context.Device.CertificateExpiresAtUtc, _now, Options.Value.CertificateExpiryWarningDays)" />
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnCapabilities"]" Width="150px">
                    @if (context.Device.Heartbeat is null || context.Device.Heartbeat.Capabilities.IsDefaultOrEmpty)
                    {
                        <span class="text-secondary">@S["NotReported"]</span>
                    }
                    else
                    {
                        <span title="@CapabilityList(context.Device)">@L["CapabilitiesCount", context.Device.Heartbeat.Capabilities.Length]</span>
                    }
                </TemplateColumn>
                @if (IsVisible("ColumnIglooVersion"))
                {
                    <TemplateColumn Title="@L["ColumnIglooVersion"]" Width="130px">@(context.Device.Heartbeat?.IglooVersion ?? S["NotReported"])</TemplateColumn>
                }
                @if (IsVisible("ColumnProtocol"))
                {
                    <TemplateColumn Title="@L["ColumnProtocol"]" Width="100px">@(context.Device.Heartbeat is { } h ? $"{h.Protocol.Major}.{h.Protocol.Minor}" : S["NotReported"])</TemplateColumn>
                }
                @if (IsVisible("ColumnAgentId"))
                {
                    <TemplateColumn Title="@L["ColumnAgentId"]" Width="140px"><IdentifierText Value="@context.Device.Identity.AgentId.ToString("D")" /></TemplateColumn>
                }
                @if (IsVisible("ColumnServerEnrollmentId"))
                {
                    <TemplateColumn Title="@L["ColumnServerEnrollmentId"]" Width="170px"><IdentifierText Value="@context.Device.EnrollmentId.ToString("D")" /></TemplateColumn>
                }
                @if (IsVisible("ColumnCertificateExpires"))
                {
                    <TemplateColumn Title="@L["ColumnCertificateExpires"]" Width="200px"><DateTimeText Value="context.Device.CertificateExpiresAtUtc" ShowRelative="false" /></TemplateColumn>
                }
            </FluentDataGrid>
            </div>
            <div class="grid-footer">
                <FluentPaginator State="@_pagination" />
            </div>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] TrustOptions = ["any", nameof(AgentTrustStatus.Active), nameof(AgentTrustStatus.Disabled), nameof(AgentTrustStatus.Revoked)];
    private static readonly string[] ContactOptions = ["any", "24h", "7d", "30d", "older", "never", "stale"];
    private static readonly string[] CertificateOptions = ["any", "valid", "soon", "expired"];

    private readonly PaginationState _pagination = new() { ItemsPerPage = 25 };
    private readonly List<OptionalColumn> _optionalColumns =
    [
        new("ColumnIglooVersion"), new("ColumnProtocol"), new("ColumnAgentId"), new("ColumnServerEnrollmentId"), new("ColumnCertificateExpires"),
    ];

    private bool _loading = true;
    private bool _columnsOpen;
    private OperatorFailure? _failure;
    private IReadOnlyList<EnrollmentRow> _rows = [];
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private string _trustFilter = "any";
    private string _contactFilter = "any";
    private string _certificateFilter = "any";

    [SupplyParameterFromQuery(Name = "contact")]
    private string? ContactQuery { get; set; }

    [SupplyParameterFromQuery(Name = "trust")]
    private string? TrustQuery { get; set; }

    private bool HasFilters => _trustFilter != "any" || _contactFilter != "any" || _certificateFilter != "any" || ConsoleShell.Query.Length > 0;

    private IQueryable<EnrollmentRow> Filtered => _rows.Where(Matches).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        ConsoleShell.AttachSearch(L["SearchPlaceholder"]);
        ConsoleShell.Changed += OnShellChanged;
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (ContactOptions.Contains(ContactQuery)) _contactFilter = ContactQuery!;
        if (TrustOptions.Contains(TrustQuery)) _trustFilter = TrustQuery!;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetEnrollmentsAsync();
        _now = DateTimeOffset.UtcNow;
        if (result.Succeeded)
        {
            _rows = result.Value!.Select(d => new EnrollmentRow(d, d.Identity.DeviceId.ToString("D"), d.Heartbeat?.AgentVersion ?? string.Empty)).ToArray();
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }

    private bool Matches(EnrollmentRow row)
    {
        var device = row.Device;
        if (_trustFilter != "any" && device.Status.ToString() != _trustFilter) return false;
        if (!MatchesContact(device)) return false;
        if (!MatchesCertificate(device)) return false;
        var query = ConsoleShell.Query.Trim();
        return query.Length == 0
            || row.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
            || device.Identity.AgentId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || device.EnrollmentId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesContact(TrustedDeviceView device)
    {
        var last = device.LastHeartbeatUtc;
        return _contactFilter switch
        {
            "24h" => last >= _now.AddHours(-24),
            "7d" => last >= _now.AddDays(-7),
            "30d" => last >= _now.AddDays(-30),
            "older" => last is not null && last < _now.AddDays(-30),
            "never" => last is null,
            "stale" => last is null || last < _now.AddDays(-Options.Value.StaleContactDays),
            _ => true,
        };
    }

    private bool MatchesCertificate(TrustedDeviceView device)
    {
        var days = (device.CertificateExpiresAtUtc - _now).TotalDays;
        return _certificateFilter switch
        {
            "valid" => days > Options.Value.CertificateExpiryWarningDays,
            "soon" => days > 0 && days <= Options.Value.CertificateExpiryWarningDays,
            "expired" => days <= 0,
            _ => true,
        };
    }

    private void ClearFilters()
    {
        _trustFilter = "any";
        _contactFilter = "any";
        _certificateFilter = "any";
        ConsoleShell.SetQuery(string.Empty);
    }

    private string TrustLabel(string option) => option == "any" ? L["FilterAny"] : Status["Trust_" + option];

    private string ContactLabel(string option) => option switch
    {
        "24h" => L["FilterContact24h"],
        "7d" => L["FilterContact7d"],
        "30d" => L["FilterContact30d"],
        "older" => L["FilterContactOlder"],
        "never" => L["FilterContactNever"],
        "stale" => L["FilterContactStale", Options.Value.StaleContactDays],
        _ => L["FilterContactAny"],
    };

    private string CertificateLabel(string option) => option switch
    {
        "valid" => L["FilterCertificateValid"],
        "soon" => L["FilterCertificateExpiresSoon"],
        "expired" => L["FilterCertificateExpired"],
        _ => L["FilterCertificateAny"],
    };

    private string CapabilityList(TrustedDeviceView device) =>
        string.Join(", ", device.Heartbeat!.Capabilities.Select(c => Status[StatusCatalog.CapabilityKey(c)].Value));

    private bool IsVisible(string key) => _optionalColumns.First(c => c.Key == key).Visible;

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConsoleShell.Changed -= OnShellChanged;
        ConsoleShell.DetachSearch();
    }

    internal sealed record EnrollmentRow(TrustedDeviceView Device, string Id, string AgentVersion);

    private sealed class OptionalColumn(string key)
    {
        public string Key { get; } = key;
        public bool Visible { get; set; }
    }
}
