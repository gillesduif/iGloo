@page "/planning/work"
@implements IDisposable
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject IDialogService Dialogs
@inject ConsoleShell ConsoleShell

<PageFrame Title="@L["WorkTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Planning"], "/planning/profiles")])">
    <PrimaryActions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="RequestAsync">@L["RequestWork"]</FluentButton>
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
        <FluentAnchorButton Href="/export/work-items.csv" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Download="work-items.csv">@S["ExportCsv"]</FluentAnchorButton>
    </SecondaryActions>
    <Filters>
        <FluentSelect TOption="string" TValue="string" Items="@TypeOptions" OptionText="@(o => TypeLabel(o))" OptionValue="@(o => o)" Label="@L["FilterType"]" @bind-Value="_typeFilter" Width="200px" />
        <FluentSelect TOption="string" TValue="string" Items="@StatusOptions" OptionText="@(o => StatusLabel(o))" OptionValue="@(o => o)" Label="@L["FilterStatus"]" @bind-Value="_statusFilter" Width="200px" />
        @if (HasFilters)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilters">@S["ClearFilters"]</FluentButton>
        }
    </Filters>
    <ChildContent>
        @if (_message is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="true" Class="page-message">@_message</FluentMessageBar>
        }
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_work.Count == 0)
        {
            <EmptyState Title="@L["WorkEmptyTitle"]" Message="@L["WorkEmptyMessage"]" Icon="@(new Icons.Regular.Size24.TaskListSquareLtr())">
                <Action><FluentButton Appearance="ButtonAppearance.Primary" OnClick="RequestAsync">@L["RequestWork"]</FluentButton></Action>
            </EmptyState>
        }
        else if (!Filtered.Any())
        {
            <NoResultsState OnClear="ClearFilters" />
        }
        else
        {
            <div class="grid-scroll">
            <FluentDataGrid Items="@Filtered" Pagination="@_pagination" RowSize="DataGridRowSize.Small" ResizableColumns="true" ItemKey="@(w => w.WorkItemId)" TGridItem="ReadOnlyWorkItem" aria-label="@L["WorkTitle"]">
                <TemplateColumn Title="@L["ColumnWorkItem"]" Width="160px"><IdentifierText Value="@context.WorkItemId.ToString("D")" Href="@($"/planning/work/{context.WorkItemId:D}")" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnEnrollment"]" Width="160px"><IdentifierText Value="@context.Identity.DeviceId.ToString("D")" Href="@($"/enrollments/{context.Identity.DeviceId:D}")" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnType"]" SortBy="@(GridSort<ReadOnlyWorkItem>.ByAscending(w => w.Type))" Sortable="true" Width="170px">@Status[StatusCatalog.WorkTypeKey(context.Type)]</TemplateColumn>
                <TemplateColumn Title="@L["ColumnStatus"]" SortBy="@(GridSort<ReadOnlyWorkItem>.ByAscending(w => w.Status))" Sortable="true" Width="170px"><StatusBadge Presentation="StatusCatalog.Work(context.Status)" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnCreated"]" SortBy="@(GridSort<ReadOnlyWorkItem>.ByDescending(w => w.CreatedAtUtc))" Sortable="true" InitialSortDirection="DataGridSortDirection.Descending" IsDefaultSortColumn="true" Width="230px"><DateTimeText Value="context.CreatedAtUtc" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnExpires"]" SortBy="@(GridSort<ReadOnlyWorkItem>.ByAscending(w => w.ExpiresAtUtc))" Sortable="true" Width="230px"><DateTimeText Value="context.ExpiresAtUtc" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnAttempts"]" Width="100px" Align="DataGridCellAlignment.End">@context.AttemptCount</TemplateColumn>
                <TemplateColumn Title="@L["ColumnProfileRevision"]" Width="220px">
                    @if (context.Profile is { } profile)
                    {
                        <a href="@($"/planning/profiles/{profile.ProfileId:D}")">@profile.Spec.Name · @L["RevisionLabel", profile.Revision]</a>
                    }
                    else
                    {
                        <span class="text-secondary">@S["None"]</span>
                    }
                </TemplateColumn>
            </FluentDataGrid>
            </div>
            <div class="grid-footer"><FluentPaginator State="@_pagination" /></div>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] TypeOptions = ["any", nameof(ReadOnlyWorkType.RunAssessment), nameof(ReadOnlyWorkType.RunMigrationDryRun)];
    private static readonly string[] StatusOptions = ["any", .. Enum.GetNames<ReadOnlyWorkStatus>()];
    private readonly PaginationState _pagination = new() { ItemsPerPage = 25 };
    private bool _loading = true;
    private OperatorFailure? _failure;
    private string? _message;
    private IReadOnlyList<ReadOnlyWorkItem> _work = [];
    private string _typeFilter = "any";
    private string _statusFilter = "any";

    private bool HasFilters => _typeFilter != "any" || _statusFilter != "any" || ConsoleShell.Query.Length > 0;

    private IQueryable<ReadOnlyWorkItem> Filtered => _work.Where(Matches).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        ConsoleShell.AttachSearch(L["WorkSearchPlaceholder"]);
        ConsoleShell.Changed += OnShellChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetWorkItemsAsync();
        if (result.Succeeded)
        {
            _work = result.Value!;
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }

    private bool Matches(ReadOnlyWorkItem work)
    {
        if (_typeFilter != "any" && work.Type.ToString() != _typeFilter) return false;
        if (_statusFilter != "any" && work.Status.ToString() != _statusFilter) return false;
        var query = ConsoleShell.Query.Trim();
        return query.Length == 0
            || work.WorkItemId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || work.Identity.DeviceId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || work.CorrelationId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string TypeLabel(string option) => option == "any" ? L["FilterAny"] : Status["WorkType_" + option];

    private string StatusLabel(string option) => option == "any" ? L["FilterAny"] : Status["Work_" + option];

    private void ClearFilters()
    {
        _typeFilter = "any";
        _statusFilter = "any";
        ConsoleShell.SetQuery(string.Empty);
    }

    private async Task RequestAsync()
    {
        var result = await Dialogs.ShowDialogAsync<RequestWorkDialog>(options => options.Modal = true);
        if (!result.Cancelled)
        {
            _message = L["WorkRequested"];
            await LoadAsync();
        }
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConsoleShell.Changed -= OnShellChanged;
        ConsoleShell.DetachSearch();
    }
}
