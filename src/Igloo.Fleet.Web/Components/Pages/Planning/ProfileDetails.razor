@page "/planning/profiles/{ProfileId:guid}"
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IFleetOperatorClient Client
@inject IDialogService Dialogs

<PageFrame Title="@(_latest?.Spec.Name ?? L["ProfilesTitle"])"
           Description="@(_latest is null ? null : L["RevisionLabel", _latest.Revision].Value)"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Planning"], "/planning/profiles"), new BreadcrumbItem(L["ProfilesTitle"], "/planning/profiles")])">
    <PrimaryActions>
        @if (_latest is not null)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="AddRevisionAsync">@L["AddRevision"]</FluentButton>
        }
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
    </SecondaryActions>
    <ChildContent>
        @if (_message is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="true" Class="page-message">@_message</FluentMessageBar>
        }
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_latest is null)
        {
            <EmptyState Title="@L["ProfileNotFoundTitle"]" Message="@S["RecordNotFoundMessage"]">
                <Action><FluentAnchorButton Href="/planning/profiles" Appearance="ButtonAppearance.Outline">@L["ProfilesTitle"]</FluentAnchorButton></Action>
            </EmptyState>
        }
        else
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false" AriaLive="AriaLive.Off" Class="page-message">@L["RevisionWarning"]</FluentMessageBar>
            <h2 class="section-title">@L["ProfileRevisionsTitle"]</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["ColumnRevision"]</th>
                        <th scope="col">@L["ColumnCreated"]</th>
                        <th scope="col">@L["ColumnDistribution"]</th>
                        <th scope="col">@L["ColumnMinimumFreeSpace"]</th>
                        <th scope="col">@L["ColumnSecureBoot"]</th>
                        <th scope="col">@L["ColumnWorkItemsUsing"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var revision in _revisions)
                    {
                        <tr>
                            <td>@L["RevisionLabel", revision.Revision] <IdentifierText Value="@revision.RevisionId.ToString("D")" /></td>
                            <td><DateTimeText Value="revision.CreatedAtUtc" /></td>
                            <td>@L[PlanningLabels.DistributionKey(revision.Spec.DistroId)]</td>
                            <td>@ConsoleFormat.Gibibytes(revision.Spec.MinimumAvailableBytes, S)</td>
                            <td>@(revision.Spec.RequireSecureBoot ? S["Yes"] : S["No"])</td>
                            <td><a href="/planning/work">@ConsoleFormat.Count(_work.Count(w => w.Profile?.RevisionId == revision.RevisionId))</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</PageFrame>

@code {
    private bool _loading = true;
    private OperatorFailure? _failure;
    private string? _message;
    private MigrationProfileRevision? _latest;
    private IReadOnlyList<MigrationProfileRevision> _revisions = [];
    private IReadOnlyList<ReadOnlyWorkItem> _work = [];

    [Parameter]
    public Guid ProfileId { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var profiles = Client.GetProfilesAsync();
        var work = Client.GetWorkItemsAsync();
        await Task.WhenAll(profiles, work);
        _failure = profiles.Result.Failure ?? work.Result.Failure;
        if (_failure is null)
        {
            _revisions = profiles.Result.Value!.Where(p => p.ProfileId == ProfileId).OrderByDescending(static p => p.Revision).ToArray();
            _latest = _revisions.FirstOrDefault();
            _work = work.Result.Value!;
        }

        _loading = false;
    }

    private async Task AddRevisionAsync()
    {
        if (_latest is null)
        {
            return;
        }

        var result = await Dialogs.ShowDialogAsync<ProfileDialog>(options =>
        {
            options.Modal = true;
            options.Parameters.Add(nameof(ProfileDialog.ProfileId), ProfileId);
            options.Parameters.Add(nameof(ProfileDialog.Current), _latest.Spec);
        });
        if (!result.Cancelled && result.Value is MigrationProfileRevision revision)
        {
            _message = L["ProfileRevised", revision.Revision];
            await LoadAsync();
        }
    }
}
