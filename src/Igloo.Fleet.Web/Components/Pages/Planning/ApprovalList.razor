@page "/planning/approvals"
@implements IDisposable
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject ConsoleAuditLog ConsoleAudit
@inject ConsoleShell ConsoleShell

<PageFrame Title="@L["ApprovalsTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Planning"], "/planning/profiles")])">
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
        <FluentAnchorButton Href="/export/approvals.csv" Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowDownload())" Download="approvals.csv">@S["ExportCsv"]</FluentAnchorButton>
    </SecondaryActions>
    <Filters>
        <FluentSelect TOption="string" TValue="string" Items="@StateOptions" OptionText="@(o => StateLabel(o))" OptionValue="@(o => o)" Label="@L["FilterState"]" @bind-Value="_stateFilter" Width="200px" />
        @if (HasFilters)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilters">@S["ClearFilters"]</FluentButton>
        }
    </Filters>
    <ChildContent>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_approvals.Count == 0)
        {
            <EmptyState Title="@L["ApprovalsEmptyTitle"]" Message="@L["ApprovalsEmptyMessage"]" Icon="@(new Icons.Regular.Size24.CheckmarkCircle())" />
        }
        else if (!Filtered.Any())
        {
            <NoResultsState OnClear="ClearFilters" />
        }
        else
        {
            <div class="grid-scroll">
            <FluentDataGrid Items="@Filtered" Pagination="@_pagination" RowSize="DataGridRowSize.Small" ResizableColumns="true" ItemKey="@(a => a.ApprovalId)" TGridItem="PlanApproval" aria-label="@L["ApprovalsTitle"]">
                <TemplateColumn Title="@L["ColumnApproval"]" Width="160px"><IdentifierText Value="@context.ApprovalId.ToString("D")" Href="@($"/planning/approvals/{context.ApprovalId:D}")" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnEnrollment"]" Width="160px"><IdentifierText Value="@context.Identity.DeviceId.ToString("D")" Href="@($"/enrollments/{context.Identity.DeviceId:D}")" /></TemplateColumn>
                <TemplateColumn Title="@L["FilterState"]" SortBy="@(GridSort<PlanApproval>.ByAscending(a => a.Status))" Sortable="true" Width="150px"><StatusBadge Presentation="StatusCatalog.Approval(context.Status)" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnApproved"]" SortBy="@(GridSort<PlanApproval>.ByDescending(a => a.ApprovedAtUtc))" Sortable="true" InitialSortDirection="DataGridSortDirection.Descending" IsDefaultSortColumn="true" Width="230px"><DateTimeText Value="context.ApprovedAtUtc" /></TemplateColumn>
                <TemplateColumn Title="@L["ApprovalExpires"]" Width="230px"><DateTimeText Value="context.ExpiresAtUtc" /></TemplateColumn>
                <TemplateColumn Title="@L["ColumnReviewReason"]" Width="260px">
                    @if (string.IsNullOrWhiteSpace(context.ReviewReason))
                    {
                        <span class="text-secondary">@S["None"]</span>
                    }
                    else
                    {
                        <span title="@context.ReviewReason">@(context.ReviewReason.Length > 60 ? context.ReviewReason[..60] + "…" : context.ReviewReason)</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@L["ColumnApprovedBy"]" Width="260px">
                    <code>@context.ApprovedBy</code>
                    @if (ConsoleAudit.FindByTarget(context.ApprovalId.ToString("D")) is { } entry)
                    {
                        <span class="text-secondary"> @L["FromConsoleAccount", entry.Account]</span>
                    }
                </TemplateColumn>
            </FluentDataGrid>
            </div>
            <div class="grid-footer"><FluentPaginator State="@_pagination" /></div>
        }
    </ChildContent>
</PageFrame>

@code {
    private static readonly string[] StateOptions = ["any", .. Enum.GetNames<ApprovalState>()];
    private readonly PaginationState _pagination = new() { ItemsPerPage = 25 };
    private bool _loading = true;
    private OperatorFailure? _failure;
    private IReadOnlyList<PlanApproval> _approvals = [];
    private string _stateFilter = "any";

    private bool HasFilters => _stateFilter != "any" || ConsoleShell.Query.Length > 0;

    private IQueryable<PlanApproval> Filtered => _approvals.Where(Matches).AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        ConsoleShell.AttachSearch(L["ApprovalSearchPlaceholder"]);
        ConsoleShell.Changed += OnShellChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetApprovalsAsync();
        if (result.Succeeded)
        {
            _approvals = result.Value!;
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }

    private bool Matches(PlanApproval approval)
    {
        if (_stateFilter != "any" && approval.Status.ToString() != _stateFilter) return false;
        var query = ConsoleShell.Query.Trim();
        return query.Length == 0
            || approval.ApprovalId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || approval.Identity.DeviceId.ToString("D").Contains(query, StringComparison.OrdinalIgnoreCase)
            || approval.EvidenceHash.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string StateLabel(string option) => option == "any" ? L["FilterAny"] : Status["Approval_" + option];

    private void ClearFilters()
    {
        _stateFilter = "any";
        ConsoleShell.SetQuery(string.Empty);
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConsoleShell.Changed -= OnShellChanged;
        ConsoleShell.DetachSearch();
    }
}
