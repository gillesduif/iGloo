@page "/planning/approvals/{ApprovalId:guid}"
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client
@inject IDialogService Dialogs
@inject ConsoleAuditLog ConsoleAudit

<PageFrame Title="@(_approval is null ? L["ApprovalDetailTitle"] : ConsoleFormat.ShortId(_approval.ApprovalId))"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Planning"], "/planning/profiles"), new BreadcrumbItem(L["ApprovalsTitle"], "/planning/approvals")])">
    <HeaderEnd>
        @if (_approval is not null)
        {
            <StatusBadge Presentation="StatusCatalog.Approval(_approval.Status)" />
        }
    </HeaderEnd>
    <PrimaryActions>
        @if (_approval is { Status: ApprovalState.Approved })
        {
            if (_plan is null)
            {
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.DocumentCheckmark())" OnClick="PrepareAsync">@L["PreparePlan"]</FluentButton>
            }
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.Prohibited())" OnClick="RevokeAsync">@L["RevokeApproval"]</FluentButton>
        }
    </PrimaryActions>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
    </SecondaryActions>
    <ChildContent>
        @if (_message is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="true" Class="page-message">@_message</FluentMessageBar>
        }
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_approval is null)
        {
            <EmptyState Title="@L["ApprovalNotFoundTitle"]" Message="@S["RecordNotFoundMessage"]">
                <Action><FluentAnchorButton Href="/planning/approvals" Appearance="ButtonAppearance.Outline">@L["ApprovalsTitle"]</FluentAnchorButton></Action>
            </EmptyState>
        }
        else
        {
            <div class="panel-grid">
                <FluentCard Class="panel">
                    <h2 class="panel-title">@L["ApprovalFields"]</h2>
                    <dl class="property-list">
                        <dt>@L["ColumnApproval"]</dt><dd><IdentifierText Value="@_approval.ApprovalId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ColumnEnrollment"]</dt><dd><IdentifierText Value="@_approval.Identity.DeviceId.ToString("D")" Short="false" Href="@($"/enrollments/{_approval.Identity.DeviceId:D}")" /></dd>
                        <dt>@L["FilterState"]</dt><dd><StatusBadge Presentation="StatusCatalog.Approval(_approval.Status)" /></dd>
                        <dt>@L["ColumnApproved"]</dt><dd><DateTimeText Value="_approval.ApprovedAtUtc" /></dd>
                        <dt>@L["ApprovalExpires"]</dt><dd><DateTimeText Value="_approval.ExpiresAtUtc" /></dd>
                        <dt>@L["ColumnApprovedBy"]</dt>
                        <dd>
                            <code>@_approval.ApprovedBy</code>
                            @if (ConsoleAudit.FindByTarget(_approval.ApprovalId.ToString("D")) is { } entry)
                            {
                                <span class="text-secondary"> @L["FromConsoleAccount", entry.Account]</span>
                            }
                        </dd>
                        <dt>@L["ColumnReviewReason"]</dt><dd>@(string.IsNullOrWhiteSpace(_approval.ReviewReason) ? S["None"].Value : _approval.ReviewReason)</dd>
                        <dt>@L["ColumnProfileRevision"]</dt><dd><IdentifierText Value="@_approval.ProfileRevisionId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ApproveDialogDecision"]</dt><dd><IdentifierText Value="@_approval.DecisionId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ApproveDialogHash"]</dt><dd><IdentifierText Value="@_approval.EvidenceHash" Short="false" /></dd>
                    </dl>
                </FluentCard>
                <div>
                    <FluentCard Class="panel">
                        <h2 class="panel-title">@L["ApprovalEvidenceCard"]</h2>
                        <p><IdentifierText Value="@_approval.DryRunId.ToString("D")" Short="false" Href="@($"/planning/evidence/{_approval.DryRunId:D}")" /></p>
                        <FluentAnchorButton Href="@($"/planning/evidence/{_approval.DryRunId:D}")" Appearance="ButtonAppearance.Outline">@L["LinkEvidence"]</FluentAnchorButton>
                    </FluentCard>
                    <FluentCard Class="panel">
                        <h2 class="panel-title">@L["ApprovalPlanCard"]</h2>
                        @if (_plan is null)
                        {
                            <p class="text-secondary">@L["ApprovalNoPlan"]</p>
                        }
                        else
                        {
                            <p><StatusBadge Presentation="StatusCatalog.Plan(_plan.Status)" /> <IdentifierText Value="@_plan.PlanId.ToString("D")" Href="@($"/planning/plans/{_plan.PlanId:D}")" /></p>
                            <FluentAnchorButton Href="@($"/planning/plans/{_plan.PlanId:D}")" Appearance="ButtonAppearance.Outline">@L["LinkPlan"]</FluentAnchorButton>
                        }
                    </FluentCard>
                </div>
            </div>
        }
    </ChildContent>
</PageFrame>

@code {
    private bool _loading = true;
    private OperatorFailure? _failure;
    private string? _message;
    private PlanApproval? _approval;
    private PreparedMigrationPlan? _plan;

    [Parameter]
    public Guid ApprovalId { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var approvals = Client.GetApprovalsAsync();
        var plans = Client.GetPlansAsync();
        await Task.WhenAll(approvals, plans);
        _failure = approvals.Result.Failure ?? plans.Result.Failure;
        if (_failure is null)
        {
            _approval = approvals.Result.Value!.SingleOrDefault(a => a.ApprovalId == ApprovalId);
            _plan = plans.Result.Value!.FirstOrDefault(p => p.ApprovalId == ApprovalId);
        }

        _loading = false;
    }

    private async Task PrepareAsync()
    {
        var confirm = await Dialogs.ShowDialogAsync<ConfirmDialog>(options =>
        {
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDialog.Title), L["PreparePlanTitle"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.Message), L["PreparePlanMessage"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.ConfirmLabel), L["PreparePlan"].Value);
        });
        if (confirm.Cancelled)
        {
            return;
        }

        var result = await Client.PrepareAsync(ApprovalId);
        if (result.Succeeded)
        {
            _message = L["PlanPrepared"];
            await LoadAsync();
        }
        else
        {
            _failure = result.Failure;
        }
    }

    private async Task RevokeAsync()
    {
        var confirm = await Dialogs.ShowDialogAsync<ConfirmDialog>(options =>
        {
            options.Modal = true;
            options.Parameters.Add(nameof(ConfirmDialog.Title), L["RevokeApprovalTitle"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.Message), L["RevokeApprovalMessage"].Value);
            options.Parameters.Add(nameof(ConfirmDialog.ConfirmLabel), L["RevokeApproval"].Value);
        });
        if (confirm.Cancelled)
        {
            return;
        }

        var result = await Client.RevokeApprovalAsync(ApprovalId);
        if (result.Succeeded)
        {
            _message = L["ApprovalRevoked"];
            await LoadAsync();
        }
        else
        {
            _failure = result.Failure;
        }
    }
}
