@inherits FluentDialogInstance
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client

<FluentDialogBody>
    <ChildContent>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null && _enrollments.Count == 0)
        {
            <OperatorFailureState Failure="_failure" />
        }
        else
        {
            <FluentSelect TOption="TrustedDeviceView" TValue="string" Items="@_enrollments" OptionText="@(e => EnrollmentLabel(e))" OptionValue="@(e => e.Identity.DeviceId.ToString("D"))"
                          @bind-Value="_deviceId" Label="@L["RequestWorkEnrollment"]" Width="100%" />
            <FluentSelect TOption="ReadOnlyWorkType" TValue="ReadOnlyWorkType" Items="@Types" OptionText="@(t => Status[StatusCatalog.WorkTypeKey(t)].Value)" OptionValue="@(t => t)"
                          @bind-Value="_type" Label="@L["RequestWorkType"]" Width="100%" />
            @if (_type == ReadOnlyWorkType.RunMigrationDryRun)
            {
                <FluentSelect TOption="MigrationProfileRevision" TValue="string" Items="@_latestRevisions" OptionText="@(p => p.Spec.Name + " · " + L["RevisionLabel", p.Revision].Value)" OptionValue="@(p => p.RevisionId.ToString("D"))"
                              @bind-Value="_revisionId" Label="@L["RequestWorkProfile"]" Width="100%" />
            }
            <FluentTextInput TextInputType="TextInputType.Number" InputMode="TextInputMode.Numeric" @bind-Value="_lifetimeText" Immediate="true"
                             Label="@L["RequestWorkLifetime"]" Message="@L["RequestWorkLifetimeRule"]" Required="true" Width="200px" min="1" max="1440" />
            @if (MissingCapabilities is { Count: > 0 } missing)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false" AriaLive="AriaLive.Polite" Class="dialog-warning">
                    @L["RequestWorkMissingCapabilities", string.Join(", ", missing.Select(c => Status[StatusCatalog.CapabilityKey(c)].Value))]
                </FluentMessageBar>
            }
            @if (_failure is not null)
            {
                <OperatorFailureState Failure="_failure" />
            }
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(_busy || !CanSubmit)" Loading="@_busy" OnClick="SubmitAsync">@L["RequestWork"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@_busy" OnClick="@(() => DialogInstance.CancelAsync())">@S["Cancel"]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    private static readonly ReadOnlyWorkType[] Types = [ReadOnlyWorkType.RunAssessment, ReadOnlyWorkType.RunMigrationDryRun];
    private bool _loading = true;
    private bool _busy;
    private OperatorFailure? _failure;
    private IReadOnlyList<TrustedDeviceView> _enrollments = [];
    private IReadOnlyList<MigrationProfileRevision> _latestRevisions = [];
    private string? _deviceId;
    private ReadOnlyWorkType _type = ReadOnlyWorkType.RunAssessment;
    private string? _revisionId;
    private string? _lifetimeText = "60";

    private TrustedDeviceView? Selected => _enrollments.FirstOrDefault(e => e.Identity.DeviceId.ToString("D") == _deviceId);

    private int? LifetimeMinutes =>
        int.TryParse(_lifetimeText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var minutes)
        && minutes is >= 1 and <= 1440 ? minutes : null;

    private IReadOnlyList<PlanningCapability>? MissingCapabilities
    {
        get
        {
            if (Selected is null)
            {
                return null;
            }

            IReadOnlyList<PlanningCapability> required = _type == ReadOnlyWorkType.RunAssessment
                ? [PlanningCapability.PreflightV1, PlanningCapability.EvidenceV1]
                : [PlanningCapability.PreflightV1, PlanningCapability.MigrationDryRunV1, PlanningCapability.EvidenceV1, PlanningCapability.ProfileSchemaV1];
            var reported = Selected.Heartbeat?.Capabilities ?? [];
            return required.Where(c => !reported.Contains(c)).ToArray();
        }
    }

    private bool CanSubmit => Selected is not null && LifetimeMinutes is not null && MissingCapabilities is { Count: 0 }
        && (_type == ReadOnlyWorkType.RunAssessment || _revisionId is not null);

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer) => header.Title = L["RequestWorkDialogTitle"];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var enrollments = Client.GetEnrollmentsAsync();
        var profiles = Client.GetProfilesAsync();
        await Task.WhenAll(enrollments, profiles);
        _failure = enrollments.Result.Failure ?? profiles.Result.Failure;
        if (_failure is null)
        {
            _enrollments = enrollments.Result.Value!.Where(static e => e.Status == AgentTrustStatus.Active).ToArray();
            _latestRevisions = profiles.Result.Value!.GroupBy(static p => p.ProfileId).Select(static g => g.MaxBy(static p => p.Revision)!).OrderBy(static p => p.Spec.Name).ToArray();
            _deviceId = _enrollments.FirstOrDefault()?.Identity.DeviceId.ToString("D");
            _revisionId = _latestRevisions.FirstOrDefault()?.RevisionId.ToString("D");
        }

        _loading = false;
    }

    protected override Task OnActionClickedAsync(bool primary) => Task.CompletedTask;

    private string EnrollmentLabel(TrustedDeviceView enrollment) =>
        ConsoleFormat.ShortId(enrollment.Identity.DeviceId) + " · " + (enrollment.Heartbeat?.AgentVersion ?? S["NotReported"].Value);

    private async Task SubmitAsync()
    {
        if (!CanSubmit || Selected is null || LifetimeMinutes is not { } minutes)
        {
            return;
        }

        _busy = true;
        _failure = null;
        var request = new RequestReadOnlyWork(Selected.Identity.DeviceId, _type,
            _type == ReadOnlyWorkType.RunMigrationDryRun ? Guid.Parse(_revisionId!) : null, minutes);
        var result = await Client.RequestWorkAsync(request);
        _busy = false;
        if (result.Succeeded)
        {
            await DialogInstance.CloseAsync(result.Value);
        }
        else
        {
            _failure = result.Failure;
        }
    }
}
