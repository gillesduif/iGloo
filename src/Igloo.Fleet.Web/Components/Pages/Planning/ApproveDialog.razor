@inherits FluentDialogInstance
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<StatusStrings> Status
@inject IFleetOperatorClient Client

<FluentDialogBody>
    <ChildContent>
        <p>@L["ApproveDialogWhat"]</p>
        <dl class="property-list">
            <dt>@L["ApproveDialogHash"]</dt><dd><code>@Evidence.EvidenceHash</code></dd>
            <dt>@L["ApproveDialogDecision"]</dt><dd><code>@Evidence.Decision.DecisionId.ToString("D")</code> · <StatusBadge Presentation="StatusCatalog.Eligibility(Evidence.Decision.Status)" /></dd>
            <dt>@L["ApproveDialogProfile"]</dt><dd><code>@ProfileRevisionId.ToString("D")</code></dd>
        </dl>
        <FluentTextArea @bind-Value="_reason" Immediate="true" Label="@L["ApproveReviewReason"]" Required="@RequiresReason" MaxLength="500" Rows="4" Width="100%"
                        Message="@(RequiresReason ? L["ApproveReviewReasonRequired"] : L["ApproveReviewReasonOptional"])" />
        <p class="text-secondary">@L["ApproveReviewReasonCounter", _reason?.Length ?? 0] · @L["ApproveReviewReasonStored"]</p>
        <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false" AriaLive="AriaLive.Off">@L["ApproveConfirmLine"]</FluentMessageBar>
        @if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" />
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(_busy || !CanApprove)" Loading="@_busy" OnClick="ApproveAsync">@L["Approve"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@_busy" OnClick="@(() => DialogInstance.CancelAsync())">@S["Cancel"]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    private string? _reason;
    private bool _busy;
    private OperatorFailure? _failure;

    [Parameter]
    public DryRunEvidence Evidence { get; set; } = default!;

    [Parameter]
    public Guid ProfileRevisionId { get; set; }

    private bool RequiresReason => Evidence.Decision.Status == PlanningEligibility.NeedsReview;

    private bool CanApprove => (!RequiresReason || !string.IsNullOrWhiteSpace(_reason)) && (_reason?.Length ?? 0) <= 500;

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer) => header.Title = L["ApproveDialogTitle"];

    protected override Task OnActionClickedAsync(bool primary) => Task.CompletedTask;

    private async Task ApproveAsync()
    {
        if (!CanApprove)
        {
            return;
        }

        _busy = true;
        _failure = null;
        var request = new ApprovePlanRequest(Evidence.DryRunId, Evidence.EvidenceHash, ProfileRevisionId, Evidence.Decision.DecisionId,
            string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim());
        var result = await Client.ApproveAsync(request);
        _busy = false;
        if (result.Succeeded)
        {
            await DialogInstance.CloseAsync(result.Value);
        }
        else
        {
            _failure = result.Failure;
        }
    }
}
