@page "/planning/plans/{PlanId:guid}"
@inject IStringLocalizer<PlanningStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IFleetOperatorClient Client

<PageFrame Title="@(_plan is null ? L["PlanDetailTitle"] : ConsoleFormat.ShortId(_plan.PlanId))"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Planning"], "/planning/profiles"), new BreadcrumbItem(L["PlansTitle"], "/planning/plans")])">
    <HeaderEnd>
        @if (_plan is not null)
        {
            <StatusBadge Presentation="StatusCatalog.Plan(_plan.Status)" />
        }
    </HeaderEnd>
    <SecondaryActions>
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="LoadAsync" Disabled="@_loading">@S["Refresh"]</FluentButton>
    </SecondaryActions>
    <ChildContent>
        @if (_loading)
        {
            <LoadingState />
        }
        else if (_failure is not null)
        {
            <OperatorFailureState Failure="_failure" OnRetry="LoadAsync" />
        }
        else if (_plan is null)
        {
            <EmptyState Title="@L["PlanNotFoundTitle"]" Message="@S["RecordNotFoundMessage"]">
                <Action><FluentAnchorButton Href="/planning/plans" Appearance="ButtonAppearance.Outline">@L["PlansTitle"]</FluentAnchorButton></Action>
            </EmptyState>
        }
        else
        {
            <FluentMessageBar Intent="MessageBarIntent.Info" Title="@L["PlanBoundaryCard"]" AllowDismiss="false" AriaLive="AriaLive.Off" Class="page-message">@_plan.SafetyBoundary</FluentMessageBar>
            <div class="panel-grid">
                <FluentCard Class="panel">
                    <h2 class="panel-title">@L["PlanLineageCard"]</h2>
                    <dl class="property-list">
                        <dt>@L["ColumnPlan"]</dt><dd><IdentifierText Value="@_plan.PlanId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ColumnEnrollment"]</dt><dd><IdentifierText Value="@_plan.Identity.DeviceId.ToString("D")" Short="false" Href="@($"/enrollments/{_plan.Identity.DeviceId:D}")" /></dd>
                        <dt>@L["ColumnApproval"]</dt><dd><IdentifierText Value="@_plan.ApprovalId.ToString("D")" Short="false" Href="@($"/planning/approvals/{_plan.ApprovalId:D}")" /></dd>
                        <dt>@L["EvidenceTitle"]</dt><dd><IdentifierText Value="@_plan.DryRunId.ToString("D")" Short="false" Href="@($"/planning/evidence/{_plan.DryRunId:D}")" /></dd>
                        <dt>@L["ApproveDialogDecision"]</dt><dd><IdentifierText Value="@_plan.DecisionId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ColumnProfileRevision"]</dt><dd><IdentifierText Value="@_plan.ProfileRevisionId.ToString("D")" Short="false" /></dd>
                        <dt>@L["ApproveDialogHash"]</dt><dd><IdentifierText Value="@_plan.EvidenceHash" Short="false" /></dd>
                        <dt>@L["PlanPluginHash"]</dt><dd><IdentifierText Value="@_plan.PluginHash" Short="false" /></dd>
                    </dl>
                </FluentCard>
                <FluentCard Class="panel">
                    <h2 class="panel-title">@L["PlanValidityCard"]</h2>
                    <dl class="property-list">
                        <dt>@L["FilterState"]</dt><dd><StatusBadge Presentation="StatusCatalog.Plan(_plan.Status)" /></dd>
                        <dt>@L["ColumnCreated"]</dt><dd><DateTimeText Value="_plan.CreatedAtUtc" /></dd>
                        <dt>@L["ColumnExpires"]</dt><dd><DateTimeText Value="_plan.ExpiresAtUtc" /></dd>
                        <dt>@L["ColumnDistribution"]</dt><dd>@L[PlanningLabels.DistributionKey(_plan.DistroId)]</dd>
                        <dt>@L["ColumnIglooVersion"]</dt><dd>@_plan.IglooVersion</dd>
                    </dl>
                </FluentCard>
            </div>
        }
    </ChildContent>
</PageFrame>

@code {
    private bool _loading = true;
    private OperatorFailure? _failure;
    private PreparedMigrationPlan? _plan;

    [Parameter]
    public Guid PlanId { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failure = null;
        var result = await Client.GetPlansAsync();
        if (result.Succeeded)
        {
            _plan = result.Value!.SingleOrDefault(p => p.PlanId == PlanId);
        }
        else
        {
            _failure = result.Failure;
        }

        _loading = false;
    }
}
