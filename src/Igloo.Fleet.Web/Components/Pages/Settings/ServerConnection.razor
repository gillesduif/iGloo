@page "/settings/server"
@inject IStringLocalizer<SettingsStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject IFleetOperatorClient Client
@inject Microsoft.Extensions.Options.IOptions<FleetServerOptions> Server

<PageFrame Title="@L["ServerTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Settings"], "/settings/server")])">
    <PrimaryActions>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CheckAsync" Disabled="@_checking" IconStart="@(new Icons.Regular.Size16.PlugConnected())">@L["ServerCheck"]</FluentButton>
    </PrimaryActions>
    <ChildContent>
        @if (Client.IsSampleData)
        {
            <UnavailableNotice Title="@S["SampleDataTitle"]">@L["ServerSampleNote"]</UnavailableNotice>
        }
        <div class="panel-grid">
            <FluentCard Class="panel">
                <h2 class="panel-title">@L["ServerStatus"]</h2>
                <dl class="property-list">
                    <dt>@L["ServerStatus"]</dt>
                    <dd>
                        @if (_health is null)
                        {
                            <span class="text-secondary">@S["NotAvailable"]</span>
                        }
                        else
                        {
                            <StatusBadge Presentation="StatusCatalog.Connection(_health.Failure?.Kind)" />
                        }
                    </dd>
                    <dt>@L["ServerProtocol"]</dt>
                    <dd>@(_health?.Value is { } health ? $"{health.Protocol.Major}.{health.Protocol.Minor}" : S["NotAvailable"])</dd>
                    <dt>@L["ServerSafetyBoundary"]</dt>
                    <dd>@(_health?.Value?.SafetyBoundary ?? S["NotAvailable"])</dd>
                </dl>
                @if (_health is { Failure: { } failure })
                {
                    <OperatorFailureState Failure="failure" OnRetry="CheckAsync" />
                }
            </FluentCard>
            <FluentCard Class="panel">
                <h2 class="panel-title">@L["ServerHowToConfigure"]</h2>
                <dl class="property-list">
                    <dt>@L["ServerAddress"]</dt>
                    <dd><code>@(Server.Value.ResolveUri()?.ToString() ?? S["NotAvailable"])</code></dd>
                    <dt>@L["ServerCaPath"]</dt>
                    <dd><code>@(Server.Value.ResolveCaCertificatePath() ?? L["ServerCaMissing"])</code></dd>
                    <dt>@L["ServerOperatorCredential"]</dt>
                    <dd>@(FleetServerOptions.HasOperatorSecret() ? L["ServerOperatorCredentialSet"] : L["ServerOperatorCredentialMissing"])</dd>
                </dl>
                <p class="text-secondary">@L["ServerOperatorCredentialNote", FleetServerOptions.OperatorSecretVariable]</p>
                <p>@L["ServerHowToConfigureSteps"]</p>
            </FluentCard>
        </div>
    </ChildContent>
</PageFrame>

@code {
    private bool _checking;
    private OperatorResult<ServerHealth>? _health;

    protected override Task OnInitializedAsync() => CheckAsync();

    private async Task CheckAsync()
    {
        _checking = true;
        _health = await Client.GetHealthAsync();
        _checking = false;
    }
}
