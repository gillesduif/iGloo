@page "/settings/accounts"
@inject IStringLocalizer<SettingsStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject FleetOperatorStore OperatorStore
@inject ConsoleAuditLog ConsoleAudit
@inject ConsoleSession Session

<PageFrame Title="@L["AccountsTitle"]"
           Breadcrumbs="@([new BreadcrumbItem(Shell["Overview"], "/"), new BreadcrumbItem(Shell["Settings"], "/settings/server")])">
    <UnavailableNotice>@L["AccountsOnlyOne"]</UnavailableNotice>

    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">@L["AccountDisplayName"]</th>
                <th scope="col">@L["AccountUsername"]</th>
                <th scope="col">@L["AccountRole"]</th>
                <th scope="col">@L["AccountCreated"]</th>
                <th scope="col">@L["AccountsCurrent"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in _accounts)
            {
                <tr>
                    <td>@account.DisplayName</td>
                    <td><code>@account.Username</code></td>
                    <td>@(account.Role == "Administrator" ? Shell["RoleAdministrator"] : account.Role)</td>
                    <td><DateTimeText Value="account.CreatedAtUtc" ShowRelative="false" /></td>
                    <td>@(account.Username == _current.Username ? S["Yes"] : string.Empty)</td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="section-title">@L["ConsoleAuditTitle"]</h2>
    @if (_entries.Count == 0)
    {
        <p class="text-secondary">@L["ConsoleAuditEmpty"]</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">@L["ConsoleAuditTime"]</th>
                    <th scope="col">@L["ConsoleAuditAccount"]</th>
                    <th scope="col">@L["ConsoleAuditAction"]</th>
                    <th scope="col">@L["ConsoleAuditTarget"]</th>
                    <th scope="col">@L["ConsoleAuditOutcome"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td><DateTimeText Value="entry.AtUtc" /></td>
                        <td><code>@entry.Account</code></td>
                        <td>@entry.Action</td>
                        <td>@if (entry.Target is not null) { <IdentifierText Value="@entry.Target" /> }</td>
                        <td>@entry.Outcome</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</PageFrame>

@code {
    private IReadOnlyList<ConsoleAccountInfo> _accounts = [];
    private IReadOnlyList<ConsoleAuditEntry> _entries = [];
    private ConsoleAccount _current = ConsoleAccount.Anonymous;

    protected override async Task OnInitializedAsync()
    {
        _current = await Session.GetAccountAsync();
        _accounts = OperatorStore.List();
        _entries = ConsoleAudit.ReadRecent(50);
    }
}
