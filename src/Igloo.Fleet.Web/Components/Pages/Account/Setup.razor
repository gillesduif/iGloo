@page "/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject IStringLocalizer<AccountStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject FleetOperatorStore OperatorStore
@inject NavigationManager Navigation

<PageTitle>@S["TitleFormat", L["SetupTitle"]]</PageTitle>

<div class="standalone-card">
    <div class="standalone-brand">
        <img src="img/igloo-logo.svg" alt="" width="40" height="40" />
        <span>@S["ProductName"]</span>
    </div>
    <h1>@L["SetupTitle"]</h1>

    @if (Error == "password-mismatch")
    {
        <div class="form-error" role="alert">@L["PasswordMismatch"]</div>
    }
    else if (Error == "validation")
    {
        <div class="form-error" role="alert">@L["ValidationError"]</div>
    }

    <form method="post" action="/auth/setup" data-enhance="false" class="standalone-form">
        <AntiforgeryToken />

        <div class="form-field">
            <label for="displayName">@L["DisplayName"]</label>
            <input id="displayName" name="displayName" autocomplete="name" maxlength="100" required autofocus />
        </div>

        <div class="form-field">
            <label for="username">@L["Username"]</label>
            <input id="username" name="username" autocomplete="username" minlength="3" maxlength="64" pattern="[A-Za-z0-9._\-]+" aria-describedby="username-rule" required />
            <div id="username-rule" class="form-hint">@L["UsernameRule"]</div>
        </div>

        <div class="form-field">
            <label for="password">@L["Password"]</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="password-rule" required />
            <div id="password-rule" class="form-hint">@L["PasswordRule"]</div>
        </div>

        <div class="form-field">
            <label for="confirmPassword">@L["ConfirmPassword"]</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        </div>

        <button type="submit" class="button-primary">@L["CreateAdministrator"]</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        if (OperatorStore.HasOperators())
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
