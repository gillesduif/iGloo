@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject IStringLocalizer<AccountStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject FleetOperatorStore OperatorStore
@inject NavigationManager Navigation

<PageTitle>@S["TitleFormat", L["SignInTitle"]]</PageTitle>

<div class="standalone-card">
    <div class="standalone-brand">
        <img src="img/igloo-logo.svg" alt="" width="40" height="40" />
        <span>@S["ProductName"]</span>
    </div>
    <h1>@L["SignInTitle"]</h1>

    @if (Error == "invalid")
    {
        <div class="form-error" role="alert">@L["InvalidCredentials"]</div>
    }

    <form method="post" action="/auth/login" data-enhance="false" class="standalone-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

        <div class="form-field">
            <label for="username">@L["Username"]</label>
            <input id="username" name="username" autocomplete="username" maxlength="64" required autofocus />
        </div>

        <div class="form-field">
            <label for="password">@L["Password"]</label>
            <input id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required />
        </div>

        <div class="form-check">
            <input id="rememberMe" name="rememberMe" type="checkbox" />
            <label for="rememberMe">@L["RememberMe"]</label>
        </div>

        <button type="submit" class="button-primary">@L["SignIn"]</button>
    </form>

</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string SafeReturnUrl =>
        !string.IsNullOrWhiteSpace(ReturnUrl) &&
        ReturnUrl[0] == '/' &&
        !ReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
        !ReturnUrl.Contains("://", StringComparison.Ordinal)
            ? ReturnUrl
            : "/";

    protected override void OnInitialized()
    {
        if (!OperatorStore.HasOperators())
        {
            Navigation.NavigateTo("/setup", forceLoad: true);
        }
    }
}
