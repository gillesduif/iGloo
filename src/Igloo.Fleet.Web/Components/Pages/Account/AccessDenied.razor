@page "/access-denied"
@layout EmptyLayout

<PageTitle>Access denied | iGloo Fleet</PageTitle>

<div class="igloo-auth-standalone">
    <div class="card card-outline card-warning shadow-sm">
        <div class="card-body text-center p-4">
            <img src="/img/igloo-logo.svg" alt="iGloo" width="42" height="42" class="mb-3" />
            <h1 class="h4">Access denied</h1>
            <p class="text-body-secondary">Your operator account is not allowed to open this resource.</p>
            <a class="btn btn-primary" href="/">Return to Fleet</a>
        </div>
    </div>
</div>
