@page "/access-denied"
@inject IStringLocalizer<AccountStrings> L
@inject IStringLocalizer<SharedStrings> S
@inject ConsoleSession Session

<PageFrame Title="@L["AccessDeniedTitle"]" Description="@L["AccessDeniedMessage", _account.Username]">
    <FluentAnchorButton Href="/" Appearance="ButtonAppearance.Primary">@L["ReturnToOverview"]</FluentAnchorButton>
</PageFrame>

@code {
    private ConsoleAccount _account = ConsoleAccount.Anonymous;

    protected override async Task OnInitializedAsync() => _account = await Session.GetAccountAsync();
}
