<AppContent Title="@Title">
    <Card Title="@Title" Variant="outline">
        <div class="igloo-module-intro">
            <div class="igloo-module-icon"><i class="bi bi-grid-1x2"></i></div>
            <div>
                <h5>@Title</h5>
                <p class="mb-2">This iGloo Fleet capability now has a permanent navigation entry and route. Backend contracts and live management actions will be connected as the subsystem is implemented.</p>
                <code>@RelativePath</code>
            </div>
        </div>
    </Card>
</AppContent>

@code {
    private string RelativePath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Split('#')[0].Trim('/');
    private string[] Segments => RelativePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
    private string Section => Segments.Length > 0 ? Pretty(Segments[0]) : "iGloo Fleet";
    private string Title => Segments.Length > 1 ? Pretty(Segments[^1]) : Section;

    private static string Pretty(string value)
    {
        var text = value.Replace("-", " ", StringComparison.Ordinal);
        return string.Join(" ", text.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.Length <= 1 ? word.ToUpperInvariant() : char.ToUpperInvariant(word[0]) + word[1..]));
    }
}