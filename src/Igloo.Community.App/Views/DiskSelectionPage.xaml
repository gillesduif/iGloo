<UserControl
    x:Class="Igloo.Community.App.Views.DiskSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Igloo.Community.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DiskSelectionDesignData, IsDesignTimeCreatable=True}"
    d:DesignWidth="900" d:DesignHeight="1100">

    <UserControl.Resources>

        <!-- Disk card: selection must be impossible to misread - accent ring + glow -->
        <Style x:Key="DiskItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="Margin"           Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                BorderThickness="1.5" CornerRadius="10" Padding="18,14"
                                BorderBrush="{StaticResource Brush.Surface.Border}"
                                Background="{StaticResource Brush.Surface}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Root" Property="Background"  Value="#14182E" />
                                <Setter TargetName="Root" Property="Effect"      Value="{StaticResource Effect.AccentGlow.Soft}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected"  Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3A4566" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent.Bright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Partition segment inside the proportional strip -->
        <Style x:Key="PartitionSegment" TargetType="Border">
            <Setter Property="Background"   Value="#2E3A5C" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin"       Value="0,0,1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="Background" Value="#3E6B9E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBoot}" Value="True">
                    <Setter Property="Background" Value="#6B5CA8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Scroll.ContentGutter}">

            <!--   Disk cards                          -->
            <TextBlock Text="DISK" Style="{StaticResource Text.Section}" Margin="2,0,0,4" />

            <ListBox ItemsSource="{Binding DiskItems}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     IsSynchronizedWithCurrentItem="False"
                     ItemContainerStyle="{StaticResource DiskItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Choose the disk Linux will be installed on"
                     KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <!-- Model + badges + capacity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Disk.Model}"
                                               FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}" />
                                    <Border>
                                        <TextBlock Text="WINDOWS" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Accent.Bright}" />
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Margin" Value="10,0,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemDisk}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="1" FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding Disk.TotalBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Disk.PartitionStyle, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>

                            <!-- Proportional partition strip: sizes you can SEE -->
                            <Grid x:Name="Strip" Height="16" Margin="0,10,0,0">
                                <Border Background="#10162A" CornerRadius="3" />
                                <ItemsControl ItemsSource="{Binding Disk.Partitions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PartitionSegment}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource ProportionalWidth}">
                                                        <Binding Path="SizeBytes" />
                                                        <Binding Path="DataContext.Disk.TotalBytes"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="ActualWidth" ElementName="Strip" />
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.ToolTip>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileSystem, Mode=OneWay}" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                        <Run Text=" - " />
                                                        <Run Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border.ToolTip>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Community always retains an existing Windows installation. -->
            <TextBlock Margin="2,4,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEligibleWindowsDisk}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding WindowsDiskAction, Mode=OneWay}" />
            </TextBlock>

            <!--   Linux size                         -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="LINUX SIZE" Style="{StaticResource Text.Section}" Margin="2,18,0,8" />
                <Border Style="{StaticResource Card}">
                    <!-- Every row carries the same bottom margin; the panel takes the last one back. -->
                    <StackPanel Margin="0,0,0,-12">

                        <TextBlock Visibility="{Binding ShowDiskAction, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{Binding DiskActionMessage}" />

                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding ShowPartitionSizer, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Slider Minimum="{Binding LinuxSliderMinimumGb, Mode=OneWay}"
                                    Maximum="{Binding LinuxSliderMaximumGb, Mode=OneWay}"
                                    Value="{Binding LinuxSizeGb}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="5"
                                    SmallChange="5"
                                    LargeChange="10"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Gigabytes of disk space for Linux" />

                            <TextBlock Grid.Column="1" MinWidth="72" Margin="16,0,0,0"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Accent.Bright}"
                                       FontWeight="SemiBold" FontSize="15">
                                <Run Text="{Binding LinuxSizeGb, Mode=OneWay}" /><Run Text=" GB" />
                            </TextBlock>

                            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding MinLinuxGb, Mode=OneWay}" /><Run Text=" GB" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding MaxProvisionalLinuxGb, Mode=OneWay}" /><Run Text=" GB" />
                                </TextBlock>
                            </DockPanel>
                        </Grid>

                        <!-- An installer that takes unallocated space whole gives Linux another size than the one asked. -->
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                                   Style="{StaticResource Text.Body}"
                                   Visibility="{Binding HasAllocationSummary, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding AllocationSummary}" />

                        <!-- Dual boot not available -->
                        <Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap">
                                <Run Text="Linux needs at least " /><Run Text="{Binding MinLinuxGb, Mode=OneWay}" /><Run Text=" GB on this disk. Free up space in Windows, or go back to Configuration and select fewer files." />
                            </TextBlock>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card.Warning}">
                                    <Setter Property="Padding" Value="12,9" />
                                    <Setter Property="Margin"  Value="0,0,0,12" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsMoreDualBootSpace}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
