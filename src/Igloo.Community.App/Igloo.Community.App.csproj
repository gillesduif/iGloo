<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      net8.0-windows10.0.19041.0 matches Igloo.Preflight (System.Management) and keeps
      the Windows 10 2004+ API surface consistent across all projects in the solution.
    -->
    <!-- net9: unlocks WPF's official Fluent (Win11) theme  native control
         styling, hover states and scrollbars from the WPF team itself.
         Libraries stay net8; a net9 app references them fine. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Igloo.Community.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The [LibraryImport] source generator emits unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2-alpha</Version>
    <AssemblyName>iGloo</AssemblyName>
    <ApplicationIcon>iGloo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="iGloo.ico" />
    <!-- Microsoft Fluent 3D icons (fluentui-emoji, MIT)  the Settings-style
         3D illustrative icons; embedded so pack URIs work from any location. -->
    <Resource Include="Assets\Fluent3D\*.png" />
    <Resource Include="Assets\PNG\*.png" />
  </ItemGroup>

  <!-- Build and package the current provider binaries with the same adjacent CLI
       closure used by One and Fleet. The previous copy target reused checked-in
       DLLs, so Community could run a different provider revision from the CLI. -->
  <Import Project="..\Igloo.Cli\Igloo.Cli\PackagedCli.targets" />
  <ItemGroup>
    <None Remove="Views\iGloo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Svg.Skia" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Igloo.Community.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Igloo.Command.Contracts\Igloo.Command.Contracts.csproj" />
    <ProjectReference Include="..\Igloo.Cli.Client\Igloo.Cli.Client.csproj" />
    <ProjectReference Include="..\Igloo.Core.Host\Igloo.Core.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Views\iGloo.png" />
  </ItemGroup>

</Project>
